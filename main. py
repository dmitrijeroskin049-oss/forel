def page_url(p): return THREAD if p == 1 else f"{THREAD}/page-{p}"

def fetch(url):
    try:
        r = requests.get(url, impersonate="chrome120", timeout=20)
        return r.text if r.status_code == 200 else None
    except: return None

def parse_posts(html, page):
    soup = BeautifulSoup(html, "lxml")
    posts = []
    for m in soup.select("article.message"):
        raw_id = m.get("id", "")
        p_id = re.search(r"(\d+)", raw_id).group(1) if re.search(r"(\d+)", raw_id) else f"p{page}_{len(posts)}"
        t_el, body = m.select_one("time"), m.select_one(".bbWrapper")
        if not body: continue
        for q in body.select("blockquote"): q.decompose()
        posts.append({"post_id": p_id, "page": page, "author": m.get("data-author", ""), "post_dt": t_el.get("datetime") if t_el else "", "text": body.get_text("\n", strip=True)})
    return posts

def moon_phase(day_str):
    try:
        d = date.fromisoformat(day_str)
        age = ((d - date(2000, 1, 6)).days) % 29.530588853
        return MOON_ORDER[int(age / 3.69) % 8]
    except: return MOON_ORDER[0]

def load_weather():
    weather = {}
    try:
        r = requests.get("https://archive-api.open-meteo.com/v1/archive", params={"latitude":55.82,"longitude":37.33,"start_date":START_DATE,"end_date":str(date.today()-timedelta(days=1)),"daily":"temperature_2m_max,temperature_2m_min,pressure_msl_mean,windspeed_10m_max","timezone":"Europe/Moscow"}, timeout=30).json().get("daily", {})
        times = r.get("time", [])
        for i, d in enumerate(times):
            weather[d] = {"t_day": r.get("temperature_2m_max")[i], "t_night": r.get("temperature_2m_min")[i], "pressure": round(r.get("pressure_msl_mean")[i]*0.75006,1) if r.get("pressure_msl_mean")[i] else None, "wind": round(r.get("windspeed_10m_max")[i]/3.6,1) if r.get("windspeed_10m_max")[i] else None}
    except: pass
    return weather

def main():
    os.makedirs(PAGES_DIR, exist_ok=True)
    db = sqlite3.connect(DB_FILE)
    db.execute("CREATE TABLE IF NOT EXISTS posts (post_id TEXT PRIMARY KEY, page INT, author TEXT, post_dt TEXT, text TEXT)")
    
    html = fetch(page_url(1))
    if not html: return
    soup = BeautifulSoup(html, "lxml")
    nav = soup.select(".pageNav a")
    nums = [int(a.get_text(strip=True)) for a in nav if a.get_text(strip=True).isdigit()]
    last_page = max(nums) if nums else 10000
    
    pages = list(range(max(1, last_page - 10), last_page + 1))
    for p in pages:
        h = fetch(page_url(p))
        if h:
            for post in parse_posts(h, p):
                db.execute("INSERT OR REPLACE INTO posts VALUES (?,?,?,?,?)", (post["post_id"], post["page"], post["author"], post["post_dt"], post["text"]))
            db.commit()

    weather = load_weather()
    reports, days = [], defaultdict(list)
    
    for p_id, page, author, post_dt, text in db.execute("SELECT post_id, page, author, post_dt, text FROM posts"):
        p_day = (post_dt or "")[:10]
        p_url = f"{THREAD}/page-{page}#post-{p_id}"
        if p_day and FOREL_RX.search(text or ""): days[p_day].append(p_url)
        if p_day >= REPORT_START and author not in ADMIN_AUTHORS:
            loc = LOCATION_RX.search(text or "")
            lure = LURE_RX.search(text or "")
            if loc or lure:
                reports.append({"day": p_day, "author": author, "location": loc.group(0) if loc else None, "lure": lure.group(0) if lure else None, "success": bool(SUCCESS_RX.search(text or "")), "url": p_url, "quote": (text or "")[:100]})

    table = []
    for d in sorted(days, reverse=True)[:30]:
        w = weather.get(d, {})
        table.append({"day": d, "posts": len(days[d]), "t_day": w.get("t_day"), "t_night": w.get("t_night"), "wind": f"{w.get('wind')} м/с" if w.get('wind') else "—", "pressure": w.get("pressure"), "moon": moon_phase(d)})

    payload = json.dumps({"stats": {"total_posts": sum(len(v) for v in days.values())}, "table": table, "balance": {"remaining": 500, "series": {"dates": list(days.keys())[:10], "stocked": [100]*10, "caught": [50]*10, "remaining": [500]*10}}, "reports": reports[:30]}, ensure_ascii=False).replace("</", "<\\/")
    
    with open("index.html", "w", encoding="utf-8") as f:
        f.write(TEMPLATE.replace("__DATA__", payload))
    print("Готово!")

if __name__ == "__main__": main()
