[{"post_id": "21903716", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T07:55:20+0300", "text": ""}, {"post_id": "21903721", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T07:58:15+0300", "text": ""}, {"post_id": "21903876", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T09:07:55+0300", "text": "Запуск Форели 150кг\nЖдём в гости\n​"}, {"post_id": "21903935", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T09:38:06+0300", "text": ""}, {"post_id": "21903938", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T09:40:08+0300", "text": ""}, {"post_id": "21903944", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T09:42:27+0300", "text": ""}, {"post_id": "21903949", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T09:45:18+0300", "text": ""}, {"post_id": "21904022", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T10:20:06+0300", "text": ""}, {"post_id": "21904030", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T10:23:01+0300", "text": ""}, {"post_id": "21904259", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T11:57:26+0300", "text": ""}, {"post_id": "21904266", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T11:59:11+0300", "text": ""}, {"post_id": "21904343", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T12:33:30+0300", "text": ""}, {"post_id": "21904356", "page": 9634, "author": "Вован борода", "post_dt": "2025-10-15T12:39:38+0300", "text": "Здравствуйте, Скажите пожалуйста когда откроете спорт зону. А то уже бока болят от дивана и по ночам она сниться. А руки чешутся конопатую по спорт зоне погонять А то скоро ударят морозы и кольца будут обмерзать."}, {"post_id": "21904374", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T12:46:27+0300", "text": ""}, {"post_id": "21904392", "page": 9634, "author": "Митяй-Митинооо", "post_dt": "2025-10-15T12:50:43+0300", "text": ""}]