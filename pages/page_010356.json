[{"post_id": "22790254", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": "Запуск Карпа 601 кг.Навеска 1.2-1.7 кг.\n​"}, {"post_id": "22790428", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790481", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790541", "page": 10356, "author": "юрий аэропорт", "post_date": "2026-07-31", "text": "Привет Александр!. Двойной бисквит, жареная семечка кукуруза есть в наличии?"}, {"post_id": "22790588", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": "Привет ,семечка есть,бисквит последние 2 пачки."}, {"post_id": "22790591", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790735", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790747", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790825", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22790864", "page": 10356, "author": "юрий аэропорт", "post_date": "2026-07-31", "text": "Если получится, забронируй хотя бы одну. Я примерно к 16 подъеду"}, {"post_id": "22790903", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": "Всем Доброго времени суток\nАнонс по зарыблениям на ближайшие дни\nЗа два дня среда,пятница запустили Карпа в количестве 1 тонна 205 кг\nТак же в эти выходные запустим Осетра в количестве 300кг\nСегодня в пятницу после обеда состоится запуск Осетра 100кг\n,навеска 2-3кг\nВ субботу утром ещё 100кг Осетра запустим\n,навеска 2-3кг\n,а так же вечером 100кг Осетра\nГотовьте снасти\nЖдём в гости\n​"}, {"post_id": "22790960", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": ""}, {"post_id": "22791014", "page": 10356, "author": "Алексей Ищук", "post_date": "2026-07-31", "text": "Привет, много рыбаков на водоеме?"}, {"post_id": "22791089", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": "Запуск Осетра 103 кг.\n​"}, {"post_id": "22791457", "page": 10356, "author": "Александр SALMO", "post_date": "2026-07-31", "text": "Добрый день не много."}]