[{"post_id": "21591431", "page": 9407, "author": "Silvius", "post_dt": "2025-06-27T23:48:31+0300", "text": "https://big-carp.ru/map/"}, {"post_id": "21591433", "page": 9407, "author": "Silvius", "post_dt": "2025-06-27T23:49:51+0300", "text": "https://big-carp.ru/map/"}, {"post_id": "21591591", "page": 9407, "author": "Александр SALMO", "post_dt": "2025-06-28T06:50:05+0300", "text": ""}, {"post_id": "21591597", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T06:56:20+0300", "text": "Ночные уловы\n​"}, {"post_id": "21591640", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T07:27:37+0300", "text": ""}, {"post_id": "21591713", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T08:09:08+0300", "text": "Запуск Осетра 101кг,навеска микс до 7кг\nВечером ещё 100кг запустим\nЖдём в гости\n​"}, {"post_id": "21591753", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T08:35:37+0300", "text": ""}, {"post_id": "21591815", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T09:00:09+0300", "text": ""}, {"post_id": "21591897", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T09:33:42+0300", "text": ""}, {"post_id": "21591939", "page": 9407, "author": "Виталик капитан", "post_dt": "2025-06-28T09:43:49+0300", "text": "Женя красавчик."}, {"post_id": "21591974", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T09:58:46+0300", "text": ""}, {"post_id": "21591992", "page": 9407, "author": "Филини", "post_dt": "2025-06-28T10:05:32+0300", "text": "Добрый день.\nПодскажите, бомбардой можно ловить?\nИ есть ли в ней сейчас смысл (ловится что-то на неё)?"}, {"post_id": "21592111", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T10:50:54+0300", "text": "Добрый день,можно пробовать Карпа или Амура"}, {"post_id": "21592170", "page": 9407, "author": "Дмитрий96)", "post_dt": "2025-06-28T11:11:35+0300", "text": "Всем ДВС, кто карпа ловил в последним дни, на какую прикормку реагирует, на фруктовые начал отзываться?"}, {"post_id": "21592227", "page": 9407, "author": "Митяй-Митинооо", "post_dt": "2025-06-28T11:32:22+0300", "text": ""}]