[{"post_id": "22658719", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": "Ночные уловы.\n​"}, {"post_id": "22658803", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": "Улов Андрея за сутки 48 кг Осетра.\n​"}, {"post_id": "22658885", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": ""}, {"post_id": "22658934", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": ""}, {"post_id": "22658937", "page": 10276, "author": "юрий аэропорт", "post_date": "2026-06-12", "text": "Привет Александр. Как с народом сегодня?"}, {"post_id": "22658987", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": "Привет Юрий,народа не много места свободные есть."}, {"post_id": "22659028", "page": 10276, "author": "юрий аэропорт", "post_date": "2026-06-12", "text": "Спасибо. После обеда собираюсь на сутки."}, {"post_id": "22659109", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": "Ждем"}, {"post_id": "22659112", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": ""}, {"post_id": "22659120", "page": 10276, "author": "юрий аэропорт", "post_date": "2026-06-12", "text": "Куда мы денемся!. Сам жду."}, {"post_id": "22659123", "page": 10276, "author": "юрий аэропорт", "post_date": "2026-06-12", "text": "Смотрю, не успеваете осетра завозить. Какие-то монстры рыбаки. Всех переловили."}, {"post_id": "22659152", "page": 10276, "author": "Девочка Демон", "post_date": "2026-06-12", "text": ""}, {"post_id": "22659289", "page": 10276, "author": "Александр SALMO", "post_date": "2026-06-12", "text": ""}, {"post_id": "22659438", "page": 10276, "author": "Алексей Ищук", "post_date": "2026-06-12", "text": "Здравствуйте, много народу на водоеме?"}, {"post_id": "22659507", "page": 10276, "author": "tar.andr", "post_date": "2026-06-12", "text": "С каких это пор флюр стал крепче монки на разрыв?"}]