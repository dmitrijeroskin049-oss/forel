[{"post_id": "20449276", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T10:18:08+0300", "text": ""}, {"post_id": "20449299", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T10:25:36+0300", "text": "Сегодня вечером состоится очередной запуск Осетра\nЖдём Всех в гости\n​"}, {"post_id": "20449335", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T10:38:30+0300", "text": ""}, {"post_id": "20449448", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T11:16:32+0300", "text": ""}, {"post_id": "20449593", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T12:09:21+0300", "text": "Цена путёвки на Основной водоём....\nС 06.00-19.00 - 3100р\nС 06.00-12.00 - 2000р -\n(скидка не распространяется)\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р (скидка не распространяется)\nРазрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20449659", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T12:33:06+0300", "text": ""}, {"post_id": "20449698", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T12:48:12+0300", "text": ""}, {"post_id": "20449760", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T13:14:08+0300", "text": ""}, {"post_id": "20449829", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T13:40:06+0300", "text": ""}, {"post_id": "20449842", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T13:43:56+0300", "text": ""}, {"post_id": "20449861", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T13:52:30+0300", "text": ""}, {"post_id": "20450067", "page": 8619, "author": "юрий аэропорт", "post_dt": "2024-08-16T14:58:55+0300", "text": "А ты не завидуй"}, {"post_id": "20450219", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T15:38:49+0300", "text": "Прикормка,наживка"}, {"post_id": "20450263", "page": 8619, "author": "Андрей Милославский", "post_dt": "2024-08-16T15:46:51+0300", "text": "Как можно))))"}, {"post_id": "20450326", "page": 8619, "author": "Митяй-Митинооо", "post_dt": "2024-08-16T16:03:55+0300", "text": "Запуск Осетра 102кг\n,навеска 2-4кг\nЖдём Всех в гости\n​"}]