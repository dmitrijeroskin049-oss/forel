[{"post_id": "22806595", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22806614", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22806679", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": "Запуск Карпа 400кг\nЖдём в гости\n​"}, {"post_id": "22806775", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": "Всем Доброго времени суток\nВыходные обещают тёплую и комфортную погоду\nВ ближайшие 2 дня будет ещё запущено 300кг\nОсетра и 800кг Карпа\nСегодня в пятницу 07.08 утром запустили Карпа из садков в количестве 400кг\nТак же вечером запустим Осетра в количестве 100кг + Бонус 1 меченного Осетра.Поймавший получает\n5000р\nВ субботу 08.07 утром запустим ещё 400кг проверенного Карпа из садков и 100кг Осетрины,навеска 2-3кг\nВечером в субботу запустим ещё 100кг Осетра + Бонус 1 меченного Осетра.Поймавший получает\n5000р\nПо итогу за эту неделю будет выпущено\n1400кг\nКарпа и\n400кг\nОсетра\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "22806854", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807057", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807116", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807223", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807247", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807455", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807701", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807782", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807897", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22807947", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}, {"post_id": "22808003", "page": 10373, "author": "Митяй-Митинооо", "post_date": "2026-08-07", "text": ""}]