[{"post_id": "21281965", "page": 9201, "author": "Алексей110", "post_dt": "2025-03-25T10:34:24+0300", "text": "Всем привет! Завтра основной откроете?\nИ можно фото основного"}, {"post_id": "21282439", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T12:35:27+0300", "text": "Навеска Форели 1-2кг,средний вес 1.4-1.5кг\n​"}, {"post_id": "21282586", "page": 9201, "author": "kapich74", "post_dt": "2025-03-25T13:12:24+0300", "text": "Поддержу вопрос ‍"}, {"post_id": "21282753", "page": 9201, "author": "Александр SALMO", "post_dt": "2025-03-25T13:58:24+0300", "text": ""}, {"post_id": "21282760", "page": 9201, "author": "Александр SALMO", "post_dt": "2025-03-25T14:00:59+0300", "text": "Завтра на Основном водоеме «Народный день» БЕЗ ЗАПУСКА.\nЦена путевок:\nУтро с 7:00 до 18:45 -2500₽\nОбед с 12:00 до 18:45-1500₽\nНочь с 18:00 до 6:00-2500₽\nСутки с момента прибытия 24 часа 3500₽(можно заезжать сегодня после 15:00)\nСкидка в этот день не действует.\n89852620637 Администрация\n​"}, {"post_id": "21282818", "page": 9201, "author": "юрий аэропорт", "post_dt": "2025-03-25T14:17:28+0300", "text": "Супер!."}, {"post_id": "21282821", "page": 9201, "author": "юрий аэропорт", "post_dt": "2025-03-25T14:18:38+0300", "text": "А запуск на основном когда планируете?"}, {"post_id": "21282829", "page": 9201, "author": "jasama", "post_dt": "2025-03-25T14:20:39+0300", "text": "Добрый день. Сколько удочек на человека?"}, {"post_id": "21282885", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T14:36:53+0300", "text": "Заранее сообщим"}, {"post_id": "21282890", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T14:38:05+0300", "text": "Добрый день,2 снасти"}, {"post_id": "21283230", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T16:22:05+0300", "text": ""}, {"post_id": "21283447", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T17:23:10+0300", "text": ""}, {"post_id": "21283502", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T17:37:55+0300", "text": "На водоёме есть форелевая паста и резина"}, {"post_id": "21283528", "page": 9201, "author": "Митяй-Митинооо", "post_dt": "2025-03-25T17:43:13+0300", "text": "Основной водоём\nОткрытой воды все больше и больше"}, {"post_id": "21283554", "page": 9201, "author": "Александр SALMO", "post_dt": "2025-03-25T17:50:26+0300", "text": ""}]