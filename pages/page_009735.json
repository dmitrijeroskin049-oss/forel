[{"post_id": "22012457", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012471", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012474", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012504", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": "Завтра четверг 20.11 спорт зона и Основной водоем работают в штатном режиме.Навеска Спорт зона 1.5кг-3кг.\nОсновной водоем навеска микс до 3 кг.\nЖдем в гости.\n​"}, {"post_id": "22012527", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012567", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012671", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012676", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22012697", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": "Обед для наших рыбаков\n​"}, {"post_id": "22012762", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22013047", "page": 9735, "author": "Девочка Демон", "post_date": "2025-11-19", "text": ""}, {"post_id": "22013277", "page": 9735, "author": "дмитриё", "post_date": "2025-11-19", "text": "Немного фото мероприятия"}, {"post_id": "22013323", "page": 9735, "author": "дмитриё", "post_date": "2025-11-19", "text": "Ещё немного."}, {"post_id": "22013374", "page": 9735, "author": "Сергей Угодин", "post_date": "2025-11-19", "text": "Андрей,канал Плати лови, тут как тут))))"}, {"post_id": "22013378", "page": 9735, "author": "Сергей Угодин", "post_date": "2025-11-19", "text": "Так к вам \"ФОРЕЛЬНУТЫЕ \" приезжали. Круто."}]