[{"post_id": "22468101", "page": 10157, "author": "sergei 1986", "post_date": "2026-04-11", "text": "Как оснащён ваш чабик по заводскому так и ловите.  Лучше поставить одинарные, меньше сходов будет."}, {"post_id": "22468206", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": "Штатные Форелевые воблеры с тройниками разрешены.Не чего менять не нужно."}, {"post_id": "22468314", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": "Ночные уловы."}, {"post_id": "22468336", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22468554", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": "Запуск Основной водоем 77 кг.\n​"}, {"post_id": "22468561", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": "Запуск спорт зона 151 кг.\n​"}, {"post_id": "22468753", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22468942", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22468949", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22469067", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22469079", "page": 10157, "author": "Сергей63Михалыч", "post_date": "2026-04-11", "text": "не придумывайте сами себе геморой, в  шапке есть четкие указания на что ловить нельзя, там воблеры есть? нету, вот и  ловите спокойно. С ув."}, {"post_id": "22469350", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22469387", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22469484", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": ""}, {"post_id": "22469651", "page": 10157, "author": "Александр SALMO", "post_date": "2026-04-11", "text": "Завтра будем запускать на спорт зону навеска:\nСредняя навеска 1.8 кг и миксанем ее с навеской до 2.5 кг.\nОсновной водоем навеска 1.3-1.5кг средняя навеска.\n​"}]