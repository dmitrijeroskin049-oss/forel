[{"post_id": "22805117", "page": 10371, "author": "Koctac", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805122", "page": 10371, "author": "Koctac", "post_date": "2026-08-06", "text": "А меченный, какая метка? ввиде чего?"}, {"post_id": "22805165", "page": 10371, "author": "одинокий63", "post_date": "2026-08-06", "text": "Как у горбачёва,родимое пятно..\nКто же Вам скажет?"}, {"post_id": "22805167", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": "Выколоты глаза и зашит рот\nА если серьезно…на хвосте будет метка"}, {"post_id": "22805229", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805256", "page": 10371, "author": "Koctac", "post_date": "2026-08-06", "text": "Так а как тогда понять что поймал меченного? ЧТоб приз забрать"}, {"post_id": "22805353", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805376", "page": 10371, "author": "sergei 1986", "post_date": "2026-08-06", "text": "Димон здорова. Как клёв там у вас ."}, {"post_id": "22805378", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805387", "page": 10371, "author": "sergei 1986", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805391", "page": 10371, "author": "sergei 1986", "post_date": "2026-08-06", "text": "У нас Димон тоже клюёт."}, {"post_id": "22805400", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": "Привет.У нас всегда клюёт"}, {"post_id": "22805406", "page": 10371, "author": "Рамид", "post_date": "2026-08-06", "text": "Скорее всего рот зашитый"}, {"post_id": "22805466", "page": 10371, "author": "Митяй-Митинооо", "post_date": "2026-08-06", "text": ""}, {"post_id": "22805495", "page": 10371, "author": "юрий аэропорт", "post_date": "2026-08-06", "text": "Зачем интригу убрал?"}]