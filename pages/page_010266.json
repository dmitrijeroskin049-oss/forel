[{"post_id": "22643646", "page": 10266, "author": "LOBAN", "post_date": "2026-06-06", "text": "Я ловлю, до 5 кг вытаскивал, толще 0,18 вообще не использую."}, {"post_id": "22643672", "page": 10266, "author": "gas gas", "post_date": "2026-06-06", "text": "Если что осетр и на 0.3 плетню берет))"}, {"post_id": "22643743", "page": 10266, "author": "alex_v77", "post_date": "2026-06-07", "text": "Уловистый вкус технопланктона - отсюда до озера Абрау. Оснастка +- одинаковая. Главное выбрать вкус."}, {"post_id": "22643848", "page": 10266, "author": "Саша chef", "post_date": "2026-06-07", "text": "Техноплантон со вкусом топленого молока"}, {"post_id": "22643865", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22643887", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22643920", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": "Ночные уловы.\n​"}, {"post_id": "22643927", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22644086", "page": 10266, "author": "юрий аэропорт", "post_date": "2026-06-07", "text": "Вкус техно планктона. У него много разных вкусов. Надо подбирать."}, {"post_id": "22644295", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22644432", "page": 10266, "author": "юрий аэропорт", "post_date": "2026-06-07", "text": "Согласен."}, {"post_id": "22644447", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22644541", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22644614", "page": 10266, "author": "Александр SALMO", "post_date": "2026-06-07", "text": ""}, {"post_id": "22645066", "page": 10266, "author": "Митяй-Митинооо", "post_date": "2026-06-07", "text": "Аренда снастей"}]