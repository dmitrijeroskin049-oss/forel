[{"post_id": "21955210", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T07:54:03+0300", "text": ""}, {"post_id": "21955223", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T08:02:46+0300", "text": ""}, {"post_id": "21955282", "page": 9674, "author": "юрий аэропорт", "post_dt": "2025-11-01T08:27:06+0300", "text": "Привет Дима!. Напомни пожалуйста, а дошик светонакопительный есть?. Собираюсь к Вам на сутки сегодня."}, {"post_id": "21955307", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T08:39:41+0300", "text": "Доброе утро Юрий,есть!"}, {"post_id": "21955384", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T09:11:09+0300", "text": "Запуск Форели 150кг,навеска микс до 3кг\nЖдём в гости\n​"}, {"post_id": "21955432", "page": 9674, "author": "юрий аэропорт", "post_dt": "2025-11-01T09:25:25+0300", "text": "Спасибо!"}, {"post_id": "21955494", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T09:48:19+0300", "text": "Всем Доброго времени суток\nЗавтра воскресенье 02.11 погоду обещают без дождей,но прохладную,одеваемся теплее.Так же всегда можно погреться и попить горячего чая в 1 тёплой беседке\nОриентировочный запуск 200-300кг\nи запуск может измениться только в большую сторону,навеска микс до 3кг + запустим 3 меченные Форели,поймавший получает Бесплатную дневную путёвку на следующую рыбалку\nПо традиции приготовим Ушицу из Форели\nЖдём Всех в гости\n​"}, {"post_id": "21955713", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T10:47:45+0300", "text": ""}, {"post_id": "21955727", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T10:50:32+0300", "text": ""}, {"post_id": "21955742", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T10:52:49+0300", "text": ""}, {"post_id": "21955835", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T11:17:41+0300", "text": ""}, {"post_id": "21955953", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T11:52:14+0300", "text": ""}, {"post_id": "21956117", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T12:40:48+0300", "text": ""}, {"post_id": "21956187", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T13:07:31+0300", "text": ""}, {"post_id": "21956273", "page": 9674, "author": "Митяй-Митинооо", "post_dt": "2025-11-01T13:44:51+0300", "text": ""}]