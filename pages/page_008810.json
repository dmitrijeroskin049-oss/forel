[{"post_id": "20722158", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T10:14:26+0300", "text": ""}, {"post_id": "20722278", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T10:49:58+0300", "text": ""}, {"post_id": "20722358", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T11:13:04+0300", "text": ""}, {"post_id": "20722434", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T11:31:04+0300", "text": "Уважаемые рыбаки и гости нашего водоёма\nНами принято решение завтра 05.11 сделать Народный день (без запуска).Форели в водоёме подвисло более 2 тонн.Завтра разрешено ловить на 3 снасти\nЦена путевки….\nС 07.00-18.00 - 2000р\nС 12.00-18.00 - 1000р\nС 18.00-06.00 - 2000р\nСутки 3000р\nНа сутки можно заезжать уже сегодня и до завтрашнего дня до 8 утра\nВ ночь можно приезжать сегодня и завтра\nРыбы в водоёме много\nПриезжайте,подбирайте,ловите\nЖдём Всех в гости\n​"}, {"post_id": "20722530", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:02:18+0300", "text": ""}, {"post_id": "20722555", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:11:26+0300", "text": ""}, {"post_id": "20722573", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:16:46+0300", "text": ""}, {"post_id": "20722607", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:26:35+0300", "text": ""}, {"post_id": "20722646", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:37:21+0300", "text": ""}, {"post_id": "20722668", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:46:58+0300", "text": ""}, {"post_id": "20722694", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T12:55:13+0300", "text": ""}, {"post_id": "20722767", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T13:21:34+0300", "text": ""}, {"post_id": "20722841", "page": 8810, "author": "Митяй-Митинооо", "post_dt": "2024-11-04T13:41:19+0300", "text": ""},