[{"post_id": "22482083", "page": 10164, "author": "Легкая", "post_date": "2026-04-15", "text": "Всем привет, вчера СЗ с 6 до 18.00. До запуска одна на магот верх и много прещипов. Запуск одна поклевка на магот,  после запуска в течении дня 6 рыб, на разный PAL2,5 гр. верх. Было три схода. С кем ловил пламенный привет! Красногорск спасибо за рыбалку!"}, {"post_id": "22482087", "page": 10164, "author": "данилович", "post_date": "2026-04-15", "text": ""}, {"post_id": "22482344", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": "Поимки до запуска"}, {"post_id": "22482348", "page": 10164, "author": "юрий аэропорт", "post_date": "2026-04-15", "text": "Привет Дима!. Паста сыр жёлтая есть?."}, {"post_id": "22482439", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": "Привет Юрий,есть!"}, {"post_id": "22482472", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": "Запуск Форели в Основной водоём 90кг\nЖдём в гости\n​"}, {"post_id": "22482481", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": "Запуск Форели в Спортзону 95кг\n​"}, {"post_id": "22482650", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": ""}, {"post_id": "22482722", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": ""}, {"post_id": "22482809", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": ""}, {"post_id": "22482906", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": ""}, {"post_id": "22482941", "page": 10164, "author": "юрий аэропорт", "post_date": "2026-04-15", "text": "Понял. После обеда на сутки приеду."}, {"post_id": "22483264", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": "Всегда рады видеть\nЖдём в гости"}, {"post_id": "22483459", "page": 10164, "author": "Митяй-Митинооо", "post_date": "2026-04-15", "text": ""}, {"post_id": "22483763", "page": 10164