[{"post_id": "20745581", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T06:36:11+0300", "text": "Путёвка «Сутки»\n​"}, {"post_id": "20745671", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T07:48:46+0300", "text": ""}, {"post_id": "20745719", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T08:17:49+0300", "text": ""}, {"post_id": "20745727", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T08:20:11+0300", "text": "Ночные уловы\n​"}, {"post_id": "20745931", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T09:34:30+0300", "text": "Запуск Форели 401кг\n,навеска 1.3-2кг\nЖдём в гости\n​"}, {"post_id": "20745942", "page": 8825, "author": "S19D1983", "post_dt": "2024-11-10T09:39:58+0300", "text": "А ещё нравится когда донки и бомбарда раскиданы вечером,и как итог один рыбак занимает 2-3 места, поэтому нет никакого желания ловить в таких условиях,ждём льда, всем НХНЧ"}, {"post_id": "20745945", "page": 8825, "author": "S19D1983", "post_dt": "2024-11-10T09:41:00+0300", "text": "Веером"}, {"post_id": "20745986", "page": 8825, "author": "Yuriy Ponamarev", "post_dt": "2024-11-10T09:57:05+0300", "text": "Много народу сегодня, места есть?"}, {"post_id": "20745990", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T09:58:07+0300", "text": ""}, {"post_id": "20746002", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T10:02:58+0300", "text": "Народ есть и места свободные пока тоже есть"}, {"post_id": "20746022", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T10:09:21+0300", "text": ""}, {"post_id": "20746157", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T10:45:48+0300", "text": ""}, {"post_id": "20746309", "page": 8825, "author": "Александр SALMO", "post_dt": "2024-11-10T11:27:49+0300", "text": ""}, {"post_id": "20746396", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T11:55:24+0300", "text": ""}, {"post_id": "20746501", "page": 8825, "author": "Митяй-Митинооо", "post_dt": "2024-11-10T12:19:46+0300", "text": "Всем Доброго времени суток\nЗавтра ориентированный запуск в количестве 100-200кг\n,навеска 1.3-2кг\nЖдём Всех в гости\n​"}]