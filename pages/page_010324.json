[{"post_id": "22738049", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Запуск Осетра 101кг\n,навеска 4-9кг\nЗавтра в субботу в обед ещё 100кг запустим\nЖдём в гости\n​"}, {"post_id": "22738164", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": ""}, {"post_id": "22738272", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Завтра в субботу утром запустим ещё клевучего Карпа из садков\nЖдём в гости\n​"}, {"post_id": "22738305", "page": 10324, "author": "Андрей8080", "post_date": "2026-07-10", "text": "Здравствуйте подскажите в каком количестве?"}, {"post_id": "22738359", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": ""}, {"post_id": "22738530", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Добрый вечер,ориентировочно 300-400кг"}, {"post_id": "22738644", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Фото с водоёма"}, {"post_id": "22738945", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Прикормка, наживка"}, {"post_id": "22738955", "page": 10324, "author": "Андрей8080", "post_date": "2026-07-10", "text": "Спасибо большое"}, {"post_id": "22739047", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-10", "text": "Аренда снастей"}, {"post_id": "22739391", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-11", "text": "Цена путёвки на Основной водоём !\nС 06.00-19:00 - 4000р\nС 06.00-12.00 - 2700р (без продления)\nС 12.00-19:00 - 2200р\nС 18.00-06.00 - 4000р\nСутки 5000р\nПриоритетный час 300р\nРазрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nЖенщина и ребёнок до 13 лет ловят\nБесплатно на снасти рыбака оплатившего путевку.\nБез нормы вылова\nПеллетс запрещен.\nСпиннинг запрещен.\nНаши координаты 55.840619 ,37.322979\n89852620637 Администрация\n​"}, {"post_id": "22739446", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-11", "text": ""}, {"post_id": "22739464", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-11", "text": ""}, {"post_id": "22739468", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-11", "text": ""}, {"post_id": "22739472", "page": 10324, "author": "Митяй-Митинооо", "post_date": "2026-07-11", "text": "Ночные уловы сейчас выложим"}]