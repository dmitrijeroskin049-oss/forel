[{"post_id": "22605955", "page": 10245, "author": "vitalij68", "post_date": "2026-05-25", "text": "Вы красавцы . А сколько запустите если не секрет?"}, {"post_id": "22605966", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-25", "text": "Добрый день,+- один день,скидка 50%"}, {"post_id": "22606027", "page": 10245, "author": "Сергей Угодин", "post_date": "2026-05-25", "text": "Сколько сколько можно доп. снастей?"}, {"post_id": "22606028", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-25", "text": ""}, {"post_id": "22606036", "page": 10245, "author": "Сергей Угодин", "post_date": "2026-05-25", "text": "Нашёл ответ в ленте. Спасибо"}, {"post_id": "22606059", "page": 10245, "author": "AlexLutij", "post_date": "2026-05-25", "text": "Судя по навеске штук 10   по  10кг"}, {"post_id": "22606062", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-25", "text": "Добрый вечер,100кг"}, {"post_id": "22606092", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-25", "text": "Фото с водоёма\nРыбка клюёт\nЖдём в гости\n​"}, {"post_id": "22606425", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-25", "text": "Завтра вторник 26.05 вторая половина дня состоится очередной запуск Осетра\n,навеска 2-10+кг\nГотовьте снасти\nЖдём в гости\n​"}, {"post_id": "22607105", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-26", "text": ""}, {"post_id": "22607139", "page": 10245, "author": "jasama", "post_date": "2026-05-26", "text": "Доброе утро! А во-сколько, во второй половине дня, планируется запуск?"}, {"post_id": "22607213", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-26", "text": ""}, {"post_id": "22607233", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-26", "text": "Доброе утро,часов 14.00 - 15.00"}, {"post_id": "22607291", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-26", "text": ""}, {"post_id": "22607299", "page": 10245, "author": "Митяй-Митинооо", "post_date": "2026-05-26", "text": ""}]