[{"post_id": "22814598", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22814614", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "С прыжками ))"}, {"post_id": "22814622", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22814657", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22814720", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22814817", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "Завтра вторник 11.08 после обеда состоится очередной запуск Осетра\nЖдём в гости\n​"}, {"post_id": "22814997", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "Михаил подобрал ключик"}, {"post_id": "22815013", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22815069", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22815120", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "Напоминаем….\nВ водоёме плавает ещё 1 меченный Осётр\n,поймавший рыбак получает 5000р\nЖдём в гости\n​"}, {"post_id": "22815189", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22815198", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "За выходные прилично подвисло Осетра,а он сегодня начал кушать\n​"}, {"post_id": "22815209", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": "Осетровое Сафари продолжается\n​"}, {"post_id": "22815239", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}, {"post_id": "22815261", "page": 10379, "author": "Митяй-Митинооо", "post_date": "2026-08-10", "text": ""}]