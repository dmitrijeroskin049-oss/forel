[{"post_id": "22814598", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T11:28:53+0300", "text": ""}, {"post_id": "22814614", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T11:32:05+0300", "text": "С прыжками ))"}, {"post_id": "22814622", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T11:34:53+0300", "text": ""}, {"post_id": "22814657", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T11:46:11+0300", "text": ""}, {"post_id": "22814720", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T12:00:46+0300", "text": ""}, {"post_id": "22814817", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T12:38:16+0300", "text": "Завтра вторник 11.08 после обеда состоится очередной запуск Осетра\nЖдём в гости\n​"}, {"post_id": "22814997", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T13:35:24+0300", "text": "Михаил подобрал ключик"}, {"post_id": "22815013", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T13:41:06+0300", "text": ""}, {"post_id": "22815069", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T14:00:30+0300", "text": ""}, {"post_id": "22815120", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T14:17:03+0300", "text": "Напоминаем….\nВ водоёме плавает ещё 1 меченный Осётр\n,поймавший рыбак получает 5000р\nЖдём в гости\n​"}, {"post_id": "22815189", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T14:42:34+0300", "text": ""}, {"post_id": "22815198", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T14:45:51+0300", "text": "За выходные прилично подвисло Осетра,а он сегодня начал кушать\n​"}, {"post_id": "22815209", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T14:50:57+0300", "text": "Осетровое Сафари продолжается\n​"}, {"post_id": "22815239", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T15:03:10+0300", "text": ""}, {"post_id": "22815261", "page": 10379, "author": "Митяй-Митинооо", "post_dt": "2026-08-10T15:13:30+0300", "text": ""}]