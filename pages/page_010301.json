[{"post_id": "22700520", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": "Запуск Осетрового микса 102кг\n,навеска 2-2.5кг\n.Общий вес за сегодня составил 205кг Осетра\n+ завтра в обед ещё 100кг Осетра запустим\nЖдём Всех в гости\n​"}, {"post_id": "22700618", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": ""}, {"post_id": "22700632", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": ""}, {"post_id": "22700648", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": ""}, {"post_id": "22700695", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": "Фото с водоёма\n​"}, {"post_id": "22700822", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": "Алексей ещё одного Осетра припарковал\n,с нового переходного моста"}, {"post_id": "22700948", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-26", "text": "Аренда снастей"}, {"post_id": "22701561", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701614", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701633", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701653", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701661", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701672", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701799", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}, {"post_id": "22701870", "page": 10301, "author": "Митяй-Митинооо", "post_date": "2026-06-27", "text": ""}]