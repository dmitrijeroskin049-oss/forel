[{"post_id": "22801895", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": ""}, {"post_id": "22801941", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": ""}, {"post_id": "22801944", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Спасибо за обещанный отчёт"}, {"post_id": "22801961", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Карпуша клюёт"}, {"post_id": "22802068", "page": 10367, "author": "triniks", "post_date": "2026-08-05", "text": "А к карповой мафии, я так понял вопросов не будет?"}, {"post_id": "22802074", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": ""}, {"post_id": "22802079", "page": 10367, "author": "AgronomD", "post_date": "2026-08-05", "text": "Вся рыбная мафия а пруду, сцука!))"}, {"post_id": "22802150", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Путёвка «Утро»\nЖдём в гости\n​"}, {"post_id": "22802165", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Улов за неполные сутки\n​"}, {"post_id": "22802166", "page": 10367, "author": "Вован борода", "post_date": "2026-08-05", "text": "Она еще не вся проснулась. Вот я бросил камень и попал точно в десятку. Группа поддержки на подходе."}, {"post_id": "22802193", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": ""}, {"post_id": "22802206", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Путёвка Утро»"}, {"post_id": "22802447", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "​"}, {"post_id": "22802461", "page": 10367, "author": "Митяй-Митинооо", "post_date": "2026-08-05", "text": "Аренда снастей"}, {"post_id": "22802470", "page": 10367, "author": "юрий аэропорт", "post_date": "2026-08-05", "text": "Если Вы закрыли этот водоём для себя, то чего лезете к нам?. Мы Все мальчики взрослые. Свои обиды оставьте 