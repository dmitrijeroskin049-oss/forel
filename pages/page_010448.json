[{"post_id": "22911610", "page": 10448, "author": "Митяй-Митинооо", "post_date": "2026-09-15", "text": ""}, {"post_id": "22911702", "page": 10448, "author": "Митяй-Митинооо", "post_date": "2026-09-15", "text": "Запуск Форели 201кг\nЖдём в гости\n​"}, {"post_id": "22911733", "page": 10448, "author": "Новосельцев", "post_date": "2026-09-15", "text": "Доброе утречко.Подскажите а когда планируете открывать спорт зону."}, {"post_id": "22911752", "page": 10448, "author": "Stromply", "post_date": "2026-09-15", "text": "в прошлом году в начале ноября ещё не было."}, {"post_id": "22911773", "page": 10448, "author": "Лёхаамур", "post_date": "2026-09-15", "text": "Говорили что в течении двух недель! К концу месяца"}, {"post_id": "22911817", "page": 10448, "author": "Митяй-Митинооо", "post_date": "2026-09-15", "text": "Рыбка сегодня поклёвывает с самого утра\n​"}, {"post_id": "22911820", "page": 10448, "author": "кирилл228", "post_date": "2026-09-15", "text": "Здравствуйте а когда будет следующий запуск форели?"}, {"post_id": "22911824", "page": 10448, "author": "Лёхаамур", "post_date": "2026-09-15", "text": "Завтра)))"}, {"post_id": "22911827", "page": 10448, "author": "Stromply", "post_date": "2026-09-15", "text": "каждый день запускают."}, {"post_id": "22911879", "page": 10448, "author": "кирилл228", "post_date": "2026-09-15", "text": "По 200 кг каждый день?"}, {"post_id": "22911887", "page": 10448, "author": "кирилл228", "post_date": "2026-09-15", "text": ""}, {"post_id": "22911889", "page": 10448, "author": "Stromply", "post_date": "2026-09-15", "text": "запуск по путевкам. в выходные вот почти по пол тонны запускали."}, {"post_id": "22911956", "page": 10448, "author": "Митяй-Митинооо", "post_date": "2026-09-15", "text": ""}, {"post_id": "22912064", "page": 10448, "author": "Митяй-Митинооо", "post_date": "2026-09-15", "text": ""}, {"post_id": "22912093", "page": 10448, "author": "кирилл228", "post_date": "2026-09-15", "text": "В субботу много народу будет?"}]