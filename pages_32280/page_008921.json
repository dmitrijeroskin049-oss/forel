[{"post_id": "20861635", "page": 8921, "author": "Александр SALMO", "post_dt": "2024-12-10T09:32:00+0300", "text": "Уважаемые рыбаки.Синоптики обещают неделю хороших морозов.Нами принято решение,сегодня вечером снимаем аэраторы и начинаем замораживать спорт зону.В такие морозы мы сможем помогать наращивать лед помпой.\nСледите за новостями и ждем Вас уже на льду.\nС Уважением Администрация.\n​"}, {"post_id": "20861644", "page": 8921, "author": "Александр SALMO", "post_dt": "2024-12-10T09:34:30+0300", "text": "Запуск спорт зона 109кг.\n​"}, {"post_id": "20861712", "page": 8921, "author": "Alex_27", "post_dt": "2024-12-10T09:57:22+0300", "text": "Ну всё, ждём твердую воду на спорте. Руки уже все исчесались, а раттлины рвутся в бой!"}, {"post_id": "20862015", "page": 8921, "author": "Александр SALMO", "post_dt": "2024-12-10T11:21:31+0300", "text": ""}, {"post_id": "20862157", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T11:56:55+0300", "text": ""}, {"post_id": "20862171", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T12:01:10+0300", "text": ""}, {"post_id": "20862273", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T12:28:19+0300", "text": ""}, {"post_id": "20862474", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T13:26:05+0300", "text": ""}, {"post_id": "20862566", "page": 8921, "author": "Митяй-Митинооо", "post_dt": "2024-12-10T13:55:06+0300", "text": "Посадили в садки на акклиматизацию,навеска\nДо встречи на льду\n​"}, {"post_id": "20862640", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T14:17:25+0300", "text": ""}, {"post_id": "20862658", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T14:21:14+0300", "text": ""}, {"post_id": "20862784", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T14:51:41+0300", "text": ""}, {"post_id": "20862840", "page": 8921, "author": "Seba", "post_dt": "2024-12-10T15:06:29+0300", "text": "Ура товарищи, ура)))"}, {"post_id": "20862950", "page": 8921, "author": "TimRom_MSK", "post_dt": "2024-12-10T15:32:36+0300", "text": ""}, {"post_id": "20862958", "page": 8921, "author": "Девочка Демон", "post_dt": "2024-12-10T15:35:40+0300", "text": ""}]