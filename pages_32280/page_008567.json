[{"post_id": "20365059", "page": 8567, "author": "Rubak11", "post_dt": "2024-07-19T21:51:32+0300", "text": "Всем привет. Был сегодня с обеда с 12 до19 ловил с переходного. Интересная рыбалка проходит, сидишь смотришь на поплавки а впереди осетр летают, очень интересно. О рыбалке. Поймал 2 осетра 2карпа и попался ещё сом европеец, его я отдал соседу. Все попалось на червя с селёдкой. Очень много проходов, может это сомикицепляются их в водоём ухе полно скопилось. Всем пока. Администрации спасибо за рыбалку. Нхнч."}, {"post_id": "20365245", "page": 8567, "author": "herocoin", "post_dt": "2024-07-19T23:14:20+0300", "text": "Уважаемая администрация, поясните пожалуйста, можно ли использовать пелетц в качестве насадки?"}, {"post_id": "20365298", "page": 8567, "author": "Кирилл19930203", "post_dt": "2024-07-19T23:42:51+0300", "text": "Можно. Пеллетсом нельзя кормить."}, {"post_id": "20365436", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T06:22:56+0300", "text": "Ночные уловы.\n​"}, {"post_id": "20365444", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T06:38:46+0300", "text": ""}, {"post_id": "20365497", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T07:14:37+0300", "text": "Запуск Линя.Общий вес 307кг,навеска 0.5-1кг.\n​"}, {"post_id": "20365540", "page": 8567, "author": "Девочка Демон", "post_dt": "2024-07-20T07:46:34+0300", "text": ""}, {"post_id": "20365563", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T07:59:24+0300", "text": "Запуск Африканского Сома 100кг.\n​"}, {"post_id": "20365573", "page": 8567, "author": "Девочка Демон", "post_dt": "2024-07-20T08:04:31+0300", "text": ""}, {"post_id": "20365581", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T08:10:23+0300", "text": ""}, {"post_id": "20365613", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T08:25:56+0300", "text": ""}, {"post_id": "20365671", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T08:51:37+0300", "text": ""}, {"post_id": "20365683", "page": 8567, "author": "Александр SALMO", "post_dt": "2024-07-20T08:57:00+0300", "text": "Сегодня вечером состоится очередное зарыбление Осетром.\n​"}, {"post_id": "20365691", "page": 8567, "author": "Девочка Демон", "post_dt": "2024-07-20T09:01:29+0300", "text": ""}, {"post_id": "20365726", "page": 8567, "author": "Девочка Демон", "post_dt": "2024-07-20T09:13:18+0300", "text": ""}]