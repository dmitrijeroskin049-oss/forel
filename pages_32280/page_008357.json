[{"post_id": "19981546", "page": 8357, "author": "Александр SALMO", "post_dt": "2024-04-08T13:00:23+0300", "text": ""}, {"post_id": "19981575", "page": 8357, "author": "Александр SALMO", "post_dt": "2024-04-08T13:06:03+0300", "text": "Друзья Основной водоем открыт полностью для ловли.День 2000₽ Сутки 3000₽\nЖдем в гости.На днях снимем сетку спорт зоны и объединим водоем.\n​"}, {"post_id": "19981584", "page": 8357, "author": "Цветков Виталик", "post_dt": "2024-04-08T13:07:07+0300", "text": "Да, теперь к стадиону не попасть"}, {"post_id": "19981636", "page": 8357, "author": "HardFisherman3", "post_dt": "2024-04-08T13:18:25+0300", "text": "Самый гуманный ценник!\nВот что значит, \"Рыбак рыбака видит из далека. \"\nРеспект!"}, {"post_id": "19981647", "page": 8357, "author": "Девочка Демон", "post_dt": "2024-04-08T13:21:36+0300", "text": ""}, {"post_id": "19981767", "page": 8357, "author": "МегаРыбак_3", "post_dt": "2024-04-08T13:52:54+0300", "text": "?"}, {"post_id": "19981830", "page": 8357, "author": "Александр SALMO", "post_dt": "2024-04-08T14:12:59+0300", "text": "Можно и в кроссовках,но не везде можно пройти."}, {"post_id": "19981861", "page": 8357, "author": "МегаРыбак_3", "post_dt": "2024-04-08T14:20:32+0300", "text": "Спасибо"}, {"post_id": "19981981", "page": 8357, "author": "Девочка Демон", "post_dt": "2024-04-08T14:54:35+0300", "text": ""}, {"post_id": "19982002", "page": 8357, "author": "Девочка Демон", "post_dt": "2024-04-08T14:59:47+0300", "text": ""}, {"post_id": "19982040", "page": 8357, "author": "Владимир Попосович", "post_dt": "2024-04-08T15:11:07+0300", "text": "Д. день, скажите жена \"входит в комлект\" -2000 р. Спасибо"}, {"post_id": "19982121", "page": 8357, "author": "Девочка Демон", "post_dt": "2024-04-08T15:28:09+0300", "text": ""}, {"post_id": "19982147", "page": 8357, "author": "Александр SALMO", "post_dt": "2024-04-08T15:33:57+0300", "text": ""}, {"post_id": "19982211", "page": 8357, "author": "Александр SALMO", "post_dt": "2024-04-08T15:48:12+0300", "text": ""}, {"post_id": "19982242", "page": 8357, "author": "Barrakyda", "post_dt": "2024-04-08T15:55:03+0300", "text": "В этом сезоне до потепления воды СЗ будет работать ? Или только основной останется?"}]