[{"post_id": "21526835", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T09:56:13+0300", "text": ""}, {"post_id": "21526842", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:01:18+0300", "text": ""}, {"post_id": "21526893", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:19:33+0300", "text": ""}, {"post_id": "21526903", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:21:55+0300", "text": ""}, {"post_id": "21526940", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:33:02+0300", "text": ""}, {"post_id": "21526958", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:38:19+0300", "text": ""}, {"post_id": "21526970", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:41:23+0300", "text": "Всем Доброго времени суток\nАнонс по зарыблениям на этой неделе\n03.06 запуск Осетра 102кг\n04.06 запуск Карпа 1300кг\n06.06 сегодня в пятницу вечером состоится запуск Осетрины 200кг\n,навеска 4-7кг\n07.06 в субботу во второй половине дня,очередной запуск Осетра 100кг\n,навеска 4-7кг\n​\nГотовьте снасти\nЖдём Всех в гости\n​"}, {"post_id": "21527027", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T10:56:43+0300", "text": ""}, {"post_id": "21527052", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T11:02:51+0300", "text": ""}, {"post_id": "21527073", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T11:11:00+0300", "text": ""}, {"post_id": "21527102", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T11:26:54+0300", "text": ""}, {"post_id": "21527109", "page": 9366, "author": "Сергей-012", "post_dt": "2025-06-06T11:28:43+0300", "text": "У вас огромное количество рекламы в видео!! На других ветках ваших конкурентов ее нет совсем... Большинство видео приходится игнорировать. Это - не правильно! Не экономьте копейки, плз.! Некоторые ролики по длительности меньше, чем продолжительность рекламы - ну бред же!"}, {"post_id": "21527130", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T11:37:04+0300", "text": ""}, {"post_id": "21527488", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T13:25:25+0300", "text": ""}, {"post_id": "21527568", "page": 9366, "author": "Митяй-Митинооо", "post_dt": "2025-06-06T13:52:00+0300", "text": ""}]