[{"post_id": "23021170", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T07:51:46+0300", "text": ""}, {"post_id": "23021200", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T08:14:32+0300", "text": ""}, {"post_id": "23021266", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T08:50:32+0300", "text": "Доброе утро уважаемые рыбаки . Какие то не хорошие люди , подкинули нам котенка , девочка , ласковая , контактная ,ищет любящего хозяина или хозяйку , себе оставить не можем , наши коты кошки не принимают …на улице погибнет.\n​"}, {"post_id": "23021278", "page": 10549, "author": "Svyt", "post_dt": "2026-10-22T08:56:42+0300", "text": "Доброе время суток! Собираюсь в первые на данный водоем! Можете подсказать по глубине и расположению, и где лучше расположиться если в ночь или на сутки? За ранее спасибо!"}, {"post_id": "23021336", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T09:19:08+0300", "text": "Запуск Форели Основной водоем 186 кг.\n​"}, {"post_id": "23021397", "page": 10549, "author": "Митяй-Митинооо", "post_dt": "2026-10-22T09:38:56+0300", "text": "Спасибо за оперативный отчёт"}, {"post_id": "23021436", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T09:55:21+0300", "text": "Поимки."}, {"post_id": "23021781", "page": 10549, "author": "Митяй-Митинооо", "post_dt": "2026-10-22T11:38:40+0300", "text": "Всем Доброго времени суток\nЗавтра в пятницу 23.10 состоится гарантированный запуск Форели 100-200кг\nи запуск может измениться только в большую сторону\nЗапуск Форели в 9.00\nЖдём в гости\n​"}, {"post_id": "23021841", "page": 10549, "author": "Митяй-Митинооо", "post_dt": "2026-10-22T11:59:47+0300", "text": ""}, {"post_id": "23021850", "page": 10549, "author": "Митяй-Митинооо", "post_dt": "2026-10-22T12:04:52+0300", "text": ""}, {"post_id": "23021950", "page": 10549, "author": "Митяй-Митинооо", "post_dt": "2026-10-22T12:38:00+0300", "text": ""}, {"post_id": "23022075", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T13:08:03+0300", "text": "Вячеслав поимка на донку."}, {"post_id": "23022287", "page": 10549, "author": "Александр SALMO", "post_dt": "2026-10-22T14:06:59+0300", "text": ""}]