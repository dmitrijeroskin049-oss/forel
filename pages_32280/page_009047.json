[{"post_id": "21010004", "page": 9047, "author": "Вячеслав83", "post_dt": "2025-01-17T14:04:00+0300", "text": "Большое спасибо."}, {"post_id": "21010122", "page": 9047, "author": "Никита19892489", "post_dt": "2025-01-17T14:33:36+0300", "text": "Ден  добрый\nКакой толщины лёд? Тоже планирую на рыбалку с ребёнком. И до какого возраста дети на снасти рыбака ?"}, {"post_id": "21010163", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T14:44:53+0300", "text": "Добрый день.До 13 лет включительно.Лед от 13 см до 20 см."}, {"post_id": "21010259", "page": 9047, "author": "ushuldy", "post_dt": "2025-01-17T15:09:37+0300", "text": "."}, {"post_id": "21010366", "page": 9047, "author": "frosya", "post_dt": "2025-01-17T15:37:35+0300", "text": "А какая сейчас навеска запускается?"}, {"post_id": "21010450", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T16:02:49+0300", "text": "От 1 кг-1.5 кг.Проскакивает 0.8-0.9.А есть и 1.7-2кг."}, {"post_id": "21010582", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T16:42:49+0300", "text": "Путевка Плотва.\n​"}, {"post_id": "21010676", "page": 9047, "author": "Silvius", "post_dt": "2025-01-17T17:05:10+0300", "text": "Привет! Воды на льду много? Если надеть бахилы, которые только до щиколотки непромокаемые, нормально будет?"}, {"post_id": "21010754", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T17:26:20+0300", "text": "Привет Алексей,вполне.На льду 2 см воды."}, {"post_id": "21010760", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T17:27:21+0300", "text": "Верховка в наличии."}, {"post_id": "21010766", "page": 9047, "author": "Александр SALMO", "post_dt": "2025-01-17T17:28:22+0300", "text": ""}, {"post_id": "21010792", "page": 9047, "author": "S19D1983", "post_dt": "2025-01-17T17:35:44+0300", "text": "Ниуя себе окуньки"}, {"post_id": "21010795", "page": 9047, "author": "Димарик05", "post_dt": "2025-01-17T17:36:11+0300", "text": "Очень авторитетные окуни,рад за Вас!!!"}, {"post_id": "21010827", "page": 9047, "author": "Дмитрий96)", "post_dt": "2025-01-17T17:43:21+0300", "text": "Дааа, полосатые вообще зачётные, даже не знал что в красном такие размеры бывают."}, {"post_id": "21010847", "page": 9047, "author": "Вольник", "post_dt": "2025-01-17T17:48:04+0300", "text": "Ах вот кто малька недоедает и поставухи  переворачивает ))  вот они холостые поклевки ) размер конечно хороший ))"}]