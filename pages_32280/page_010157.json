[{"post_id": "22468101", "page": 10157, "author": "sergei 1986", "post_dt": "2026-04-11T00:07:26+0300", "text": "Как оснащён ваш чабик по заводскому так и ловите.  Лучше поставить одинарные, меньше сходов будет."}, {"post_id": "22468206", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T04:18:27+0300", "text": "Штатные Форелевые воблеры с тройниками разрешены.Не чего менять не нужно."}, {"post_id": "22468314", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T07:19:21+0300", "text": "Ночные уловы."}, {"post_id": "22468336", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T07:36:11+0300", "text": ""}, {"post_id": "22468554", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T09:17:00+0300", "text": "Запуск Основной водоем 77 кг.\n​"}, {"post_id": "22468561", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T09:20:44+0300", "text": "Запуск спорт зона 151 кг.\n​"}, {"post_id": "22468753", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T10:22:25+0300", "text": ""}, {"post_id": "22468942", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T11:27:38+0300", "text": ""}, {"post_id": "22468949", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T11:29:30+0300", "text": ""}, {"post_id": "22469067", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T11:59:22+0300", "text": ""}, {"post_id": "22469079", "page": 10157, "author": "Сергей63Михалыч", "post_dt": "2026-04-11T12:01:35+0300", "text": "не придумывайте сами себе геморой, в  шапке есть четкие указания на что ловить нельзя, там воблеры есть? нету, вот и  ловите спокойно. С ув."}, {"post_id": "22469350", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T13:12:06+0300", "text": ""}, {"post_id": "22469387", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T13:26:20+0300", "text": ""}, {"post_id": "22469484", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T14:01:33+0300", "text": ""}, {"post_id": "22469651", "page": 10157, "author": "Александр SALMO", "post_dt": "2026-04-11T14:49:59+0300", "text": "Завтра будем запускать на спорт зону навеска:\nСредняя навеска 1.8 кг и миксанем ее с навеской до 2.5 кг.\nОсновной водоем навеска 1.3-1.5кг средняя навеска.\n​"}]