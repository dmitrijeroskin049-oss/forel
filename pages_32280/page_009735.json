[{"post_id": "22012457", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T12:55:39+0300", "text": ""}, {"post_id": "22012471", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T13:01:41+0300", "text": ""}, {"post_id": "22012474", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T13:02:46+0300", "text": ""}, {"post_id": "22012504", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T13:14:04+0300", "text": "Завтра четверг 20.11 спорт зона и Основной водоем работают в штатном режиме.Навеска Спорт зона 1.5кг-3кг.\nОсновной водоем навеска микс до 3 кг.\nЖдем в гости.\n​"}, {"post_id": "22012527", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T13:22:31+0300", "text": ""}, {"post_id": "22012567", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T13:36:01+0300", "text": ""}, {"post_id": "22012671", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T14:06:36+0300", "text": ""}, {"post_id": "22012676", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T14:07:42+0300", "text": ""}, {"post_id": "22012697", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T14:18:37+0300", "text": "Обед для наших рыбаков\n​"}, {"post_id": "22012762", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T14:44:20+0300", "text": ""}, {"post_id": "22013047", "page": 9735, "author": "Девочка Демон", "post_dt": "2025-11-19T16:16:30+0300", "text": ""}, {"post_id": "22013277", "page": 9735, "author": "дмитриё", "post_dt": "2025-11-19T17:18:16+0300", "text": "Немного фото мероприятия"}, {"post_id": "22013323", "page": 9735, "author": "дмитриё", "post_dt": "2025-11-19T17:29:58+0300", "text": "Ещё немного."}, {"post_id": "22013374", "page": 9735, "author": "Сергей Угодин", "post_dt": "2025-11-19T17:45:22+0300", "text": "Андрей,канал Плати лови, тут как тут))))"}, {"post_id": "22013378", "page": 9735, "author": "Сергей Угодин", "post_dt": "2025-11-19T17:47:06+0300", "text": "Так к вам \"ФОРЕЛЬНУТЫЕ \" приезжали. Круто."}]