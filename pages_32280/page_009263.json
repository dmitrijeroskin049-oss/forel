[{"post_id": "21379056", "page": 9263, "author": "AlexLutij", "post_dt": "2025-04-20T10:46:15+0300", "text": "Две  снасти  ?"}, {"post_id": "21379124", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T11:07:49+0300", "text": "Уважаемые рыбаки.Завтра на спорт зоне будет запуск 130-150 кг.В не зависимости от количества путевок.Сложилось так,что качественную рыбу не привезли в выходные.А брать не пойми у кого не хотим.\nЦена путевки 4500₽\nЖелающих ждем в гости.\n​"}, {"post_id": "21379159", "page": 9263, "author": "GopShmel", "post_dt": "2025-04-20T11:15:45+0300", "text": "Всем доброго дня и с праздником Светлой Пасхи! Администрация подскажите как долго будет ещё спорт зона, какие планы на участок спорт зоны на летнее время?"}, {"post_id": "21379260", "page": 9263, "author": "gas gas", "post_dt": "2025-04-20T11:50:57+0300", "text": "Здравствуйте, вторник /среда будут запуски ?"}, {"post_id": "21379288", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T11:59:45+0300", "text": ""}, {"post_id": "21379294", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T12:01:30+0300", "text": "Добрый день,по спорт зоне напишем позже.Сейчас решаем данный вопрос."}, {"post_id": "21379391", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T12:39:34+0300", "text": "https://rutube.ru/video/1a509d821fa597cffaaf6abe1a5cb42a/"}, {"post_id": "21379819", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T14:56:19+0300", "text": "На Основном 2 снасти."}, {"post_id": "21379824", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T14:58:54+0300", "text": "Оплата по терминалу не всегда проходит.Поэтому заранее снимайте наличные.Переводы не принимаем.\n​"}, {"post_id": "21379945", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T15:42:37+0300", "text": ""}, {"post_id": "21380158", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T17:03:18+0300", "text": ""}, {"post_id": "21380490", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T18:48:09+0300", "text": "Итоговые фото сейчас выложим."}, {"post_id": "21380491", "page": 9263, "author": "Девочка Демон", "post_dt": "2025-04-20T18:48:13+0300", "text": "."}, {"post_id": "21380516", "page": 9263, "author": "Александр SALMO", "post_dt": "2025-04-20T18:53:54+0300", "text": "Уловы спорт зона.Вылов 136 кг.\n​"}, {"post_id": "21380552", "page": 9263, "author": "Девочка Демон", "post_dt": "2025-04-20T19:00:54+0300", "text": "Уловы Основного водоема\n​"}]