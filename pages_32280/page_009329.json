[{"post_id": "21474396", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T08:15:15+0300", "text": "Запуск Форели в Спортзону 166кг\n​"}, {"post_id": "21474565", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T09:27:07+0300", "text": "Спортзона,поимки"}, {"post_id": "21474604", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T09:40:43+0300", "text": ""}, {"post_id": "21474617", "page": 9329, "author": "serg236", "post_dt": "2025-05-20T09:47:13+0300", "text": ""}, {"post_id": "21474716", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T10:15:04+0300", "text": "Завтра в среду 21.05 на Основном водоёме «Льготный день».\nИнвалиды,ветераны,учатники боевых действий,пенсионеры,многодетные скидка 25%.При себе иметь подтверждающий документ.\nЦена путевки :\n2600₽ День с 06:00-19:00\n1500₽ Обед с 12:00-19:00\n2600р Ночь с 18.00-06.00\n3800р Сутки\nПриоритетный час 300р\nДоп.снасть 500р\nДля рыбаков не имеющих льгот,цена путевки….\n3500₽ День с 06:00-19:00\n2000₽ Обед с 12:00-19:00\n3500₽ Ночь с 18:00-06:00\n5000₽ Сутки с момента прибытия\nС Уважением Администрация.\n​"}, {"post_id": "21474825", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T10:43:24+0300", "text": ""}, {"post_id": "21474951", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T11:15:57+0300", "text": ""}, {"post_id": "21474970", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T11:22:22+0300", "text": ""}, {"post_id": "21475011", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T11:35:09+0300", "text": ""}, {"post_id": "21475104", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T12:08:42+0300", "text": ""}, {"post_id": "21475153", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T12:20:20+0300", "text": ""}, {"post_id": "21475363", "page": 9329, "author": "andr11111", "post_dt": "2025-05-20T13:16:55+0300", "text": "Здравствуйте, по форели с запусками на спортзоне до какого числа планируете?"}, {"post_id": "21475490", "page": 9329, "author": "Chugun", "post_dt": "2025-05-20T14:01:49+0300", "text": "Спасибо Вам большое!"}, {"post_id": "21475545", "page": 9329, "author": "Митяй-Митинооо", "post_dt": "2025-05-20T14:22:14+0300", "text": "Добрый день,завтра крайний день!"}, {"post_id": "21475577", "page": 9329, "author": "andr11111", "post_dt": "2025-05-20T14:32:56+0300", "text": "Понял спасибо"}]