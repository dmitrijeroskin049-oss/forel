[{"post_id": "21483960", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T10:49:53+0300", "text": ""}, {"post_id": "21484089", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T11:35:00+0300", "text": "Добрый день,пока слабовато."}, {"post_id": "21484191", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T12:02:47+0300", "text": "Друзья сегодня вечером снимаем сетки.Спорт зона прощай до Осени.\nСегодня в ночь и на сутки,уже можно будет ловить с дамбы,берегов а так же с нового понтона в обе стороны на поплавочные удочки.\nЖдем в гости.\n​"}, {"post_id": "21484326", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T12:44:47+0300", "text": ""}, {"post_id": "21484360", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T12:59:32+0300", "text": ""}, {"post_id": "21484447", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T13:22:48+0300", "text": ""}, {"post_id": "21484520", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T13:46:35+0300", "text": ""}, {"post_id": "21484576", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T14:05:00+0300", "text": ""}, {"post_id": "21484598", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T14:18:24+0300", "text": ""}, {"post_id": "21484655", "page": 9337, "author": "Anatoli1961", "post_dt": "2025-05-23T14:38:43+0300", "text": ""}, {"post_id": "21484659", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T14:39:55+0300", "text": ""}, {"post_id": "21484841", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T15:53:11+0300", "text": ""}, {"post_id": "21484905", "page": 9337, "author": "Silvius", "post_dt": "2025-05-23T16:11:23+0300", "text": "На здоровье!"}, {"post_id": "21485016", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T16:51:31+0300", "text": "Водолазные работы полным ходом.Снятие сеток."}, {"post_id": "21485168", "page": 9337, "author": "Александр SALMO", "post_dt": "2025-05-23T17:43:48+0300", "text": ""}]