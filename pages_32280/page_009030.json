[{"post_id": "20984816", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T13:39:10+0300", "text": "Цена путёвки на Основной водоём....\nЗимний период:\nС 07.00-18:00 - 3500р День\nС 12.00-18:00 - 2000р Обед\nС 18.00-06:00 - 3000р Ночь\nСутки 5000р\nДоп снасть 500₽\nПриоритетный час 300р\nПЕЛЛЕТЦ Запрещён! В любом виде!\nБАЛАНСИР ЗАПРЕЩЕН!\nРазрешено ловить на 4 поставушки+1 актив\nЗа лишние снасти удаление с водоема!\n89852620637 Администрация.\n​"}, {"post_id": "20984925", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T14:05:36+0300", "text": "Завтра Основной водоём работает с запуском Форели 4кг на дневную путёвку и 5кг на суточную.В зоне запуска не подходим к 1ой линии,так же близко не подходить к берегам и понтону (2-3м) и желательно одевать шипы\nЖдём в гости\n​"}, {"post_id": "20984949", "page": 9030, "author": "Фестиваль", "post_dt": "2025-01-11T14:12:23+0300", "text": "Весну почуяла"}, {"post_id": "20985041", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T14:32:33+0300", "text": "Или зиму"}, {"post_id": "20985471", "page": 9030, "author": "Александр Ивановв", "post_dt": "2025-01-11T16:16:46+0300", "text": "Дмитрий, верховка есть ?"}, {"post_id": "20985514", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T16:32:04+0300", "text": "Добрый вечер Александр.Верховка есть"}, {"post_id": "20986141", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T18:36:07+0300", "text": "На водоём довезли форелевую пасту\n​"}, {"post_id": "20986317", "page": 9030, "author": "ЛучникоFF", "post_dt": "2025-01-11T19:11:59+0300", "text": "Уважаемая администрация подскажите а как с допами на основном дело обстоит? Что-то упустил этот момент. Спасибо!"}, {"post_id": "20986434", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-11T19:36:08+0300", "text": "Добрый вечер,ценник выше,всё написано"}, {"post_id": "20986658", "page": 9030, "author": "ЛучникоFF", "post_dt": "2025-01-11T20:23:00+0300", "text": "А сегодня были рыбаки?"}, {"post_id": "20988186", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-12T08:40:33+0300", "text": "Всем Доброго утра"}, {"post_id": "20988194", "page": 9030, "author": "Виталик капитан", "post_dt": "2025-01-12T08:42:56+0300", "text": "И Вас, с добрым утром."}, {"post_id": "20988362", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-12T09:41:47+0300", "text": "На водоём привезли верховку\n​"}, {"post_id": "20988369", "page": 9030, "author": "Митяй-Митинооо", "post_dt": "2025-01-12T09:43:45+0300", "text": "Запуск в Основной водоём 160кг,навеска 1.2-2кг\n​"}, {"post_id": "20988393", "page": 9030, "author": "Serega5791", "post_dt": "2025-01-12T09:53:36+0300", "text": "Есть кто на рыбалке ?"}]