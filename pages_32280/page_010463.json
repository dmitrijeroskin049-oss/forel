[{"post_id": "22925294", "page": 10463, "author": "Ретrович 70", "post_dt": "2026-09-19T21:27:41+0300", "text": "Завтра с 6, с понедельника с 7"}, {"post_id": "22925395", "page": 10463, "author": "Silvius", "post_dt": "2026-09-19T22:00:47+0300", "text": "Спасибо, дружище! Очень приятно!"}, {"post_id": "22925450", "page": 10463, "author": "Макань", "post_dt": "2026-09-19T22:15:49+0300", "text": "Подскажите на пантоне только спиннинг?"}, {"post_id": "22925723", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T04:34:01+0300", "text": "Добрый день,да только спиннинг."}, {"post_id": "22925780", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T07:03:57+0300", "text": "Ночные уловы.Поймана еще одна Форель с меткой.В водоеме плавает еще 3 шт.\n​"}, {"post_id": "22925887", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T08:26:22+0300", "text": "Запуск Форели 502 кг.\n​"}, {"post_id": "22925902", "page": 10463, "author": "triniks", "post_dt": "2026-09-20T08:37:50+0300", "text": "В 2 раза больше, там яблоку негде упасть?))"}, {"post_id": "22925904", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T08:38:43+0300", "text": "Поимки на запуске."}, {"post_id": "22925992", "page": 10463, "author": "Митяй-Митинооо", "post_dt": "2026-09-20T09:20:13+0300", "text": "С завтрашнего дня понедельника 21.09 меняется режим работы водоёма .\nДневная рыбалка 07.00-18.00 !\nЗапуск Форели в 9.00\n​"}, {"post_id": "22925994", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T09:21:26+0300", "text": "Поимки часть 2."}, {"post_id": "22926122", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T10:18:30+0300", "text": ""}, {"post_id": "22926138", "page": 10463, "author": "юрий аэропорт", "post_dt": "2026-09-20T10:26:49+0300", "text": "Не то что яблоку, вишенке не просочиться."}, {"post_id": "22926144", "page": 10463, "author": "Сергей63Михалыч", "post_dt": "2026-09-20T10:29:04+0300", "text": "Всем привет, чет я  малеха не понял, вроде говорили что СЗ не работает, а на видео показали что люди там  ловят"}, {"post_id": "22926165", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T10:37:53+0300", "text": "Если малеха ветку почитать,то будет понятно,что сейчас только Основной водоем,сеток на новом понтоне нет."}, {"post_id": "22926184", "page": 10463, "author": "Сергей63Михалыч", "post_dt": "2026-09-20T10:48:14+0300", "text": "понял, спасибо, выдвигаюсь"}]