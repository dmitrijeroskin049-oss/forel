[{"post_id": "22925294", "page": 10463, "author": "Ретrович 70", "post_dt": "2026-09-19T21:27:41+0300", "text": "Завтра с 6, с понедельника с 7"}, {"post_id": "22925395", "page": 10463, "author": "Silvius", "post_dt": "2026-09-19T22:00:47+0300", "text": "Спасибо, дружище! Очень приятно!"}, {"post_id": "22925450", "page": 10463, "author": "Макань", "post_dt": "2026-09-19T22:15:49+0300", "text": "Подскажите на пантоне только спиннинг?"}, {"post_id": "22925723", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T04:34:01+0300", "text": "Добрый день,да только спиннинг."}, {"post_id": "22925780", "page": 10463, "author": "Александр SALMO", "post_dt": "2026-09-20T07:03:57+0300", "text": "Ночные уловы.Поймана еще одна Форель с меткой.В водоеме плавает еще 3 шт.\n​"}]