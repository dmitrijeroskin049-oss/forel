[{"post_id": "20482332", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T07:12:29+0300", "text": ""}, {"post_id": "20482401", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T07:36:41+0300", "text": ""}, {"post_id": "20482435", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T07:51:38+0300", "text": ""}, {"post_id": "20482463", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T08:05:31+0300", "text": ""}, {"post_id": "20482515", "page": 8642, "author": "Александр SALMO", "post_dt": "2024-08-27T08:27:27+0300", "text": ""}, {"post_id": "20482610", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T09:00:57+0300", "text": ""}, {"post_id": "20482636", "page": 8642, "author": "Александр SALMO", "post_dt": "2024-08-27T09:11:30+0300", "text": "Сегодня вечером состоится запуск Осетра.\n​"}, {"post_id": "20482898", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T10:43:19+0300", "text": ""}, {"post_id": "20483025", "page": 8642, "author": "Александр SALMO", "post_dt": "2024-08-27T11:26:03+0300", "text": ""}, {"post_id": "20483225", "page": 8642, "author": "Митяй-Митинооо", "post_dt": "2024-08-27T12:24:58+0300", "text": "Цена путёвки на Основной водоём....\nС 06.00-19.00 - 3100р\nС 06.00-12.00 - 2000р -\n(скидка не распространяется)\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р (скидка не распространяется)\nРазрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20483301", "page": 8642, "author": "Александр SALMO", "post_dt": "2024-08-27T12:49:19+0300", "text": ""}, {"post_id": "20483341", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T12:59:58+0300", "text": ""}, {"post_id": "20483523", "page": 8642, "author": "Девочка Демон", "post_dt": "2024-08-27T13:59:51+0300", "text": ""}, {"post_id": "20483892", "page": 8642, "author": "Митяй-Митинооо", "post_dt": "2024-08-27T15:40:33+0300", "text": "Завтра утром ожидаем очередную партию Карпа\n,что запускали на предыдущей неделе\n,который показал себя на Ура и сразу начал клевать после запуска\nЖдём в гости\n​"}, {"post_id": "20484064", "page": 8642, "author": "Александр SALMO", "post_dt": "2024-08-27T16:42:24+0300", "text": "Запуск Осетра 102кг.\n​"}]