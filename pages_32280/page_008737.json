[{"post_id": "20626568", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T08:19:14+0300", "text": ""}, {"post_id": "20626609", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T08:33:21+0300", "text": ""}, {"post_id": "20626628", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T08:41:08+0300", "text": ""}, {"post_id": "20626666", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T08:49:07+0300", "text": ""}, {"post_id": "20626897", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T09:55:33+0300", "text": "Запуск Форели 201кг,навеска до 3.5кг\n​"}, {"post_id": "20627008", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T10:22:57+0300", "text": ""}, {"post_id": "20627108", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T10:49:31+0300", "text": ""}, {"post_id": "20627240", "page": 8737, "author": "Ivan4eza", "post_dt": "2024-10-10T11:26:01+0300", "text": "Здравствуйте! Подскажите, ребенку исполнилось 13, полная путевка? Или еще +1?"}, {"post_id": "20627275", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T11:38:16+0300", "text": "Добрый день,13 включительно (пролезает\n)"}, {"post_id": "20627370", "page": 8737, "author": "Morty", "post_dt": "2024-10-10T12:00:32+0300", "text": "Благодарю за ответ"}, {"post_id": "20627387", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T12:06:47+0300", "text": ""}, {"post_id": "20627415", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T12:15:23+0300", "text": ""}, {"post_id": "20627473", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T12:33:43+0300", "text": ""}, {"post_id": "20627553", "page": 8737, "author": "Митяй-Митинооо", "post_dt": "2024-10-10T13:03:09+0300", "text": "Котлетина 3+\n​"}, {"post_id": "20627610", "page": 8737, "author": "Ivan4eza", "post_dt": "2024-10-10T13:20:56+0300", "text": "Спасибо, завтра будем!"}]