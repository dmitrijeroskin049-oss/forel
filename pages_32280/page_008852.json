[{"post_id": "20786303", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T10:56:48+0300", "text": ""}, {"post_id": "20786426", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T11:35:43+0300", "text": "Завтра 21.11 Народный день(без запуска)\nЦена путёвки……\nС 07.00-18.00 2000р\nС 12.00-18.00 1000р\nС 18.00-06.00 2000р\nСутки 3000р и можно приезжать сегодня после 15.00 и до завтра до 8 утра по этому тарифу\nЖелающих Ждём в гости\n​"}, {"post_id": "20786430", "page": 8852, "author": "Александр SALMO", "post_dt": "2024-11-20T11:39:02+0300", "text": "Внимание\nЗавтра будет производится работа по спуску понтона на воду.Убедительная просьба,на дамбе не занимать места.\nС Уважением Администрация.\n​"}, {"post_id": "20786461", "page": 8852, "author": "Андрейака", "post_dt": "2024-11-20T11:46:02+0300", "text": "Добрый день! А снастей сколько - 3?"}, {"post_id": "20786549", "page": 8852, "author": "Александр SALMO", "post_dt": "2024-11-20T12:11:15+0300", "text": "Добрый день,2 снасти на путевку."}, {"post_id": "20786687", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T12:54:41+0300", "text": ""}, {"post_id": "20786712", "page": 8852, "author": "vagner 82", "post_dt": "2024-11-20T13:04:45+0300", "text": "Был на сутках,со вторника на среду, вечером взял одну на пассив,жёлтый сыр и до запуска больше ни поклёвки,на запуске поймал 2 на резину \"бобриный хвост\" оранжевый и одну на железку,3 слил и минус \"pal\" семечка 2.5 гр.Всем НХНЧ!!!"}, {"post_id": "20786860", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T13:42:30+0300", "text": ""}, {"post_id": "20787140", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T15:04:46+0300", "text": ""}, {"post_id": "20787161", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T15:13:14+0300", "text": ""}, {"post_id": "20787221", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T15:29:57+0300", "text": ""}, {"post_id": "20787257", "page": 8852, "author": "Митяй-Митинооо", "post_dt": "2024-11-20T15:39:28+0300", "text": ""}, {"post_id": "20787448", "page": 8852, "author": "Александр SALMO", "post_dt": "2024-11-20T16:34:45+0300", "text": ""}, {"post_id": "20787916", "page": 8852, "author": "Легкая", "post_dt": "2024-11-20T18:27:12+0300", "text": "Отчёт о сегодняшней рыбалке! Коротко!"}, {"post_id": "20788059", "page": 8852, "author": "КЮД", "post_dt": "2024-11-20T18:58:27+0300", "text": "Гайка с гровером к Вашему БОЛТУ."}]