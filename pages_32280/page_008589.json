[{"post_id": "20395400", "page": 8589, "author": "Александр SALMO", "post_dt": "2024-07-29T18:25:56+0300", "text": ""}, {"post_id": "20395440", "page": 8589, "author": "vitekpva", "post_dt": "2024-07-29T18:40:41+0300", "text": "А льготные сутки, действуют только  со среды или можно во вторник после обеда приехать?"}, {"post_id": "20395513", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-29T19:06:12+0300", "text": "На сутки можно уже завтра приезжать после обеда со скидкой,а так же завтра в ночь и послезавтра\nС Уважением"}, {"post_id": "20395585", "page": 8589, "author": "Александр SALMO", "post_dt": "2024-07-29T19:26:34+0300", "text": "Уловы за сегодня.\n​"}, {"post_id": "20395925", "page": 8589, "author": "Александр SALMO", "post_dt": "2024-07-29T21:13:09+0300", "text": "Всем добрый день.Уважаемые рыбаки и гости нашего водоме.К большому сожалению,переводы мы больше не принимаем.Банк заблокировал счет и в том числе карты из за большого количества переводов.У нас установлен терминал для оплаты картой,но к сожалению интернет работает очень плохо,в связи с глушилками,высоковольтными проводами или еще ,что то.Оплата не всегда проходит.Во избежании не приятных инцидентов с оплатой ,просим оплачивать НАЛИЧНЫМИ!\nС Уважением Администрация.\n​"}, {"post_id": "20396442", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T04:24:59+0300", "text": ""}, {"post_id": "20396489", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T06:16:10+0300", "text": "Ночные уловы\n​"}, {"post_id": "20396583", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T07:22:41+0300", "text": "Осётр с дальний дистанции"}, {"post_id": "20396651", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T07:55:55+0300", "text": ""}, {"post_id": "20396720", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T08:18:47+0300", "text": ""}, {"post_id": "20396847", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T09:11:19+0300", "text": ""}, {"post_id": "20396910", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T09:34:40+0300", "text": "Аренда снастей"}, {"post_id": "20397005", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T10:02:35+0300", "text": ""}, {"post_id": "20397128", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T10:43:17+0300", "text": ""}, {"post_id": "20397235", "page": 8589, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T11:25:19+0300", "text": ""}]