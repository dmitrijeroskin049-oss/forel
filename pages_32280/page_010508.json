[{"post_id": "22980129", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T09:22:26+0300", "text": "Запуск Форели 251кг\nЖдём в гости\n​"}, {"post_id": "22980330", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T10:26:21+0300", "text": ""}, {"post_id": "22980333", "page": 10508, "author": "elfedja", "post_dt": "2026-10-08T10:28:11+0300", "text": "Много народу по противоположному берегу?"}, {"post_id": "22980374", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T10:43:31+0300", "text": "Места свободные есть!"}, {"post_id": "22980404", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T10:51:14+0300", "text": ""}, {"post_id": "22980453", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T11:02:28+0300", "text": ""}, {"post_id": "22980491", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T11:15:17+0300", "text": ""}, {"post_id": "22980525", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T11:28:39+0300", "text": ""}, {"post_id": "22980618", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T11:59:59+0300", "text": "Всем Доброго времени суток\nЗавтра в пятницу 09.10 состоится гарантированный запуск Форели 100-200кг и запуск может измениться только в большую сторону\nЗапуск Форели в 9.00\nГотовьте снасти покрепче\nЖдём в гости\n​"}, {"post_id": "22980685", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T12:18:57+0300", "text": ""}, {"post_id": "22980790", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T12:49:19+0300", "text": ""}, {"post_id": "22980917", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T13:38:19+0300", "text": ""}, {"post_id": "22981022", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T14:14:07+0300", "text": "Уважаемые рыбаки и гости нашего водоёма\nВ субботу 10.10 на водоёме будет проходить корпоратив завода КМЗ.Участок водоема будет закрыт ,Дамба и новый пантон будет Закрыт для рыбалки .(условно новая спорт зона)\nP.S.Для наших рыбаков не причастны к корпоративу,разрешено ловить со стороны Администрации и сторона стадиона\n​"}, {"post_id": "22981044", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T14:24:51+0300", "text": ""}, {"post_id": "22981104", "page": 10508, "author": "Митяй-Митинооо", "post_dt": "2026-10-08T14:51:47+0300", "text": ""}]