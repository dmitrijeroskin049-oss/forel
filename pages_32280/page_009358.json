[{"post_id": "21514179", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T09:33:14+0300", "text": ""}, {"post_id": "21514399", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T10:54:03+0300", "text": ""}, {"post_id": "21514419", "page": 9358, "author": "Slavyan74", "post_dt": "2025-06-02T10:59:09+0300", "text": "Мужики!!! Огромное спасибо за поздравления. Всем здоровья вам и вашим близким."}, {"post_id": "21514472", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T11:16:29+0300", "text": ""}, {"post_id": "21514542", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T11:41:34+0300", "text": ""}, {"post_id": "21514581", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T11:58:26+0300", "text": ""}, {"post_id": "21514663", "page": 9358, "author": "юрий аэропорт", "post_dt": "2025-06-02T12:27:38+0300", "text": "Подскажите пожалуйста, какой размер гальки лучше использовать при ловле гсетра?"}, {"post_id": "21514706", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T12:42:12+0300", "text": "["}, {"post_id": "21514726", "page": 9358, "author": "ми9. 5", "post_dt": "2025-06-02T12:46:11+0300", "text": "Замечательный водоём рыбка клюёт хорошо спасибо"}, {"post_id": "21514751", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T12:55:59+0300", "text": ""}, {"post_id": "21514936", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T13:56:56+0300", "text": ""}, {"post_id": "21514996", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T14:17:48+0300", "text": "Червь на водоеме закончился.Привезем завтра утром.\n​"}, {"post_id": "21515096", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T14:43:35+0300", "text": "Завтра во второй половине дня состоится запуск Осетра 100 кг.Навеска 2-3 кг.\n​"}, {"post_id": "21515184", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T15:12:33+0300", "text": ""}, {"post_id": "21515236", "page": 9358, "author": "Александр SALMO", "post_dt": "2025-06-02T15:31:03+0300", "text": "Завтра во второй половине дня состоится запуск Осетра 100 кг.Навеска 2-3 кг.\n​"}]