[{"post_id": "22540477", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T08:14:44+0300", "text": ""}, {"post_id": "22540479", "page": 10198, "author": "юрий аэропорт", "post_dt": "2026-05-03T08:16:04+0300", "text": "Фидер кидаю дальше, а поплавок ближе. Ближе к берегу вода теплее. Можно конечно и пикер ближе кидать, но я за годы рыбалки понял, что весной поплавок лучше работает, пока вода не прогреется."}, {"post_id": "22540508", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T08:31:05+0300", "text": ""}, {"post_id": "22540516", "page": 10198, "author": "MEGOR", "post_dt": "2026-05-03T08:35:45+0300", "text": "Плюс не забываем про грузило, на поплавке его вес может быть меньше грамма, что важно при ловле карпа. Но тут многое зависит и от погоды, нужен штиль, а он как правило ночью"}, {"post_id": "22540524", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T08:39:39+0300", "text": ""}, {"post_id": "22540586", "page": 10198, "author": "Seba", "post_dt": "2026-05-03T09:11:16+0300", "text": "Посмотрите Нормунда Грабовскиса у него доходчиво описано, что как и почему)))"}, {"post_id": "22540627", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T09:24:36+0300", "text": "Запуск спорт зона 176 кг.\n​"}, {"post_id": "22540629", "page": 10198, "author": "юрий аэропорт", "post_dt": "2026-05-03T09:25:19+0300", "text": "Согласен полностью."}, {"post_id": "22540634", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T09:27:18+0300", "text": "Запуск Осетра Основной водоем 104 кг.Навеска до 8 кг.\n​"}, {"post_id": "22540677", "page": 10198, "author": "Марат 1971", "post_dt": "2026-05-03T09:41:17+0300", "text": "Здравствуйте.На сутки со скольки можно приезжать сегодня"}, {"post_id": "22540678", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T09:42:42+0300", "text": ""}, {"post_id": "22540753", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T10:09:58+0300", "text": ""}, {"post_id": "22540787", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T10:25:16+0300", "text": ""}, {"post_id": "22540821", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T10:35:46+0300", "text": ""}, {"post_id": "22540964", "page": 10198, "author": "Александр SALMO", "post_dt": "2026-05-03T11:26:11+0300", "text": ""}]