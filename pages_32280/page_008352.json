[{"post_id": "19975065", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T13:46:14+0300", "text": ""}, {"post_id": "19975078", "page": 8352, "author": "shved1983", "post_dt": "2024-04-06T13:49:37+0300", "text": "Спасибо за ответ"}, {"post_id": "19975131", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T14:09:20+0300", "text": ""}, {"post_id": "19975158", "page": 8352, "author": "shtirin", "post_dt": "2024-04-06T14:21:18+0300", "text": "Добрый день , а много еще льда на основном ?когда на сутки можно будет ?"}, {"post_id": "19975194", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T14:34:47+0300", "text": ""}, {"post_id": "19975276", "page": 8352, "author": "Александр SALMO", "post_dt": "2024-04-06T15:00:45+0300", "text": "Добрый день,как освободим весь водоем от льда возобновим запуски и перейдем на тариф день,ночь,сутки,с обеда."}, {"post_id": "19975302", "page": 8352, "author": "Yakubovi4", "post_dt": "2024-04-06T15:08:44+0300", "text": "Пенсия рулит , Красава Николай ."}, {"post_id": "19975404", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T15:39:39+0300", "text": ""}, {"post_id": "19975417", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T15:42:05+0300", "text": ""}, {"post_id": "19975439", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T15:49:08+0300", "text": ""}, {"post_id": "19975472", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T15:59:59+0300", "text": ""}, {"post_id": "19975517", "page": 8352, "author": "юрий аэропорт", "post_dt": "2024-04-06T16:12:43+0300", "text": "Привет Александр!. А я собрался на сутки в четверг. Получается облом?. Как я только что прочитал, суток еще нет. Это так?"}, {"post_id": "19975594", "page": 8352, "author": "Александр SALMO", "post_dt": "2024-04-06T16:45:19+0300", "text": "Юрий добрый день.Выше все изложенно.Сейчас только дневная путевка."}, {"post_id": "19975623", "page": 8352, "author": "Девочка Демон", "post_dt": "2024-04-06T16:55:12+0300", "text": ""}, {"post_id": "19975648", "page": 8352, "author": "юрий аэропорт", "post_dt": "2024-04-06T17:03:13+0300", "text": "Понял. Спасибо. А доп часы действуют?"}]