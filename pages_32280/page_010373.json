[{"post_id": "22806595", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T07:03:07+0300", "text": ""}, {"post_id": "22806614", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T07:17:57+0300", "text": ""}, {"post_id": "22806679", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T07:53:16+0300", "text": "Запуск Карпа 400кг\nЖдём в гости\n​"}, {"post_id": "22806775", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T08:33:40+0300", "text": "Всем Доброго времени суток\nВыходные обещают тёплую и комфортную погоду\nВ ближайшие 2 дня будет ещё запущено 300кг\nОсетра и 800кг Карпа\nСегодня в пятницу 07.08 утром запустили Карпа из садков в количестве 400кг\nТак же вечером запустим Осетра в количестве 100кг + Бонус 1 меченного Осетра.Поймавший получает\n5000р\nВ субботу 08.07 утром запустим ещё 400кг проверенного Карпа из садков и 100кг Осетрины,навеска 2-3кг\nВечером в субботу запустим ещё 100кг Осетра + Бонус 1 меченного Осетра.Поймавший получает\n5000р\nПо итогу за эту неделю будет выпущено\n1400кг\nКарпа и\n400кг\nОсетра\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "22806854", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T08:58:00+0300", "text": ""}, {"post_id": "22807057", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T10:12:43+0300", "text": ""}, {"post_id": "22807116", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T10:28:55+0300", "text": ""}, {"post_id": "22807223", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T11:02:02+0300", "text": ""}, {"post_id": "22807247", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T11:09:28+0300", "text": ""}, {"post_id": "22807455", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T12:10:55+0300", "text": ""}, {"post_id": "22807701", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T13:42:09+0300", "text": ""}, {"post_id": "22807782", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T14:15:57+0300", "text": ""}, {"post_id": "22807897", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T14:58:41+0300", "text": ""}, {"post_id": "22807947", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T15:12:16+0300", "text": ""}, {"post_id": "22808003", "page": 10373, "author": "Митяй-Митинооо", "post_dt": "2026-08-07T15:33:40+0300", "text": ""}]