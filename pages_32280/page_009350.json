[{"post_id": "21505505", "page": 9350, "author": "Митяй-Митинооо", "post_dt": "2025-05-30T11:34:16+0300", "text": "Всем Доброго времени суток\nАнонс по зарыблениям\nНа этой неделе сделаем удар по Осетру\n,в общей сложности запустим ещё 400кг Осетра\nСегодня в пятницу 30.05 вторая половина дня 200кг Осетра\n,навеска 2-3кг\nЗавтра в субботу 31.05 в первой половине дня 100кг Осетра\n,навеска 2-3кг\nВоскресенье 01.06 в первой половине дня 100кг Осетра\n,навеска 2-3кг\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "21505684", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T12:31:11+0300", "text": ""}, {"post_id": "21505811", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T13:11:48+0300", "text": ""}, {"post_id": "21506021", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T14:21:21+0300", "text": "Запуск Осетра 201 кг.\n​"}, {"post_id": "21506026", "page": 9350, "author": "юрий аэропорт", "post_dt": "2025-05-30T14:23:23+0300", "text": "Коллеги по цеху!. Скиньте инфу по длине поводков, кто на фидер ловил в последний дни, и по дистанциям плиз. А то завтра на сутки собираюсь. Хочется иметь хотя бы какое-то представление. Подбирать все равно придётся, но так хотя бы какое-то представление будет. Спасибо."}, {"post_id": "21506141", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:00:54+0300", "text": ""}, {"post_id": "21506162", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:09:19+0300", "text": ""}, {"post_id": "21506221", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:24:37+0300", "text": ""}, {"post_id": "21506246", "page": 9350, "author": "ми9. 5", "post_dt": "2025-05-30T15:29:58+0300", "text": "Очень доволен данным водоёмам"}, {"post_id": "21506252", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:31:17+0300", "text": ""}, {"post_id": "21506286", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:42:24+0300", "text": ""}, {"post_id": "21506328", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T15:53:54+0300", "text": ""}, {"post_id": "21506378", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T16:08:06+0300", "text": ""}, {"post_id": "21506427", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T16:26:41+0300", "text": ""}, {"post_id": "21506479", "page": 9350, "author": "Александр SALMO", "post_dt": "2025-05-30T16:45:49+0300", "text": ""}]