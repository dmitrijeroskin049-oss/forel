[{"post_id": "19835734", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T09:09:01+0300", "text": "Запуск в Основной водоем 240кг\n​"}, {"post_id": "19835890", "page": 8264, "author": "Александр SALMO", "post_dt": "2024-03-02T09:57:54+0300", "text": ""}, {"post_id": "19835904", "page": 8264, "author": "dadits79", "post_dt": "2024-03-02T10:00:04+0300", "text": "Всем привет! Спорт зона, уже вчера!\nДо запуска ноль.\nНа запуске на дискотеку 4поклевки 3 в зачёте. Причем первая втитерела так, что я на секундочку задумался. Не жереха ли запускают в водоём)\nДалее в полях одну на икру. Спасибо добрым людям за помощь с бограми)\nЧерез мин 30 ещё один сход на икру. На этом всё у меня. Поклевок не видел. Итог 4шт 6кил! Всем добра и бабла. НХНЧ!"}, {"post_id": "19835949", "page": 8264, "author": "Александр SALMO", "post_dt": "2024-03-02T10:10:33+0300", "text": ""}, {"post_id": "19835984", "page": 8264, "author": "Bossanatolich", "post_dt": "2024-03-02T10:21:55+0300", "text": "Молодец. Хороший контент."}, {"post_id": "19836035", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T10:37:55+0300", "text": "Запуск в Спортзону 570кг\n​"}, {"post_id": "19836141", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T11:10:41+0300", "text": ""}, {"post_id": "19836260", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T11:47:14+0300", "text": ""}, {"post_id": "19836298", "page": 8264, "author": "ilama", "post_dt": "2024-03-02T11:59:38+0300", "text": "Спасибо"}, {"post_id": "19836379", "page": 8264, "author": "vaskinalex", "post_dt": "2024-03-02T12:29:18+0300", "text": "Леночка, тебе БОЛЬШОЕ СПАСИБО!  Всегда жду твоих репортажей с водоема! Так держать!!!"}, {"post_id": "19836431", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T12:42:48+0300", "text": "Горячий обед по расписанию\n​"}, {"post_id": "19836476", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T12:56:55+0300", "text": ""}, {"post_id": "19836540", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T13:15:28+0300", "text": ""}, {"post_id": "19836571", "page": 8264, "author": "Пайлот", "post_dt": "2024-03-02T13:27:16+0300", "text": "Молодец!!!"}, {"post_id": "19836614", "page": 8264, "author": "Митяй-Митинооо", "post_dt": "2024-03-02T13:41:20+0300", "text": ""}]