[{"post_id": "21850107", "page": 9592, "author": "Scoby", "post_dt": "2025-09-27T14:47:20+0300", "text": "День добрый, а СЗ я так понимаю еще не отсекали сеткой?"}, {"post_id": "21850112", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T14:48:54+0300", "text": "Рыбалка,рыбалкой…..а Обед по расписанию\n​"}, {"post_id": "21850147", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T15:05:16+0300", "text": ""}, {"post_id": "21850253", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T15:45:43+0300", "text": "Жёлтый сыр"}, {"post_id": "21850262", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T15:50:56+0300", "text": "Завтра в воскресенье 28.09 ориентировочный запуск Форели 200-300кг\nи запуск может измениться только в большую сторону\n,навеска микс до 3кг\nЗапуск Форели в 9.00\nЖдём Всех в гости\n​"}, {"post_id": "21850309", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T16:04:26+0300", "text": ""}, {"post_id": "21850338", "page": 9592, "author": "Большой45", "post_dt": "2025-09-27T16:14:15+0300", "text": "Добрый день подскажите пожалуйста , у вас есть домики которые отапливаются ?"}, {"post_id": "21850408", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T16:40:14+0300", "text": "Добрый день,нет"}, {"post_id": "21850469", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T17:07:32+0300", "text": ""}, {"post_id": "21850478", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T17:11:54+0300", "text": ""}, {"post_id": "21850503", "page": 9592, "author": "fishmenalex", "post_dt": "2025-09-27T17:20:14+0300", "text": "Добрый день!\nКак клёв сегодня?"}, {"post_id": "21850511", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T17:24:55+0300", "text": ""}, {"post_id": "21850583", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T17:47:18+0300", "text": "Добрый вечер,цифры покажут"}, {"post_id": "21850633", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T18:02:38+0300", "text": "Большой выбор резины Cool Place (цена 300-500р)"}, {"post_id": "21850663", "page": 9592, "author": "Митяй-Митинооо", "post_dt": "2025-09-27T18:13:16+0300", "text": "Итоговые фото сейчас выложим"}]