[{"post_id": "22067018", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T09:30:03+0300", "text": "Запуск спорт зона 256 кг.\n​"}, {"post_id": "22067024", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T09:31:37+0300", "text": "Запуск Основной водоем 76 кг.\n​"}, {"post_id": "22067170", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T10:22:48+0300", "text": "Раздача Форели после запуска.\n​"}, {"post_id": "22067221", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T10:40:26+0300", "text": ""}, {"post_id": "22067350", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T11:26:52+0300", "text": "Завтра на Основном водоёме в понедельник 08.12 Народный день (без запуска).\nЦена путёвки….\nс 07.00-18.00 - 2500р\nс 12.00-18.00 - 1500р\nЗаезд на Сутки по Народному дню можно сегодня (воскресенье)после 15.00 - 3500р\nНочь с 18.00-06.00 с воскресенье на понедельник 3000р\nНочь с понедельника на вторник 2000р.\nДоп.снасть 500р(не более 1 шт)\nЖелающих ждём в гости\n​"}, {"post_id": "22067459", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T12:11:18+0300", "text": ""}, {"post_id": "22067478", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T12:17:47+0300", "text": ""}, {"post_id": "22067577", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T12:53:08+0300", "text": ""}, {"post_id": "22067712", "page": 9777, "author": "юрий аэропорт", "post_dt": "2025-12-07T13:35:42+0300", "text": "Как обычно. Не балут нас коллеги по цеху, не балуют. А ведь любой отчет, даже про нулевую рыбалку, это то же важно."}, {"post_id": "22067796", "page": 9777, "author": "triniks", "post_dt": "2025-12-07T14:05:35+0300", "text": "Я написал же)) ну тяжело было, весь день крутил кидал, домой приехал и заснул, так бывает"}, {"post_id": "22067816", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T14:12:26+0300", "text": ""}, {"post_id": "22068057", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T15:42:15+0300", "text": ""}, {"post_id": "22068087", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T15:53:54+0300", "text": ""}, {"post_id": "22068162", "page": 9777, "author": "Митяй-Митинооо", "post_dt": "2025-12-07T16:25:37+0300", "text": "Большой выбор резины\nЦена 300-500р"}, {"post_id": "22068226", "page": 9777, "author": "Александр SALMO", "post_dt": "2025-12-07T16:54:02+0300", "text": ""}]