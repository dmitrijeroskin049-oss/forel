[{"post_id": "21508095", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T08:33:26+0300", "text": ""}, {"post_id": "21508102", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T08:36:42+0300", "text": ""}, {"post_id": "21508130", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T08:48:44+0300", "text": ""}, {"post_id": "21508147", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T08:56:02+0300", "text": ""}, {"post_id": "21508268", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T09:51:48+0300", "text": "Запуск Осетра 100кг."}, {"post_id": "21508317", "page": 9353, "author": "Lasarevich", "post_dt": "2025-05-31T10:18:27+0300", "text": "Добрый день. Александр, вы каким - нибудь способом ведете учет выловленного осетра. Предыдушие сутки показали, что он клюет, и клюет хорошо. Если с карпом  то с ним все ясно, его там много. А с осетром?"}, {"post_id": "21508425", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T10:58:07+0300", "text": ""}, {"post_id": "21508434", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T11:01:14+0300", "text": ""}, {"post_id": "21508448", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T11:06:37+0300", "text": ""}, {"post_id": "21508494", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T11:25:44+0300", "text": ""}, {"post_id": "21508499", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T11:27:24+0300", "text": ""}, {"post_id": "21508596", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T12:02:57+0300", "text": ""}, {"post_id": "21508625", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T12:13:14+0300", "text": "Завтра Воскресенье 01.06 в первой половине дня 100кг Осетра\n,навеска 2-3кг\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "21508646", "page": 9353, "author": "Петр60", "post_dt": "2025-05-31T12:19:13+0300", "text": "Добрый день,а со старого понтона ловить можно?"}, {"post_id": "21508651", "page": 9353, "author": "Александр SALMO", "post_dt": "2025-05-31T12:21:32+0300", "text": "Добрый день,можно."}]