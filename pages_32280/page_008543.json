[{"post_id": "20325666", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T08:47:45+0300", "text": ""}, {"post_id": "20325709", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T08:56:34+0300", "text": ""}, {"post_id": "20325722", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T09:00:48+0300", "text": ""}, {"post_id": "20325827", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T09:28:53+0300", "text": ""}, {"post_id": "20325857", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T09:40:24+0300", "text": ""}, {"post_id": "20325972", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T10:18:46+0300", "text": ""}, {"post_id": "20325983", "page": 8543, "author": "Владимир82.76", "post_dt": "2024-07-08T10:20:39+0300", "text": "Всем ДВС! Был вчера, путёвка с 11-00ч до 20-00ч. цель осётр. Был на переходном мосту - тишина. Перешёл под стадион,была не внятная поклёвка,но не поймал. Перешёл на плиты,там под берегом взял сома европейского на три кг и на этом всё.\nАдминистрации спасибо за рыбалку! Через месяц приеду снова!"}, {"post_id": "20325997", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T10:24:50+0300", "text": ""}, {"post_id": "20326009", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T10:27:02+0300", "text": ""}, {"post_id": "20326130", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T10:56:01+0300", "text": ""}, {"post_id": "20326252", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T11:25:31+0300", "text": ""}, {"post_id": "20326303", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T11:42:57+0300", "text": ""}, {"post_id": "20326326", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T11:53:37+0300", "text": ""}, {"post_id": "20326342", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T11:55:41+0300", "text": ""}, {"post_id": "20326408", "page": 8543, "author": "Митяй-Митинооо", "post_dt": "2024-07-08T12:17:48+0300", "text": "Аренда снастей"}]