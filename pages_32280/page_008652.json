[{"post_id": "20496963", "page": 8652, "author": "Олег179", "post_dt": "2024-08-31T12:53:22+0300", "text": "Всём привет. Был на сутках с пятницы на субботу. Ловил между мостом и пляжем на две донки. В течении дня на селёдку попался один осетрик небольшой, карп и самое интересное линь. Дистанция 35-40 метров. Активный клёв начался часов с 23 и до пол первого ночи. Только забрасываешь и уже поклевка. После часа как отрубило. Посидел до начало седьмого и уехал домой. Из насадки только селёдка, без червя. Если с червяком до начинает карп донимать да и мелочевка. Красногорску как всегда респект. Приезжайте и ловите."}, {"post_id": "20496979", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T13:00:58+0300", "text": ""}, {"post_id": "20497071", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T13:37:31+0300", "text": ""}, {"post_id": "20497146", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T14:08:10+0300", "text": ""}, {"post_id": "20497396", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T15:41:31+0300", "text": ""}, {"post_id": "20497447", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T15:56:44+0300", "text": ""}, {"post_id": "20497533", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T16:24:16+0300", "text": ""}, {"post_id": "20497641", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T17:10:18+0300", "text": ""}, {"post_id": "20497652", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T17:15:31+0300", "text": ""}, {"post_id": "20497671", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T17:23:13+0300", "text": "Завтра утром ещё под запустим Карпа из садков\nЖдём в гости\n​"}, {"post_id": "20497727", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T17:43:55+0300", "text": ""}, {"post_id": "20497783", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T17:56:38+0300", "text": ""}, {"post_id": "20497806", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T18:03:20+0300", "text": ""}, {"post_id": "20497858", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T18:15:45+0300", "text": ""}, {"post_id": "20497917", "page": 8652, "author": "Митяй-Митинооо", "post_dt": "2024-08-31T18:33:19+0300", "text": "Завтра утром ещё под запустим Карпа из садков\nЖдём в гости\n​"}]