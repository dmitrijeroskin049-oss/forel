[{"post_id": "20513198", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T10:27:51+0300", "text": ""}, {"post_id": "20513204", "page": 8661, "author": "юрий аэропорт", "post_dt": "2024-09-05T10:29:23+0300", "text": "Ого!. Теперь точно надо ехать."}, {"post_id": "20513541", "page": 8661, "author": "Митяй-Митинооо", "post_dt": "2024-09-05T12:03:28+0300", "text": ""}, {"post_id": "20513614", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T12:23:02+0300", "text": ""}, {"post_id": "20513659", "page": 8661, "author": "Митяй-Митинооо", "post_dt": "2024-09-05T12:37:32+0300", "text": "Завтра утром ожидаем партию Осетра к выходным дням,навеску обещают покрупнее\n.Более точно по факту прибытия рыбы на водоём\nС Уважением\n​"}, {"post_id": "20513661", "page": 8661, "author": "Галей", "post_dt": "2024-09-05T12:38:36+0300", "text": "А карп к выходным ещё будет?"}, {"post_id": "20513763", "page": 8661, "author": "Александр SALMO", "post_dt": "2024-09-05T13:10:08+0300", "text": "Завтра пятница  6.09.24 с утра состоится запуск клевучего Карпа.Навеска до 3.5кг.\nВечером состоится запуск Осетра.\nЖдем всех в гости.\n​"}, {"post_id": "20513887", "page": 8661, "author": "Александр SALMO", "post_dt": "2024-09-05T13:56:04+0300", "text": ""}, {"post_id": "20513933", "page": 8661, "author": "Александр SALMO", "post_dt": "2024-09-05T14:12:19+0300", "text": ""}, {"post_id": "20514084", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T14:59:11+0300", "text": ""}, {"post_id": "20514445", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T16:50:52+0300", "text": ""}, {"post_id": "20514451", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T16:51:57+0300", "text": ""}, {"post_id": "20514567", "page": 8661, "author": "Девочка Демон", "post_dt": "2024-09-05T17:23:21+0300", "text": ""}, {"post_id": "20514683", "page": 8661, "author": "юрий аэропорт", "post_dt": "2024-09-05T18:01:04+0300", "text": "Заехал в Экстрим, закупился по толстолобу. Завтра будем пробовать."}, {"post_id": "20514808", "page": 8661, "author": "Александр SALMO", "post_dt": "2024-09-05T18:31:22+0300", "text": "Юрий привет,ждем в гости"}]