[{"post_id": "21438111", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T08:23:04+0300", "text": "Запуск спорт зона 265 кг.\n​"}, {"post_id": "21438212", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T09:09:01+0300", "text": ""}, {"post_id": "21438268", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T09:34:20+0300", "text": ""}, {"post_id": "21438279", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T09:42:24+0300", "text": "Поимки спорт зона.\n​"}, {"post_id": "21438323", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T09:58:43+0300", "text": ""}, {"post_id": "21438502", "page": 9303, "author": "Митяй-Митинооо", "post_dt": "2025-05-08T11:17:51+0300", "text": ""}, {"post_id": "21438610", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T11:57:27+0300", "text": ""}, {"post_id": "21438905", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T14:12:00+0300", "text": ""}, {"post_id": "21439065", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T15:10:58+0300", "text": ""}, {"post_id": "21439133", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T15:30:58+0300", "text": ""}, {"post_id": "21439255", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T16:08:49+0300", "text": "Завтра - 80-летие Великой Победы!В честь праздника приготовим бесплатную гречневую кашу с мясом.\nЖдем всех в гости.\n​"}, {"post_id": "21439481", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T17:21:57+0300", "text": "Оплата по терминалу не всегда проходит.Поэтому заранее снимайте наличные.Переводы не принимаем.\n​"}, {"post_id": "21439605", "page": 9303, "author": "ДимаРыбачок", "post_dt": "2025-05-08T18:04:22+0300", "text": "Подскажите на что сейчас карп в основном клюет? И по прикормке, светлая или темная лучше работает?"}, {"post_id": "21439835", "page": 9303, "author": "Александр SALMO", "post_dt": "2025-05-08T19:27:29+0300", "text": "Уловы спорт зона.Вылов 196кг.\n​"}, {"post_id": "21439976", "page": 9303, "author": "Девочка Демон", "post_dt": "2025-05-08T20:08:30+0300", "text": "Уловы Основного водоема\n​"}]