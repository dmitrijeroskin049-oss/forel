[{"post_id": "22605955", "page": 10245, "author": "vitalij68", "post_dt": "2026-05-25T18:17:14+0300", "text": "Вы красавцы . А сколько запустите если не секрет?"}, {"post_id": "22605966", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-25T18:20:43+0300", "text": "Добрый день,+- один день,скидка 50%"}, {"post_id": "22606027", "page": 10245, "author": "Сергей Угодин", "post_dt": "2026-05-25T18:37:13+0300", "text": "Сколько сколько можно доп. снастей?"}, {"post_id": "22606028", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-25T18:37:33+0300", "text": ""}, {"post_id": "22606036", "page": 10245, "author": "Сергей Угодин", "post_dt": "2026-05-25T18:39:37+0300", "text": "Нашёл ответ в ленте. Спасибо"}, {"post_id": "22606059", "page": 10245, "author": "AlexLutij", "post_dt": "2026-05-25T18:45:57+0300", "text": "Судя по навеске штук 10   по  10кг"}, {"post_id": "22606062", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-25T18:46:53+0300", "text": "Добрый вечер,100кг"}, {"post_id": "22606092", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-25T18:54:22+0300", "text": "Фото с водоёма\nРыбка клюёт\nЖдём в гости\n​"}, {"post_id": "22606425", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-25T20:28:31+0300", "text": "Завтра вторник 26.05 вторая половина дня состоится очередной запуск Осетра\n,навеска 2-10+кг\nГотовьте снасти\nЖдём в гости\n​"}, {"post_id": "22607105", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-26T06:50:00+0300", "text": ""}, {"post_id": "22607139", "page": 10245, "author": "jasama", "post_dt": "2026-05-26T07:08:07+0300", "text": "Доброе утро! А во-сколько, во второй половине дня, планируется запуск?"}, {"post_id": "22607213", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-26T07:55:27+0300", "text": ""}, {"post_id": "22607233", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-26T08:07:38+0300", "text": "Доброе утро,часов 14.00 - 15.00"}, {"post_id": "22607291", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-26T08:24:53+0300", "text": ""}, {"post_id": "22607299", "page": 10245, "author": "Митяй-Митинооо", "post_dt": "2026-05-26T08:27:08+0300", "text": ""}]