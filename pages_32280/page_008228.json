[{"post_id": "19794978", "page": 8228, "author": "alexandrrubcov", "post_dt": "2024-02-21T00:15:22+0300", "text": "Это уже какой то Наутилус"}, {"post_id": "19794982", "page": 8228, "author": "vityan4ik", "post_dt": "2024-02-21T00:17:19+0300", "text": "Не прокатит!\nНадо оригинал дырявить, тогда будет дело)"}, {"post_id": "19794989", "page": 8228, "author": "Denvlad88", "post_dt": "2024-02-21T00:21:05+0300", "text": "Фирму не скажу, покрытие такое, типо керамическое."}, {"post_id": "19795126", "page": 8228, "author": "Alex_999", "post_dt": "2024-02-21T05:53:16+0300", "text": "BKK, Призер, одного поля ягоды. Это про крючки."}, {"post_id": "19795150", "page": 8228, "author": "dorofeevj", "post_dt": "2024-02-21T06:14:45+0300", "text": "Надо пробовать"}, {"post_id": "19795243", "page": 8228, "author": "Пахан78", "post_dt": "2024-02-21T07:10:37+0300", "text": "Запатентуй и начинай производство. И ты будешь богат"}, {"post_id": "19795424", "page": 8228, "author": "Сергей1703", "post_dt": "2024-02-21T08:35:42+0300", "text": "Шутки шутками, а я решил позаниматься порнографией и подвесил на голый крючок светлячок оранжевый и поставил на поставуху, так она клюнула на него!!"}, {"post_id": "19795536", "page": 8228, "author": "Митяй-Митинооо", "post_dt": "2024-02-21T09:06:52+0300", "text": "Запуск в Основной водоем 82кг\n​"}, {"post_id": "19795617", "page": 8228, "author": "HardFisherman3", "post_dt": "2024-02-21T09:22:05+0300", "text": "Ярославские краски рулят."}, {"post_id": "19795638", "page": 8228, "author": "Denvlad88", "post_dt": "2024-02-21T09:26:44+0300", "text": "Есть такая идея"}, {"post_id": "19795770", "page": 8228, "author": "Митяй-Митинооо", "post_dt": "2024-02-21T09:53:12+0300", "text": "Запуск в Спортзону 287кг\n​"}, {"post_id": "19795795", "page": 8228, "author": "Митяй-Митинооо", "post_dt": "2024-02-21T09:57:05+0300", "text": ""}, {"post_id": "19796261", "page": 8228, "author": "Митяй-Митинооо", "post_dt": "2024-02-21T11:40:46+0300", "text": ""}, {"post_id": 