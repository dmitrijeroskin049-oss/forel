[{"post_id": "22482083", "page": 10164, "author": "Легкая", "post_dt": "2026-04-15T06:56:19+0300", "text": "Всем привет, вчера СЗ с 6 до 18.00. До запуска одна на магот верх и много прещипов. Запуск одна поклевка на магот,  после запуска в течении дня 6 рыб, на разный PAL2,5 гр. верх. Было три схода. С кем ловил пламенный привет! Красногорск спасибо за рыбалку!"}, {"post_id": "22482087", "page": 10164, "author": "данилович", "post_dt": "2026-04-15T06:57:56+0300", "text": ""}, {"post_id": "22482344", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T08:37:06+0300", "text": "Поимки до запуска"}, {"post_id": "22482348", "page": 10164, "author": "юрий аэропорт", "post_dt": "2026-04-15T08:38:26+0300", "text": "Привет Дима!. Паста сыр жёлтая есть?."}, {"post_id": "22482439", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T09:05:27+0300", "text": "Привет Юрий,есть!"}, {"post_id": "22482472", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T09:14:34+0300", "text": "Запуск Форели в Основной водоём 90кг\nЖдём в гости\n​"}, {"post_id": "22482481", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T09:16:01+0300", "text": "Запуск Форели в Спортзону 95кг\n​"}, {"post_id": "22482650", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T10:05:09+0300", "text": ""}, {"post_id": "22482722", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T10:22:23+0300", "text": ""}, {"post_id": "22482809", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T10:45:45+0300", "text": ""}, {"post_id": "22482906", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T11:14:09+0300", "text": ""}, {"post_id": "22482941", "page": 10164, "author": "юрий аэропорт", "post_dt": "2026-04-15T11:25:08+0300", "text": "Понял. После обеда на сутки приеду."}, {"post_id": "22483264", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T13:05:10+0300", "text": "Всегда рады видеть\nЖдём в гости"}, {"post_id": "22483459", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T14:20:00+0300", "text": ""}, {"post_id": "22483763", "page": 10164, "author": "Митяй-Митинооо", "post_dt": "2026-04-15T16:11:49+0300", "text": ""}]