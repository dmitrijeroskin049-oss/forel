[{"post_id": "22953041", "page": 10482, "author": "юрий аэропорт", "post_dt": "2026-09-29T10:36:14+0300", "text": "На той неделе поимки были в отчетах. Но его мало кто ловит сейчас. Все на форель заточены."}, {"post_id": "22953132", "page": 10482, "author": "Митяй-Митинооо", "post_dt": "2026-09-29T10:59:29+0300", "text": "Всем Доброго времени суток\nЗавтра в среду 30.09 состоится гарантированный запуск Форели 100-200кг\nНавеска достойная ,средняя 1.8кг\nЗапуск Форели в 9.00\nГотовьте снасти покрепче\nЖдём в гости\n​"}, {"post_id": "22953199", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T11:21:38+0300", "text": ""}, {"post_id": "22953286", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T11:43:04+0300", "text": ""}, {"post_id": "22953291", "page": 10482, "author": "Пекассо", "post_dt": "2026-09-29T11:45:24+0300", "text": "Здравствуйте!Когда планируется открытие спор зоны?"}, {"post_id": "22953339", "page": 10482, "author": "kapich74", "post_dt": "2026-09-29T11:57:50+0300", "text": "Самое правильное название для нее…"}, {"post_id": "22953439", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T12:30:31+0300", "text": "Напишем заранее.Пока точную дату сказать не можем."}, {"post_id": "22953473", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T12:40:50+0300", "text": ""}, {"post_id": "22953572", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T13:09:36+0300", "text": ""}, {"post_id": "22953609", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T13:21:37+0300", "text": ""}, {"post_id": "22953655", "page": 10482, "author": "Alla_din", "post_dt": "2026-09-29T13:39:02+0300", "text": "Ударит мороз в начале ноября, как в иные года к 10му 10см был,  и спорт зоны не будет. (Если водолаз моржом под лед не полезет сетку ставить.)"}, {"post_id": "22953658", "page": 10482, "author": "viking09", "post_dt": "2026-09-29T13:40:05+0300", "text": "С 28 на 29 ночью было комфортно... только под утро немного стало зябко и пришлось одеть куртку..."}, {"post_id": "22953698", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T13:50:22+0300", "text": ""}, {"post_id": "22953733", "page": 10482, "author": "Александр SALMO", "post_dt": "2026-09-29T14:03:17+0300", "text": ""}, {"post_id": "22953737", "page": 10482, "author": "юрий аэропорт", "post_dt": "2026-09-29T14:05:12+0300", "text": "Ок. Спасибо."}]