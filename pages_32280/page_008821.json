[{"post_id": "20739573", "page": 8821, "author": "Александр SALMO", "post_dt": "2024-11-08T15:28:47+0300", "text": "Снт Садовод сад 3 для ориентира дом 104.Фото кпп правильное,через него заезжаете."}, {"post_id": "20739664", "page": 8821, "author": "Девочка Демон", "post_dt": "2024-11-08T15:51:16+0300", "text": ""}, {"post_id": "20739674", "page": 8821, "author": "Девочка Демон", "post_dt": "2024-11-08T15:53:31+0300", "text": ""}, {"post_id": "20739718", "page": 8821, "author": "Девочка Демон", "post_dt": "2024-11-08T16:06:03+0300", "text": ""}, {"post_id": "20739883", "page": 8821, "author": "Александр SALMO", "post_dt": "2024-11-08T16:46:16+0300", "text": ""}, {"post_id": "20740105", "page": 8821, "author": "Иван967", "post_dt": "2024-11-08T17:39:16+0300", "text": "Добрый вечер.были сегодня на водоеме рыбка поклевовала больше на пасив белый зелёный стрейч . На двоих 21.5 кг"}, {"post_id": "20740313", "page": 8821, "author": "Александр SALMO", "post_dt": "2024-11-08T18:23:00+0300", "text": "Уловы за сегодня.\n​"}, {"post_id": "20740516", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-08T19:03:55+0300", "text": ""}, {"post_id": "20740839", "page": 8821, "author": "Александр SALMO", "post_dt": "2024-11-08T19:48:31+0300", "text": "Уважаемые рыбаки и гости нашего водоме.К большому сожалению,переводы мы больше не принимаем.Банк заблокировал счет и в том числе карты из за большого количества переводов.У нас установлен терминал для оплаты картой,но к сожалению интернет работает очень плохо,в связи с глушилками,высоковольтными проводами или еще ,что то.Оплата не всегда проходит.Во избежании не приятных инцидентов с оплатой ,просим оплачивать НАЛИЧНЫМИ!\nС Уважением Администрация.\n​"}, {"post_id": "20740987", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-08T20:15:08+0300", "text": ""}, {"post_id": "20741444", "page": 8821, "author": "Александр SALMO", "post_dt": "2024-11-08T22:00:32+0300", "text": ""}, {"post_id": "20741958", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-09T07:55:58+0300", "text": ""}, {"post_id": "20742002", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-09T08:24:17+0300", "text": ""}, {"post_id": "20742012", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-09T08:30:30+0300", "text": "Ночные уловы\n​"}, {"post_id": "20742189", "page": 8821, "author": "Митяй-Митинооо", "post_dt": "2024-11-09T09:56:32+0300", "text": "Запуск Форели 555кг\n,навеска микс до 2кг\n​"}]