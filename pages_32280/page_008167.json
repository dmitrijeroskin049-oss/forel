[{"post_id": "19708332", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T11:08:01+0300", "text": "Запуск Основной водоем.\n​"}, {"post_id": "19708343", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T11:09:49+0300", "text": "Запуск спорт зона 360кг\n​"}, {"post_id": "19708510", "page": 8167, "author": "igor995", "post_dt": "2024-02-01T11:49:22+0300", "text": "День добрый. Какой навеской будете радовать нас в воскресенье?"}, {"post_id": "19708520", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T11:52:16+0300", "text": ""}, {"post_id": "19708534", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T11:55:47+0300", "text": "Навеска будет 1.5кг-2.5кг икряная."}, {"post_id": "19708590", "page": 8167, "author": "Вольник", "post_dt": "2024-02-01T12:07:57+0300", "text": "Самое оно"}, {"post_id": "19708607", "page": 8167, "author": "Andrey86Petrovich", "post_dt": "2024-02-01T12:11:50+0300", "text": "Это только на спортзону? Или в основной такую же закинете?"}, {"post_id": "19708652", "page": 8167, "author": "Стасссс", "post_dt": "2024-02-01T12:24:53+0300", "text": "мой традиционный вопрос ... кормить в субботу будут?"}, {"post_id": "19708703", "page": 8167, "author": "wpz88", "post_dt": "2024-02-01T12:40:04+0300", "text": "в субботу она же? на основной микс или вся помельче?"}, {"post_id": "19708749", "page": 8167, "author": "SDN1978", "post_dt": "2024-02-01T12:51:13+0300", "text": "Да, очень бы хотелось на субботу надеяться на микс на основном."}, {"post_id": "19708864", "page": 8167, "author": "zzz2099", "post_dt": "2024-02-01T13:11:39+0300", "text": "Не поймаю - так поем"}, {"post_id": "19708868", "page": 8167, "author": "Стасссс", "post_dt": "2024-02-01T13:12:29+0300", "text": "однозначно!!"}, {"post_id": "19708891", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T13:16:46+0300", "text": "В субботу на Основной водоем будет навеска микс.Основная будет 1-1.5кг и вторая навеска 1.5кг-2.5кг.\n​"}, {"post_id": "19709099", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T13:56:24+0300", "text": "Будем"}, {"post_id": "19709202", "page": 8167, "author": "Александр SALMO", "post_dt": "2024-02-01T14:15:32+0300", "text": ""}]