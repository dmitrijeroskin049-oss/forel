[{"post_id": "22956037", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T08:25:13+0300", "text": ""}, {"post_id": "22956208", "page": 10484, "author": "alex_v77", "post_dt": "2026-09-30T09:21:04+0300", "text": "Во времена, когда спортзона была с той стороны, места у сетки по наследству передавались. Если отмотать то можно найти фото как тачками улов вывозили. Только никому!"}, {"post_id": "22956213", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T09:23:13+0300", "text": "Запуск Форели 351кг\nЖдём в гости\n​"}, {"post_id": "22956404", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T10:27:25+0300", "text": "Пополнение садков Форелью,средняя навеска 1.6-1.7кг\nЖдём в гости\n​"}, {"post_id": "22956522", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T11:05:40+0300", "text": ""}, {"post_id": "22956533", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T11:07:56+0300", "text": "5шт - 9.3кг"}, {"post_id": "22956545", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T11:12:06+0300", "text": ""}, {"post_id": "22956574", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T11:19:05+0300", "text": ""}, {"post_id": "22956717", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T12:02:30+0300", "text": ""}, {"post_id": "22956736", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T12:09:25+0300", "text": ""}, {"post_id": "22956770", "page": 10484, "author": "Митяй-Митинооо", "post_dt": "2026-09-30T12:21:11+0300", "text": "Всем Доброго времени суток\nЗавтра в четверг 01.10 состоится гарантированный запуск Форели 100-200кг\nНавеска достойная ,средняя 1.8кг\nЗапуск Форели в 9.00\nГотовьте снасти покрепче\nЖдём в гости\n​"}]