[{"post_id": "19830016", "page": 8260, "author": "sergei 1986", "post_dt": "2024-02-29T19:16:27+0300", "text": "Выкладывайте"}, {"post_id": "19830056", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-02-29T19:25:51+0300", "text": "Спортзона\n221кг,вылов 219кг\n​"}, {"post_id": "19830204", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-02-29T20:00:15+0300", "text": ""}, {"post_id": "19830383", "page": 8260, "author": "ordinary man", "post_dt": "2024-02-29T20:37:32+0300", "text": "Как вариант две по 5г в гирлянду"}, {"post_id": "19831235", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T06:20:24+0300", "text": ""}, {"post_id": "19831309", "page": 8260, "author": "jasama", "post_dt": "2024-03-01T07:21:52+0300", "text": "Всем привет. Вчера СЗ. Приехал к 5:00, был вторым. Поставушки расставил в районе запуска недалеко от основного. Сразу получил переворот, но пусто, просто задела. На запуск встал в центре, ближе к сетке. До запуска 0. На запуске одна на мигалку-сверкалку со дна, две на пасту оранжевый сыр в пол воды. За лентой 0. Далее в поля. Перепробовал все ратлины которые есть, ни одного контакта. Стал переставлять поставушки. Одна сработала, взял четвертую. Пятую взял уже перед уходом, сработала вторая поставушка. Итог 5 штук на 7200. Админам респект. Всем бобра!"}, {"post_id": "19831328", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T07:30:01+0300", "text": ""}, {"post_id": "19831534", "page": 8260, "author": "Soad777", "post_dt": "2024-03-01T08:53:35+0300", "text": "Добрый день, подскажите завтра кормить будут?"}, {"post_id": "19831552", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T08:59:07+0300", "text": "Запуск в основной водоем\n​"}, {"post_id": "19831632", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T09:14:40+0300", "text": ""}, {"post_id": "19831658", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T09:21:10+0300", "text": ""}, {"post_id": "19831721", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T09:36:52+0300", "text": ""}, {"post_id": "19831727", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T09:38:10+0300", "text": "Добрый день,будем"}, {"post_id": "19831737", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T09:40:17+0300", "text": ""}, {"post_id": "19831846", "page": 8260, "author": "Митяй-Митинооо", "post_dt": "2024-03-01T10:03:29+0300", "text": ""}]