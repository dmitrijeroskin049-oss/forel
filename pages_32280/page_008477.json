[{"post_id": "20205245", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T12:25:55+0300", "text": ""}, {"post_id": "20205373", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T13:02:40+0300", "text": ""}, {"post_id": "20205612", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T13:45:53+0300", "text": ""}, {"post_id": "20205916", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T14:42:32+0300", "text": ""}, {"post_id": "20206077", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T15:39:11+0300", "text": "Поймал\n….\nОтпустил\n…..\nПутёвку получил\n​"}, {"post_id": "20206243", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T16:23:25+0300", "text": "На водоеме есть прикормка,наживка"}, {"post_id": "20206357", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T16:58:11+0300", "text": ""}, {"post_id": "20206457", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T17:20:43+0300", "text": ""}, {"post_id": "20206539", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T17:40:15+0300", "text": ""}, {"post_id": "20206598", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T17:56:23+0300", "text": ""}, {"post_id": "20206649", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T18:10:11+0300", "text": ""}, {"post_id": "20206707", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T18:19:40+0300", "text": ""}, {"post_id": "20206885", "page": 8477, "author": "пограничник 71", "post_dt": "2024-06-05T18:57:52+0300", "text": "Всем двс, небольшой отчёт о ночной рыбалке: приехал где-то пол восьмого вечера, расположение берег от администрации. До часу ночи тишина только непонятные шевеления. Потом наловил выползков и дело пошло. В час ночи первый осётр через час второй, потом обрыв, затем хороший зеркальный, сомик, но и ещё несколько Карпов на опарышей белых и красных. Рыбалкой доволен, Администрации респект и уважуха. Всем здоровья\nиНХНЧ."}, {"post_id": "20207059", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T19:32:59+0300", "text": ""}, {"post_id": "20207072", "page": 8477, "author": "Митяй-Митинооо", "post_dt": "2024-06-05T19:35:24+0300", "text": "Итоговые фото сейчас выложим"}]