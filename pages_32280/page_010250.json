[{"post_id": "22618485", "page": 10250, "author": "ДмитрийSmileHawk", "post_dt": "2026-05-29T14:34:08+0300", "text": "\"Дорогу осилит идущий\""}, {"post_id": "22618584", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-29T15:07:25+0300", "text": "Всем Доброго времени суток\nАнонс по зарыблениям на ближайшие дни\nСегодня пятница 29.05 запустили Осетра 101кг.Навеска 2-10 кг.\nВ субботу 30.05 в обед состоится очередной запуск Осетра 100кг\n,навеска 2-10кг\n.Запускать будем с 3-х точек…\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "22619012", "page": 10250, "author": "юрий аэропорт", "post_dt": "2026-05-29T18:13:15+0300", "text": "И ждущий"}, {"post_id": "22619043", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-29T18:26:28+0300", "text": "Уловы Основной водоем.\n​"}, {"post_id": "22619146", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-29T19:08:56+0300", "text": ""}, {"post_id": "22619351", "page": 10250, "author": "gysar", "post_dt": "2026-05-29T20:17:19+0300", "text": "Мужики а че то осетра невидно, неловится"}, {"post_id": "22619661", "page": 10250, "author": "-Леший-", "post_dt": "2026-05-29T22:03:20+0300", "text": "Когда 10кг за крючок дергает, еще не понятно, кто кого поймал. Может на дне вторая часть фотосъемки проходит."}, {"post_id": "22619668", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-29T22:05:19+0300", "text": ""}, {"post_id": "22620116", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-30T06:37:10+0300", "text": "Ночные уловы.\n​"}, {"post_id": "22620214", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-30T08:00:38+0300", "text": ""}, {"post_id": "22620513", "page": 10250, "author": "dimon_228_", "post_dt": "2026-05-30T10:27:58+0300", "text": "Здравствуйте,подскажите,пожалуйста,карпик поклевывает?"}, {"post_id": "22620576", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-30T10:54:16+0300", "text": "Добрый день,сегодня бастует."}, {"post_id": "22620577", "page": 10250, "author": "ДмитрийSmileHawk", "post_dt": "2026-05-30T10:54:24+0300", "text": "Судя по отчетам - рыбу явно не с собой привезли)))"}, {"post_id": "22620665", "page": 10250, "author": "Александр SALMO", "post_dt": "2026-05-30T11:36:34+0300", "text": ""}, {"post_id": "22620667", "page": 10250, "author": "юрий аэропорт", "post_dt": "2026-05-30T11:37:52+0300", "text": "У рыбы тоже должен быть выходной. А может быть у неё поминки , из-за вчерашних уловках. Родственников много выловили."}]