[{"post_id": "20048852", "page": 8393, "author": "Yakubovi4", "post_dt": "2024-04-25T09:32:26+0300", "text": "Пошло все на спад , скоро появлюсь . Месяц , без выходных . Жду не дождусь когда приеду."}, {"post_id": "20048986", "page": 8393, "author": "Александр SALMO", "post_dt": "2024-04-25T10:11:03+0300", "text": "Всегда рады видеть,ждем в гости."}, {"post_id": "20049034", "page": 8393, "author": "Максим5555", "post_dt": "2024-04-25T10:23:11+0300", "text": "Благодарю за ответ)"}, {"post_id": "20049548", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T12:20:28+0300", "text": "Всем Доброго времени суток\nТолько что поставщик подтвердил на завтра доставку первой партии Осетра\n​"}, {"post_id": "20049967", "page": 8393, "author": "Yakubovi4", "post_dt": "2024-04-25T13:59:32+0300", "text": "Какая навеска осетра и будет ли белуга в этом сезоне ?"}, {"post_id": "20050286", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T15:05:18+0300", "text": "Завтра по факту прибытия и сообщим"}, {"post_id": "20050441", "page": 8393, "author": "jasama", "post_dt": "2024-04-25T15:35:37+0300", "text": "А запускать когда планируете? Добрый день."}, {"post_id": "20050633", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T16:15:37+0300", "text": "Добрый день,в субботу"}, {"post_id": "20050845", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T17:21:14+0300", "text": "На водоем привезли прикормку на Карпа,а так же опарыша и червя\n​"}, {"post_id": "20050901", "page": 8393, "author": "Андрей Милославский", "post_dt": "2024-04-25T17:35:59+0300", "text": "ДВС, а кто-то уже ловит?"}, {"post_id": "20051106", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T18:46:12+0300", "text": ""}, {"post_id": "20051186", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T19:10:42+0300", "text": "Фото с водоема\n​"}, {"post_id": "20051363", "page": 8393, "author": "Mag1", "post_dt": "2024-04-25T19:48:44+0300", "text": "Завтра зарыбления форелью не будет?"}, {"post_id": "20051537", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T20:21:13+0300", "text": "Форель больше не запускаем"}, {"post_id": "20051643", "page": 8393, "author": "Митяй-Митинооо", "post_dt": "2024-04-25T20:36:57+0300", "text": ""}]