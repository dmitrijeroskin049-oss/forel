[{"post_id": "20397317", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T11:43:56+0300", "text": ""}, {"post_id": "20397357", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T11:56:44+0300", "text": ""}, {"post_id": "20397380", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T12:05:28+0300", "text": "Александр с Носатым на Ты)\n​"}, {"post_id": "20397452", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T12:31:00+0300", "text": ""}, {"post_id": "20397500", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T12:48:00+0300", "text": ""}, {"post_id": "20397598", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:21:57+0300", "text": ""}, {"post_id": "20397609", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:24:34+0300", "text": ""}, {"post_id": "20397635", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:36:04+0300", "text": ""}, {"post_id": "20397645", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:38:43+0300", "text": "Завтра в Среду\n31\nИюля\n2024 года «Льготный день».\nИнвалиды,ветераны,учатники боевых действий,пенсионеры,многодетные скидка 25%.При себе иметь подтверждающий документ.\nЦена путевки :\n2300₽ День с 6:00-19:00\n2000₽ Утро (без скидки)\n2300₽ Ночь с 18:00-06:00\n3400₽ Сутки с момента прибытия\nПриоритетный час 300₽,дополнительная снасть 500₽ не более 1шт.\nДля рыбаков не имеющих льгот,цена путевки\n3100₽ День с 6:00-19:00\n2000 Утро с 6:00-12:00\n1700₽ Обед с 12:00-19:00\n3100₽ Ночь с 18:00-6:00\n4500₽ Сутки с момента прибытия\nС Уважением Администрация.\n​"}, {"post_id": "20397664", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:46:27+0300", "text": "Всем Доброго времени суток\nСегодня вечером состоится очередной запуск Осетра\nЖдём Всех в гости\n​"}, {"post_id": "20397673", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:48:30+0300", "text": ""}, {"post_id": "20397711", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T13:57:58+0300", "text": ""}, {"post_id": "20397742", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T14:03:40+0300", "text": ""}, {"post_id": "20397769", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T14:09:44+0300", "text": ""}, {"post_id": "20397847", "page": 8590, "author": "Митяй-Митинооо", "post_dt": "2024-07-30T14:31:20+0300", "text": ""}]