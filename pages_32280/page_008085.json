[{"post_id": "19615866", "page": 8085, "author": "Maxwell_fishing", "post_dt": "2024-01-11T04:39:13+0300", "text": "А чем красили ?"}, {"post_id": "19615887", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T05:43:57+0300", "text": "Убедительная просьба не ставьте машины возле нашего шлагбаума.Оставьте проезд для грузовой машины с рыбой.\nС Уважением Администрация.\n​"}, {"post_id": "19616135", "page": 8085, "author": "Yakubovi4", "post_dt": "2024-01-11T09:07:05+0300", "text": "Да ! Именно так."}, {"post_id": "19616584", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T11:20:07+0300", "text": "Запуск Основной водоем 32 кг\n​"}, {"post_id": "19616593", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T11:22:13+0300", "text": "Запуск спорт зона 275 кг.\n​"}, {"post_id": "19616627", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T11:28:05+0300", "text": ""}, {"post_id": "19616738", "page": 8085, "author": "Девочка Демон", "post_dt": "2024-01-11T11:56:14+0300", "text": ""}, {"post_id": "19616822", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T12:15:36+0300", "text": ""}, {"post_id": "19617026", "page": 8085, "author": "Zhiglo", "post_dt": "2024-01-11T13:15:58+0300", "text": "Приветствую товарищи.абонимент на основной может кому нужен,думаю не успею использовать .из 6 только одну использовал.в личку"}, {"post_id": "19617049", "page": 8085, "author": "Девочка Демон", "post_dt": "2024-01-11T13:20:41+0300", "text": ""}, {"post_id": "19617081", "page": 8085, "author": "Alex_999", "post_dt": "2024-01-11T13:31:18+0300", "text": "Предполагаю, что черным тонирующим лаком для автомобильной оптики. Чем передние фары почти в ноль тонируют \"любители тюнинха\". По факту хороший транспарентный тонирующий лак. Встречал черный и красный."}, {"post_id": "19617103", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T13:38:48+0300", "text": ""}, {"post_id": "19617137", "page": 8085, "author": "Девочка Демон", "post_dt": "2024-01-11T13:48:15+0300", "text": ""}, {"post_id": "19617217", "page": 8085, "author": "Митяй-Митинооо", "post_dt": "2024-01-11T14:10:32+0300", "text": ""}, {"post_id": "19617235", "page": 8085, "author": "Александр SALMO", "post_dt": "2024-01-11T14:17:25+0300", "text": ""}]