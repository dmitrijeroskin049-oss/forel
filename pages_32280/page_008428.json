[{"post_id": "20116791", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T12:24:47+0300", "text": ""}, {"post_id": "20116961", "page": 8428, "author": "MasterCarp", "post_dt": "2024-05-12T13:18:06+0300", "text": "Всех приветствую. Уважаемая администрация, а вы тариф ПО не рассматривали  ? Рыба не нужна, а половить хочется))). И 3100 платить жалко)). И всем хорошо. И вас деньги прибавиться а рыбы не убавится  )))"}, {"post_id": "20117209", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T14:31:10+0300", "text": ""}, {"post_id": "20117365", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T15:04:11+0300", "text": ""}, {"post_id": "20117964", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T17:17:00+0300", "text": "На водоеме есть прикормка,наживка"}, {"post_id": "20118540", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T19:31:36+0300", "text": "Фото с водоема\n​"}, {"post_id": "20118844", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-12T20:20:14+0300", "text": "Путёвка с обеда\n​"}, {"post_id": "20119056", "page": 8428, "author": "Silvius", "post_dt": "2024-05-12T21:10:58+0300", "text": "Это был не карп, а линь. Пучок червя у берега."}, {"post_id": "20119057", "page": 8428, "author": "Владиммр64", "post_dt": "2024-05-12T21:11:26+0300", "text": "Добрый вечер.\nКогда планируете очередной запуск осетра?"}, {"post_id": "20119234", "page": 8428, "author": "sergei 1986", "post_dt": "2024-05-12T21:50:14+0300", "text": "Было 5-запусков и не один даже запуск не выловили. Ребята так разарятся постоянно запускать."}, {"post_id": "20119791", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-13T04:40:53+0300", "text": "Доброе утро.В этом сезоне Осетра запустили 600кг,выловили не более 150-170кг.О дальнейших запусках сообщим заранее\nС Уважением"}, {"post_id": "20119860", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-13T06:14:48+0300", "text": "Вчерашнего рыбака забыли выложить\n​"}, {"post_id": "20119943", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-13T07:29:32+0300", "text": ""}, {"post_id": "20119985", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-13T07:51:14+0300", "text": ""}, {"post_id": "20120095", "page": 8428, "author": "Митяй-Митинооо", "post_dt": "2024-05-13T08:35:11+0300", "text": ""}]