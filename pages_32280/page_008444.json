[{"post_id": "20155799", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T14:51:22+0300", "text": ""}, {"post_id": "20155919", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T15:19:33+0300", "text": ""}, {"post_id": "20156116", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T16:04:21+0300", "text": ""}, {"post_id": "20156188", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T16:23:46+0300", "text": ""}, {"post_id": "20156240", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T16:36:19+0300", "text": ""}, {"post_id": "20156307", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T16:57:37+0300", "text": ""}, {"post_id": "20156454", "page": 8444, "author": "V.o.v.a.n1997", "post_dt": "2024-05-22T17:36:16+0300", "text": "Скажите пожалуйста есть в продаже червь опарыш"}, {"post_id": "20156556", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T18:03:05+0300", "text": "Добрый вечер,всё есть"}, {"post_id": "20156592", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T18:18:18+0300", "text": ""}, {"post_id": "20156728", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T18:51:46+0300", "text": "Цена путёвки на основной водоём....\nС 06.00-19.00 - 3100р\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р Разрешено ловить на 2 снасти\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20156733", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T18:52:49+0300", "text": "На водоеме есть прикормка,наживка"}, {"post_id": "20156737", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T18:53:55+0300", "text": "Арена снастей"}, {"post_id": "20156765", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T19:02:00+0300", "text": "Рыба есть,рыба ест\n25 штук-70кг\n​"}, {"post_id": "20156783", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T19:07:22+0300", "text": "Крупнячок за сегодня"}, {"post_id": "20156790", "page": 8444, "author": "Митяй-Митинооо", "post_dt": "2024-05-22T19:08:42+0300", "text": "Итоговые фото сейчас выложим"}]