[{"post_id": "19984271", "page": 8360, "author": "юрий аэропорт", "post_dt": "2024-04-09T07:53:54+0300", "text": "Привет Дима!. Сегодня с Вами рыбачим?"}, {"post_id": "19984311", "page": 8360, "author": "МегаРыбак_3", "post_dt": "2024-04-09T08:12:11+0300", "text": "Доброе утро , подскажите пожалуйста, когда возобновятся запуски?  Завтра ещë без запуска будет?"}, {"post_id": "19984315", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:13:07+0300", "text": "Можно взять одну доп снасть 500р"}, {"post_id": "19984320", "page": 8360, "author": "vaskinalex", "post_dt": "2024-04-09T08:14:36+0300", "text": "Доброе утро. А под мостом и в угле запрет уже снят?"}, {"post_id": "19984326", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:17:49+0300", "text": "Привет Юрий\n,да"}, {"post_id": "19984335", "page": 8360, "author": "юрий аэропорт", "post_dt": "2024-04-09T08:19:50+0300", "text": "Замечательно!. С осени не виделись."}, {"post_id": "19984336", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:19:54+0300", "text": ""}, {"post_id": "19984439", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:53:09+0300", "text": "Доброе утро\nСегодня в первой половине дня ожидаем водолаза для поднятия сетки ,чтобы оставшаяся рыба разошлась вся по водоему.\nО возобновлении запусков сообщим заранее,в данный момент рыбы в водоеме достаточно(за зиму накопилось прилично),по фото и видео думаю видно.На данный момент ее потихоньку надо вышибать,не за горами лето и запуски мирной рыбы\nС Уважением"}, {"post_id": "19984441", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:54:25+0300", "text": ""}, {"post_id": "19984444", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T08:55:27+0300", "text": "Доброе утро,да"}, {"post_id": "19984467", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T09:02:28+0300", "text": ""}, {"post_id": "19984554", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T09:22:47+0300", "text": ""}, {"post_id": "19984640", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T09:48:57+0300", "text": ""}, {"post_id": "19984778", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T10:25:42+0300", "text": ""}, {"post_id": "19984889", "page": 8360, "author": "Митяй-Митинооо", "post_dt": "2024-04-09T10:51:25+0300", "text": ""}]