[{"post_id": "20187928", "page": 8465, "author": "Девочка Демон", "post_dt": "2024-05-31T08:16:28+0300", "text": ""}, {"post_id": "20187946", "page": 8465, "author": "Девочка Демон", "post_dt": "2024-05-31T08:20:53+0300", "text": ""}, {"post_id": "20187951", "page": 8465, "author": "Девочка Демон", "post_dt": "2024-05-31T08:21:56+0300", "text": ""}, {"post_id": "20187985", "page": 8465, "author": "Серега Внуковский", "post_dt": "2024-05-31T08:34:16+0300", "text": "Шо, опять!"}, {"post_id": "20188023", "page": 8465, "author": "Sergey 1974", "post_dt": "2024-05-31T08:44:20+0300", "text": "Так как?"}, {"post_id": "20188031", "page": 8465, "author": "Александр SALMO", "post_dt": "2024-05-31T08:46:39+0300", "text": "Доброе утро.Скидка 50% в день рождения,либо +-1 день.Следовательно если было ДР вчера,сегодня можете приехать по скидке."}, {"post_id": "20188163", "page": 8465, "author": "Андрей Милославский", "post_dt": "2024-05-31T09:12:47+0300", "text": "Снова, елки-палки)))"}, {"post_id": "20188251", "page": 8465, "author": "Девочка Демон", "post_dt": "2024-05-31T09:42:39+0300", "text": ""}, {"post_id": "20188319", "page": 8465, "author": "Aura-Wolf", "post_dt": "2024-05-31T10:02:07+0300", "text": "доброе утро.. вопрос такой, возможно уже интересовались, прошу прощения.. часть дикого пруда за сеткой, считается всеобщим? т. е. можно там ловить бесплатно"}, {"post_id": "20188390", "page": 8465, "author": "Sergey 1974", "post_dt": "2024-05-31T10:19:45+0300", "text": "Спасибо, приеду"}, {"post_id": "20188400", "page": 8465, "author": "Александр SALMO", "post_dt": "2024-05-31T10:22:58+0300", "text": "Добрый день,временно бесплатно для жителей Красногорска,с пропиской."}, {"post_id": "20188408", "page": 8465, "author": "Александр SALMO", "post_dt": "2024-05-31T10:24:20+0300", "text": ""}, {"post_id": "20188409", "page": 8465, "author": "Aura-Wolf", "post_dt": "2024-05-31T10:24:51+0300", "text": "а это проверяется?\nи какого цена тем, кто с Москвы?"}, {"post_id": "20188417", "page": 8465, "author": "Александр SALMO", "post_dt": "2024-05-31T10:28:06+0300", "text": "Для остальных 1000₽.При обходе нарушителей выгоняем."}, {"post_id": "20188421", "page": 8465, "author": "Александр SALMO", "post_dt": "2024-05-31T10:29:06+0300", "text": ""}]