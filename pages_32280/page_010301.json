[{"post_id": "22700520", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T18:10:21+0300", "text": "Запуск Осетрового микса 102кг\n,навеска 2-2.5кг\n.Общий вес за сегодня составил 205кг Осетра\n+ завтра в обед ещё 100кг Осетра запустим\nЖдём Всех в гости\n​"}, {"post_id": "22700618", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T18:42:36+0300", "text": ""}, {"post_id": "22700632", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T18:47:16+0300", "text": ""}, {"post_id": "22700648", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T18:53:42+0300", "text": ""}, {"post_id": "22700695", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T19:10:09+0300", "text": "Фото с водоёма\n​"}, {"post_id": "22700822", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T20:05:08+0300", "text": "Алексей ещё одного Осетра припарковал\n,с нового переходного моста"}, {"post_id": "22700948", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-26T21:04:13+0300", "text": "Аренда снастей"}, {"post_id": "22701561", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T06:25:30+0300", "text": ""}, {"post_id": "22701614", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T07:09:34+0300", "text": ""}, {"post_id": "22701633", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T07:28:39+0300", "text": ""}, {"post_id": "22701653", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T07:45:01+0300", "text": ""}, {"post_id": "22701661", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T07:50:01+0300", "text": ""}, {"post_id": "22701672", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T08:00:02+0300", "text": ""}, {"post_id": "22701799", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "2026-06-27T08:51:05+0300", "text": ""}, {"post_id": "22701870", "page": 10301, "author": "Митяй-Митинооо", "post_dt": "