[{"post_id": "21174106", "page": 9138, "author": "Папин Сибиряк", "post_dt": "2025-02-25T22:36:44+0300", "text": "Да уж . Епохальное фото. На основном , с обеда , вставил спорЦМенам по полной."}, {"post_id": "21174348", "page": 9138, "author": "Мультовик", "post_dt": "2025-02-26T00:42:14+0300", "text": "С.З.сегодня день 'блёсны'. Чем больше нового, тем больше забываем про старое. Чиунук в цвете \"Спартак\", сделал рыбалку. На запуске пару на \"дискотеку\". Поставушки три рыбки принесли, \"стреч\". Остальные блесна. Получилось 10 рыбок на 10,5 кг. Красному спасибо! Всем НХНЧ!"}, {"post_id": "21174413", "page": 9138, "author": "Сергей кадр", "post_dt": "2025-02-26T04:30:27+0300", "text": ""}, {"post_id": "21174441", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T06:11:10+0300", "text": "Оплата по терминалу не всегда проходит.Поэтому заранее снимайте наличные.Переводы не принимаем.\n​"}, {"post_id": "21174867", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T09:32:38+0300", "text": "Запуск спорт зона 167 кг.\n​"}, {"post_id": "21174881", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T09:34:21+0300", "text": "Запуск Основной водоем 140 кг.\n​"}, {"post_id": "21174885", "page": 9138, "author": "sergei 1986", "post_dt": "2025-02-26T09:35:32+0300", "text": "Приветствую всех! Вчера С/З до запуска холостые поклевки на пасту.\nЗапуск 2-ве шт, потом всё добрал в полях. Ловил на 211 , основном вся рыба до метра из подольда. Итог: 11 шт"}, {"post_id": "21175144", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T10:42:24+0300", "text": ""}, {"post_id": "21175212", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T11:03:18+0300", "text": ""}, {"post_id": "21175396", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T11:51:50+0300", "text": "Поимки спорт зона.\n​"}, {"post_id": "21175470", "page": 9138, "author": "андрей-митинский", "post_dt": "2025-02-26T12:11:21+0300", "text": "Чем тебя угощают"}, {"post_id": "21175504", "page": 9138, "author": "Девочка Демон", "post_dt": "2025-02-26T12:24:55+0300", "text": "Поимки Основной водоем\n​"}, {"post_id": "21175687", "page": 9138, "author": "Митяй-Митинооо", "post_dt": "2025-02-26T13:25:35+0300", "text": ""}, {"post_id": "21175912", "page": 9138, "author": "Александр SALMO", "post_dt": "2025-02-26T14:34:33+0300", "text": ""}, {"post_id": "21176109", "page": 9138, "author": "Леонид 87", "post_dt": "2025-02-26T15:29:40+0300", "text": "день добрый!верховка есть на водоёме?"}]