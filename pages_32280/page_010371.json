[{"post_id": "22805117", "page": 10371, "author": "Koctac", "post_dt": "2026-08-06T14:09:00+0300", "text": ""}, {"post_id": "22805122", "page": 10371, "author": "Koctac", "post_dt": "2026-08-06T14:10:01+0300", "text": "А меченный, какая метка? ввиде чего?"}, {"post_id": "22805165", "page": 10371, "author": "одинокий63", "post_dt": "2026-08-06T14:29:00+0300", "text": "Как у горбачёва,родимое пятно..\nКто же Вам скажет?"}, {"post_id": "22805167", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T14:29:26+0300", "text": "Выколоты глаза и зашит рот\nА если серьезно…на хвосте будет метка"}, {"post_id": "22805229", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T14:51:36+0300", "text": ""}, {"post_id": "22805256", "page": 10371, "author": "Koctac", "post_dt": "2026-08-06T15:02:24+0300", "text": "Так а как тогда понять что поймал меченного? ЧТоб приз забрать"}, {"post_id": "22805353", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T15:40:17+0300", "text": ""}, {"post_id": "22805376", "page": 10371, "author": "sergei 1986", "post_dt": "2026-08-06T15:51:04+0300", "text": "Димон здорова. Как клёв там у вас ."}, {"post_id": "22805378", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T15:51:43+0300", "text": ""}, {"post_id": "22805387", "page": 10371, "author": "sergei 1986", "post_dt": "2026-08-06T15:53:44+0300", "text": ""}, {"post_id": "22805391", "page": 10371, "author": "sergei 1986", "post_dt": "2026-08-06T15:54:45+0300", "text": "У нас Димон тоже клюёт."}, {"post_id": "22805400", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T15:59:51+0300", "text": "Привет.У нас всегда клюёт"}, {"post_id": "22805406", "page": 10371, "author": "Рамид", "post_dt": "2026-08-06T16:03:04+0300", "text": "Скорее всего рот зашитый"}, {"post_id": "22805466", "page": 10371, "author": "Митяй-Митинооо", "post_dt": "2026-08-06T16:31:11+0300", "text": ""}, {"post_id": "22805495", "page": 10371, "author": "юрий аэропорт", "post_dt": "2026-08-06T16:45:12+0300", "text": "Зачем интригу убрал?"}]