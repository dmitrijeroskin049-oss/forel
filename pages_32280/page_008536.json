[{"post_id": "20317123", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T12:37:54+0300", "text": "Запуск Осетрины до 8 кг\n.Общий вес 176 кг.Проверяйте снасти\n​"}, {"post_id": "20317216", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T13:06:30+0300", "text": ""}, {"post_id": "20317226", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T13:08:46+0300", "text": ""}, {"post_id": "20317268", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T13:23:57+0300", "text": "Обратно в родную стихию."}, {"post_id": "20317303", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T13:33:44+0300", "text": ""}, {"post_id": "20317492", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T14:41:27+0300", "text": ""}, {"post_id": "20317495", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T14:42:40+0300", "text": ""}, {"post_id": "20317541", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T14:58:49+0300", "text": ""}, {"post_id": "20317796", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T16:29:10+0300", "text": "Завтра утром состоится запуск Африканского Сома.\n​"}, {"post_id": "20317861", "page": 8536, "author": "Chainger", "post_dt": "2024-07-05T16:53:19+0300", "text": "А будет завтра стандартный запуск осетра?"}, {"post_id": "20317872", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T16:58:21+0300", "text": ""}, {"post_id": "20317922", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T17:13:29+0300", "text": "Добрый день.Сегодня запуск произвели Осетра больше чем обычно.Решили не варить крупного Осетра в садке навеска которого до 8кг.Запуск осетрины до 8кг составил 176кг.Не забываем ,что предыдущие 2 запуска Осетра до 4кг подзависли.\nА Сомика Африканского обязательно завтра подкинем."}, {"post_id": "20318099", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T18:04:10+0300", "text": ""}, {"post_id": "20318210", "page": 8536, "author": "Александр SALMO", "post_dt": "2024-07-05T18:33:46+0300", "text": ""}, {"post_id": "20318408", "page": 8536, "author": "Девочка Демон", "post_dt": "2024-07-05T19:35:50+0300", "text": "Итоговые фото , сейчас выложим."}]