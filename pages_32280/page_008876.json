[{"post_id": "20816947", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T10:32:10+0300", "text": ""}, {"post_id": "20817237", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T11:55:04+0300", "text": ""}, {"post_id": "20817290", "page": 8876, "author": "VAV1511", "post_dt": "2024-11-28T12:05:28+0300", "text": "О правильно , чтобы не замерзла рыбка"}, {"post_id": "20817321", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T12:13:32+0300", "text": ""}, {"post_id": "20817398", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T12:33:43+0300", "text": ""}, {"post_id": "20817511", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T13:13:56+0300", "text": "Сергей про рыбалку на СЗ\n​"}, {"post_id": "20817534", "page": 8876, "author": "ДАША14", "post_dt": "2024-11-28T13:20:09+0300", "text": "Уважаемая администрация а спорт зоне для садков нет крючков?"}, {"post_id": "20817571", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T13:34:26+0300", "text": ""}, {"post_id": "20817626", "page": 8876, "author": "gnk_fil", "post_dt": "2024-11-28T13:47:46+0300", "text": "Народный день не планируете после выходных сделать?  На следующей недели, где плюсовая будет, было бы здорово."}, {"post_id": "20817666", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T13:59:24+0300", "text": ""}, {"post_id": "20817737", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T14:29:07+0300", "text": ""}, {"post_id": "20817744", "page": 8876, "author": "Strey", "post_dt": "2024-11-28T14:32:52+0300", "text": "почти все видео со спорт зоны - поимки с понтона ближе к середине.\nРып около аэратора тусит?\nИли клюет по всем точкам, просто понтон удобнее всего снимать?"}, {"post_id": "20817756", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T14:36:56+0300", "text": "Планируем,всё сообщим"}, {"post_id": "20817768", "page": 8876, "author": "дмитриё", "post_dt": "2024-11-28T14:40:12+0300", "text": "Запрет на блесна более пяти грамм сняли?"}, {"post_id": "20817794", "page": 8876, "author": "Митяй-Митинооо", "post_dt": "2024-11-28T14:46:40+0300", "text": ""}]