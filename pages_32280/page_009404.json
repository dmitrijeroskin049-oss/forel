[{"post_id": "21587253", "page": 9404, "author": "Александр SALMO", "post_dt": "2025-06-26T16:31:04+0300", "text": ""}, {"post_id": "21587393", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-26T17:10:31+0300", "text": "Всем Доброго времени суток\nАнонс по зарыблениям на ближайшие дни\nЗавтра 27.06 в пятницу вечером запуск Осетра 100кг,навеска до 7кг\nВ субботу 28.06 утром запуск Осетра 100кг,навеска до 7кг\nи вечером ещё 100кг Осетра ,навеска до 7кг\nГотовьте снасти\nЖдём Всех в гости\n​"}, {"post_id": "21587482", "page": 9404, "author": "Александр SALMO", "post_dt": "2025-06-26T17:37:56+0300", "text": ""}, {"post_id": "21587734", "page": 9404, "author": "Александр SALMO", "post_dt": "2025-06-26T19:20:05+0300", "text": "Уловы за сегодня.\n​"}, {"post_id": "21587914", "page": 9404, "author": "Александр SALMO", "post_dt": "2025-06-26T20:13:38+0300", "text": ""}, {"post_id": "21588671", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T06:48:27+0300", "text": ""}, {"post_id": "21588826", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T08:14:47+0300", "text": ""}, {"post_id": "21588857", "page": 9404, "author": "юрий аэропорт", "post_dt": "2025-06-27T08:34:01+0300", "text": "Привет Дима!. К 13 приеду. У Вас случайно не завалялись грузила для снасти на лобастова?. Дома оставил свои, а по дороге неизвестно, куплю или нет."}, {"post_id": "21588880", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T08:40:37+0300", "text": "Привет Юрий,к сожалению нет"}, {"post_id": "21588985", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T09:17:12+0300", "text": ""}, {"post_id": "21589016", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T09:30:14+0300", "text": ""}, {"post_id": "21589105", "page": 9404, "author": "юрий аэропорт", "post_dt": "2025-06-27T09:55:09+0300", "text": "Карпуша то поклевывает?"}, {"post_id": "21589116", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T09:59:17+0300", "text": "Поклёвывает),но не так как хотелось бы"}, {"post_id": "21589118", "page": 9404, "author": "Митяй-Митинооо", "post_dt": "2025-06-27T10:00:18+0300", "text": ""}, {"post_id": "21589160", "page": 9404, "author": "юрий аэропорт", "post_dt": "2025-06-27T10:18:02+0300", "text": "Ну, в общем все как обычно. Опять танцы с бубнами будут"}]