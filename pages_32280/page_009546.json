[{"post_id": "21791233", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T08:47:22+0300", "text": ""}, {"post_id": "21791281", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T09:06:27+0300", "text": ""}, {"post_id": "21791285", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T09:08:49+0300", "text": ""}, {"post_id": "21791327", "page": 9546, "author": "Пахан78", "post_dt": "2025-09-07T09:25:59+0300", "text": ".."}, {"post_id": "21791335", "page": 9546, "author": "Легкая", "post_dt": "2025-09-07T09:30:02+0300", "text": "Монгол?????"}, {"post_id": "21791349", "page": 9546, "author": "Rumata", "post_dt": "2025-09-07T09:36:28+0300", "text": "Всем привет! Был вчера с 6.00 и до 16.00. Поймал 7 штучек форели на 10150 кг. Из них две мамки. Стоял под серым мостом на запуск не ходил. С утра тишина, после запуска стало веселее. Одну поймал на блесну Pal 1.7 гр (зелёная на серой подложке), одну на белый воблер Дайва, остальные на маленький белый магот. Были ещё поклевки и сходы. Горизонт - все с верху. А на пасту брала с пол воды, жёлтый сыр. Рыбалкой доволен, адриналину хапнул, тк рыба очень бойкая)) Админам спасибо! Ждёмс сз. Всем НХНЧ!"}, {"post_id": "21791354", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T09:39:36+0300", "text": ""}, {"post_id": "21791370", "page": 9546, "author": "МегаРыбак_3", "post_dt": "2025-09-07T09:44:02+0300", "text": ""}, {"post_id": "21791402", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T09:55:57+0300", "text": ""}, {"post_id": "21791467", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T10:23:43+0300", "text": ""}, {"post_id": "21791497", "page": 9546, "author": "Пахан78", "post_dt": "2025-09-07T10:40:31+0300", "text": "якут"}, {"post_id": "21791503", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T10:42:40+0300", "text": ""}, {"post_id": "21791671", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T12:02:33+0300", "text": ""}, {"post_id": "21791678", "page": 9546, "author": "AlexLutij", "post_dt": "2025-09-07T12:05:53+0300", "text": "Завтра с запуском?"}, {"post_id": "21791700", "page": 9546, "author": "Александр SALMO", "post_dt": "2025-09-07T12:17:11+0300", "text": "Завтра Понедельник 08.09 ориентировочный запуск Форели 100-200кг\nЗапуск Форели в 08.00\nЖдём в гости\n​"}]