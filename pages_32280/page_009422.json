[{"post_id": "21613900", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T08:34:10+0300", "text": "Запуск Осетра 101кг\n,навеска микс до 6кг\nВечером ещё 100кг Осетра запустим\nЖдём в гости\n​"}, {"post_id": "21613929", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T08:47:27+0300", "text": ""}, {"post_id": "21613942", "page": 9422, "author": "Виталик капитан", "post_dt": "2025-07-05T08:56:01+0300", "text": "Привет. Брал с того момента как как начал его ловить, с 12 дня и до вечера, пока уехал. Кукуруза, самая мягкая и чуть придавлена, с двумя опарашами."}, {"post_id": "21613977", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T09:08:53+0300", "text": ""}, {"post_id": "21613992", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T09:16:47+0300", "text": ""}, {"post_id": "21614058", "page": 9422, "author": "DoctorSavchenko", "post_dt": "2025-07-05T09:59:09+0300", "text": "Всем привет, ночная путевка с доп часами, приехали с корешом, он раньше, я чуть позже, сидели где ссаный угол, я 6 осетров и 2 карпа, корешь 10 осетров и 2 карпа, один осетр на 5кг.\nРыбалкой довольны! Спасибо администрации за прием! Приедем еще! Всем НХНЧ"}, {"post_id": "21614107", "page": 9422, "author": "Panalex12", "post_dt": "2025-07-05T10:22:57+0300", "text": "\"ссаный угол\" - это приговор :-)))"}, {"post_id": "21614128", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T10:32:58+0300", "text": ""}, {"post_id": "21614136", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T10:37:48+0300", "text": ""}, {"post_id": "21614260", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T11:28:38+0300", "text": ""}, {"post_id": "21614276", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T11:36:33+0300", "text": ""}, {"post_id": "21614362", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T12:13:46+0300", "text": ""}, {"post_id": "21614398", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T12:34:08+0300", "text": ""}, {"post_id": "21614419", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T12:48:18+0300", "text": "Путёвка «Утро»"}, {"post_id": "21614433", "page": 9422, "author": "Митяй-Митинооо", "post_dt": "2025-07-05T13:01:26+0300", "text": ""}]