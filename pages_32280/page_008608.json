[{"post_id": "20430526", "page": 8608, "author": "Александр SALMO", "post_dt": "2024-08-09T20:04:30+0300", "text": "Завтра вечером состоится запуск Осетра.\n​"}, {"post_id": "20430695", "page": 8608, "author": "stalcer12", "post_dt": "2024-08-09T20:43:31+0300", "text": "Сома не планирруете запускать больше в этом году ?"}, {"post_id": "20430854", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-09T21:30:15+0300", "text": "Добрый вечер,нет"}, {"post_id": "20431492", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T06:41:49+0300", "text": ""}, {"post_id": "20431514", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T07:05:01+0300", "text": "Уловы\n​"}, {"post_id": "20431573", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T07:40:44+0300", "text": ""}, {"post_id": "20431641", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T08:11:40+0300", "text": ""}, {"post_id": "20431731", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T08:45:31+0300", "text": ""}, {"post_id": "20431805", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T09:20:48+0300", "text": ""}, {"post_id": "20431849", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T09:39:51+0300", "text": ""}, {"post_id": "20431913", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T10:04:13+0300", "text": ""}, {"post_id": "20432007", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T10:35:31+0300", "text": ""}, {"post_id": "20432018", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T10:38:00+0300", "text": ""}, {"post_id": "20432065", "page": 8608, "author": "Ya-Val'demar", "post_dt": "2024-08-10T10:59:51+0300", "text": "Всем,доброе утро!\nПосетил вчера водоем,ловил карпика!\nс утра рыба отзывалась  на опарыша штук 8-10 на крючке,и на кукурузу с опарышем. Все поклёвки жадные,несколько раз палка уезжала в воду!\nПоймал 5 рыб,два амура-хорошие около двушки наверное,может больше,но сопротивлялись знатно,взял пару карпиков и красавца линя-жирного,больше кило)))\nК сожалению после дождей у меня все затихло,ну ничего,свою рыбу поймал,я доволен\nМешался на разных прикормках,немного краски,кауруза бондюэль и немного опарыша\nСпасибо администрации за рыбалку!\nВсем НХНЧ!"}, {"post_id": "20432066", "page": 8608, "author": "Митяй-Митинооо", "post_dt": "2024-08-10T11:00:02+0300", "text": ""}]