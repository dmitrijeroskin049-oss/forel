[{"post_id": "20209097", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T10:26:22+0300", "text": ""}, {"post_id": "20209259", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T11:14:52+0300", "text": ""}, {"post_id": "20209324", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T11:39:07+0300", "text": ""}, {"post_id": "20209563", "page": 8479, "author": "юрий аэропорт", "post_dt": "2024-06-06T12:51:24+0300", "text": "Шо!? Опять?. У нее входит в привычку позировать на фото."}, {"post_id": "20209573", "page": 8479, "author": "юрий аэропорт", "post_dt": "2024-06-06T12:54:07+0300", "text": "А какую?"}, {"post_id": "20209584", "page": 8479, "author": "Андрей Милославский", "post_dt": "2024-06-06T12:57:54+0300", "text": "Вабик,вроде бы."}, {"post_id": "20209640", "page": 8479, "author": "юрий аэропорт", "post_dt": "2024-06-06T13:16:20+0300", "text": "А ты ей пользовался? Я нет."}, {"post_id": "20209690", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T13:35:34+0300", "text": ""}, {"post_id": "20210067", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T15:30:24+0300", "text": ""}, {"post_id": "20210259", "page": 8479, "author": "Андрей Милославский", "post_dt": "2024-06-06T16:27:12+0300", "text": "Нет, но было интересно."}, {"post_id": "20210260", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T16:27:47+0300", "text": ""}, {"post_id": "20210384", "page": 8479, "author": "Саня400", "post_dt": "2024-06-06T17:13:58+0300", "text": "Добрый вечер! Завтра запуски будут?"}, {"post_id": "20210532", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T18:01:02+0300", "text": "Пополнение садков Африканским Сомом\n​"}, {"post_id": "20210549", "page": 8479, "author": "Митяй-Митинооо", "post_dt": "2024-06-06T18:06:24+0300", "text": "Добрый вечер будет….. и завтра и сегодня\nВсе напишим"}, {"post_id": "20210615", "page": 8479, "author": "Саня400", "post_dt": "2024-06-06T18:21:36+0300", "text": ""}]