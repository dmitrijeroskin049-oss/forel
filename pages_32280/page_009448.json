[{"post_id": "21645693", "page": 9448, "author": "S19D1983", "post_dt": "2025-07-16T08:01:53+0300", "text": "Но не в садке у меня"}, {"post_id": "21645720", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T08:15:07+0300", "text": "Все упираются ловить со дна\n,а вот с пол воды ловить подзабыли"}, {"post_id": "21645724", "page": 9448, "author": "S19D1983", "post_dt": "2025-07-16T08:16:03+0300", "text": "Если все получится,сегодня попробую"}, {"post_id": "21645743", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T08:26:29+0300", "text": ""}, {"post_id": "21645776", "page": 9448, "author": "vaskinalex", "post_dt": "2025-07-16T08:42:57+0300", "text": "Всем привет. Сегодня был в ночь и пробовали по-разному, в том числе и с полуводы, но проходы все в метре у берега  и в основном крупная навеска ртом клевать не хочет и прыгает как в дельфинарии"}, {"post_id": "21645874", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T09:12:27+0300", "text": ""}, {"post_id": "21645932", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T09:27:58+0300", "text": ""}, {"post_id": "21645959", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T09:35:08+0300", "text": ""}, {"post_id": "21645976", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T09:44:24+0300", "text": ""}, {"post_id": "21645985", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T09:46:23+0300", "text": ""}, {"post_id": "21646099", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T10:19:21+0300", "text": ""}, {"post_id": "21646147", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T10:32:48+0300", "text": ""}, {"post_id": "21646184", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T10:43:16+0300", "text": ""}, {"post_id": "21646550", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T12:43:51+0300", "text": ""}, {"post_id": "21646652", "page": 9448, "author": "Митяй-Митинооо", "post_dt": "2025-07-16T13:10:56+0300", "text": ""}]