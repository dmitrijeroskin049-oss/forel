[{"post_id": "20523047", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T15:49:36+0300", "text": ""}, {"post_id": "20523053", "page": 8669, "author": "Kulek1787", "post_dt": "2024-09-08T15:51:07+0300", "text": "Добрый день!\nВетку не стал листать далеко\nСкажите пожалуйста когда будет запуск форели ?\nИ будет ли работать спорт зона?"}, {"post_id": "20523162", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T16:39:06+0300", "text": "Добрый день.К Форелевому сезону все сообщим"}, {"post_id": "20523173", "page": 8669, "author": "Aleks19852", "post_dt": "2024-09-08T16:43:49+0300", "text": "Добрый вечер!завтра утром хотим первый раз приехать к вам на рыбалку. Подскажите пожалуйста карп и осетр у вас в одном водоеме водятся или в разных? Так же будем очень благодарны за полезные советы"}, {"post_id": "20523226", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T17:01:32+0300", "text": "Добрый день.Всё в одной акватории"}, {"post_id": "20523244", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T17:10:51+0300", "text": ""}, {"post_id": "20523278", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T17:22:25+0300", "text": ""}, {"post_id": "20523433", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:11:01+0300", "text": ""}, {"post_id": "20523470", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:28:15+0300", "text": ""}, {"post_id": "20523504", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:39:12+0300", "text": ""}, {"post_id": "20523510", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:41:29+0300", "text": ""}, {"post_id": "20523526", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:45:39+0300", "text": ""}, {"post_id": "20523530", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:47:50+0300", "text": ""}, {"post_id": "20523549", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T18:54:56+0300", "text": ""}, {"post_id": "20523597", "page": 8669, "author": "Митяй-Митинооо", "post_dt": "2024-09-08T19:06:51+0300", "text": "Фото с водоёма\n​"}]