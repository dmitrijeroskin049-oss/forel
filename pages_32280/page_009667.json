[{"post_id": "21946540", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T08:36:33+0300", "text": ""}, {"post_id": "21946544", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T08:38:00+0300", "text": ""}, {"post_id": "21946650", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T09:15:52+0300", "text": "Запуск Форели 151кг,навеска микс до 3кг\nЖдём в гости\n​"}, {"post_id": "21946768", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T10:03:24+0300", "text": ""}, {"post_id": "21946811", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T10:14:39+0300", "text": ""}, {"post_id": "21946871", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T10:33:08+0300", "text": ""}, {"post_id": "21946948", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T11:03:01+0300", "text": ""}, {"post_id": "21946965", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T11:10:20+0300", "text": ""}, {"post_id": "21947044", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T11:36:16+0300", "text": ""}, {"post_id": "21947168", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T12:21:55+0300", "text": ""}, {"post_id": "21947190", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T12:30:12+0300", "text": "Всем Доброго времени суток\nЗавтра четверг 30.10 ориентировочный запуск Форели 100-200 кг\nи запуск может измениться только в большую сторону\n,навеска микс до 3кг\nЗапуск Форели в 9:00 по Красногорску\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "21947195", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T12:33:06+0300", "text": ""}, {"post_id": "21947217", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T12:44:50+0300", "text": ""}, {"post_id": "21947285", "page": 9667, "author": "Митяй-Митинооо", "post_dt": "2025-10-29T13:13:26+0300", "text": ""}, {"post_id": "21947378", "page": 9667, "autho