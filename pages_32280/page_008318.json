[{"post_id": "19906761", "page": 8318, "author": "vaskinalex", "post_dt": "2024-03-19T22:41:55+0300", "text": "Андрюха получил опыт, встает на перспективные места, использует проверенные приманки и крючки. Бывает часто, приходит налегке, палкой особо не машет и уходит с рыбой. Ему даже багор не нужен. Так что ничего удивительного. Молодец!"}, {"post_id": "19907513", "page": 8318, "author": "Александр SALMO", "post_dt": "2024-03-20T09:32:35+0300", "text": "Запуск Основной водоем 151кг\n​"}, {"post_id": "19907585", "page": 8318, "author": "Александр SALMO", "post_dt": "2024-03-20T09:50:09+0300", "text": "Запуск спорт зона 231кг\n​"}, {"post_id": "19907880", "page": 8318, "author": "Александр SALMO", "post_dt": "2024-03-20T11:11:13+0300", "text": ""}, {"post_id": "19907962", "page": 8318, "author": "Алексей Махальский", "post_dt": "2024-03-20T11:33:29+0300", "text": "Добрый день, подскажите на основном еще можно взять допы за 1 тыс?"}, {"post_id": "19907984", "page": 8318, "author": "Александр SALMO", "post_dt": "2024-03-20T11:40:41+0300", "text": ""}, {"post_id": "19908169", "page": 8318, "author": "Митяй-Митинооо", "post_dt": "2024-03-20T12:40:36+0300", "text": "Добрый день,да"}, {"post_id": "19908184", "page": 8318, "author": "gammi10", "post_dt": "2024-03-20T12:46:07+0300", "text": "Есть ли у Вас в продаже мотыль и опарыш?"}, {"post_id": "19908199", "page": 8318, "author": "Александр SALMO", "post_dt": "2024-03-20T12:50:38+0300", "text": "Не бывает."}, {"post_id": "19908298", "page": 8318, "author": "Девочка Демон", "post_dt": "2024-03-20T13:12:54+0300", "text": ""}, {"post_id": "19908309", "page": 8318, "author": "Девочка Демон", "post_dt": "2024-03-20T13:14:39+0300", "text": ""}, {"post_id": "19908316", "page": 8318, "author": "Девочка Демон", "post_dt": "2024-03-20T13:16:27+0300", "text": ""}, {"post_id": "19908524", "page": 8318, "author": "Девочка Демон", "post_dt": "2024-03-20T14:02:43+0300", "text": ""}, {"post_id": "19908602", "page": 8318, "author": "Soad777", "post_dt": "2024-03-20T14:21:51+0300", "text": "Добрый день, подскажите какая примерно сейчас толщина льда?"}, {"post_id": "19908633", "page": 8318, "author": "Девочка Демон", "post_dt": "2024-03-20T14:29:09+0300", "text": ""}]