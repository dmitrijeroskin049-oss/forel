[{"post_id": "20177419", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T08:55:54+0300", "text": "Нет\n,новый выдали"}, {"post_id": "20177423", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T08:57:03+0300", "text": ""}, {"post_id": "20177524", "page": 8458, "author": "АЛЕКСИРА", "post_dt": "2024-05-28T09:19:57+0300", "text": ""}, {"post_id": "20177573", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T09:35:48+0300", "text": ""}, {"post_id": "20177627", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T09:56:48+0300", "text": ""}, {"post_id": "20177661", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T10:08:32+0300", "text": ""}, {"post_id": "20177685", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T10:14:23+0300", "text": ""}, {"post_id": "20177725", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T10:23:08+0300", "text": ""}, {"post_id": "20177739", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T10:25:22+0300", "text": "Сегодня во второй половине дня состоится очередной запуск Осетра,в количестве 100кг\nЖдем Всех в гости\n​"}, {"post_id": "20177826", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T10:45:33+0300", "text": ""}, {"post_id": "20177921", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T11:08:12+0300", "text": ""}, {"post_id": "20177971", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T11:19:51+0300", "text": ""}, {"post_id": "20178116", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T11:52:09+0300", "text": "Завтра в среду\n29 мая 2024 года Льготный день.Инвалиды,ветераны,учатники боевых действий,пенсионеры,многодетные скидка 25%.При себе иметь подтверждающий документ.\nЦена путевки :\n2300₽ День с 6:00-19:00\n1300₽ Обед с 12:00-19:00\n2300₽ Ночь с 18:00-06:00\n3400₽ Сутки с момента прибытия\nПриоритетный час 300₽,дополнительная снасть 500₽ не более 1шт.\nДля рыбаков не имеющих льгот,цена путевки\n3100₽ День с 6:00-19:00\n1700₽ Обед с 12:00-19:00\n3100₽ Ночь с 18:00-6:00\n4500₽ Сутки с момента прибытия\nС Уважением Администрация.\n​"}, {"post_id": "20178281", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T12:31:35+0300", "text": ""}, {"post_id": "20178405", "page": 8458, "author": "Митяй-Митинооо", "post_dt": "2024-05-28T13:10:53+0300", "text": "Осетра запустили,фото сейчас выложим"}]