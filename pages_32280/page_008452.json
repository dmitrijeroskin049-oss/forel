[{"post_id": "20166103", "page": 8452, "author": "Девочка Демон", "post_dt": "2024-05-25T08:34:01+0300", "text": ""}, {"post_id": "20166104", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T08:34:08+0300", "text": "Запуск Осетра навеска до 3.5 кг.Общий вес 101кг.\n​"}, {"post_id": "20166143", "page": 8452, "author": "Девочка Демон", "post_dt": "2024-05-25T08:48:12+0300", "text": ""}, {"post_id": "20166173", "page": 8452, "author": "Девочка Демон", "post_dt": "2024-05-25T09:00:31+0300", "text": ""}, {"post_id": "20166246", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T09:23:22+0300", "text": ""}, {"post_id": "20166531", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T10:56:56+0300", "text": ""}, {"post_id": "20166658", "page": 8452, "author": "Девочка Демон", "post_dt": "2024-05-25T11:31:52+0300", "text": ""}, {"post_id": "20166869", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T12:50:03+0300", "text": ""}, {"post_id": "20167058", "page": 8452, "author": "Митяй-Митинооо", "post_dt": "2024-05-25T13:58:06+0300", "text": ""}, {"post_id": "20168084", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T19:23:14+0300", "text": "Уловы за сегодня\n​"}, {"post_id": "20168337", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-25T20:30:50+0300", "text": "Цена путёвки на основной водоём....\nС 06.00-19.00 - 3100р\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р Разрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20168455", "page": 8452, "author": "Митяй-Митинооо", "post_dt": "2024-05-25T20:57:19+0300", "text": "На водоеме есть прикормка,наживка"}, {"post_id": "20169284", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-26T06:25:49+0300", "text": "Ночные уловы сейчас выложим"}, {"post_id": "20169289", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-26T06:31:35+0300", "text": "Наш адрес для навигатора СНТ Садовод сад 3."}, {"post_id": "20169290", "page": 8452, "author": "Александр SALMO", "post_dt": "2024-05-26T06:33:28+0300", "text": ""}]