[{"post_id": "20773930", "page": 8844, "author": "Viktor 08", "post_dt": "2024-11-16T21:19:29+0300", "text": "+"}, {"post_id": "20773938", "page": 8844, "author": "Yuriy Ponamarev", "post_dt": "2024-11-16T21:20:58+0300", "text": "Да я бы с радостью, но вот не получается у меня загружать фото на РФ..."}, {"post_id": "20773946", "page": 8844, "author": "Yuriy Ponamarev", "post_dt": "2024-11-16T21:23:02+0300", "text": ""}, {"post_id": "20773950", "page": 8844, "author": "Yuriy Ponamarev", "post_dt": "2024-11-16T21:24:12+0300", "text": "Получилось"}, {"post_id": "20773961", "page": 8844, "author": "АндрейД", "post_dt": "2024-11-16T21:26:40+0300", "text": "Спосибо"}, {"post_id": "20773997", "page": 8844, "author": "Эндрю ххх", "post_dt": "2024-11-16T21:38:14+0300", "text": "Был,понтон,на запуск в толпу не попал,с утра после запуска 3 шт по 1,6 в течении часа на пал оранжзолото, далее рыбь тусила от середины вправо ближе к мели и влево,но втиснуться не было возможности,у петрухи неплохо получаось это делать, худенький мальчуган))как ему удается ловить без флюра это загадка,правда оторвал он 4 блесны без фрикциона..женщины,жены молодцы,стойкие ,от \"А\"до \"Я\" трудились несмотря на ветер и им свезло больше,чем мужьям, водяной их порадовал.. администрации спасибо за рыбалку, довольный,но в хлам грязный пошел стираться))резина была в игноре,блесны приоритет на золотой подложке..всем добра"}, {"post_id": "20774541", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T05:06:59+0300", "text": ""}, {"post_id": "20774651", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T07:49:06+0300", "text": ""}, {"post_id": "20774702", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T08:24:05+0300", "text": "Ночные уловы\n​"}, {"post_id": "20774796", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T09:07:22+0300", "text": ""}, {"post_id": "20774851", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T09:26:13+0300", "text": ""}, {"post_id": "20774860", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T09:27:15+0300", "text": ""}, {"post_id": "20774871", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T09:30:33+0300", "text": "Фото запуска сейчас выложим"}, {"post_id": "20774888", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T09:34:39+0300", "text": "Запуск Форели 360кг\n,навеска микс до 3кг\n​"}, {"post_id": "20775034", "page": 8844, "author": "Митяй-Митинооо", "post_dt": "2024-11-17T10:18:52+0300", "text": ""}]