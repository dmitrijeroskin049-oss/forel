[{"post_id": "22643646", "page": 10266, "author": "LOBAN", "post_dt": "2026-06-06T23:08:13+0300", "text": "Я ловлю, до 5 кг вытаскивал, толще 0,18 вообще не использую."}, {"post_id": "22643672", "page": 10266, "author": "gas gas", "post_dt": "2026-06-06T23:18:54+0300", "text": "Если что осетр и на 0.3 плетню берет))"}, {"post_id": "22643743", "page": 10266, "author": "alex_v77", "post_dt": "2026-06-07T00:06:25+0300", "text": "Уловистый вкус технопланктона - отсюда до озера Абрау. Оснастка +- одинаковая. Главное выбрать вкус."}, {"post_id": "22643848", "page": 10266, "author": "Саша chef", "post_dt": "2026-06-07T04:02:28+0300", "text": "Техноплантон со вкусом топленого молока"}, {"post_id": "22643865", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T04:47:10+0300", "text": ""}, {"post_id": "22643887", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T05:51:20+0300", "text": ""}, {"post_id": "22643920", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T06:43:54+0300", "text": "Ночные уловы.\n​"}, {"post_id": "22643927", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T06:49:58+0300", "text": ""}, {"post_id": "22644086", "page": 10266, "author": "юрий аэропорт", "post_dt": "2026-06-07T08:22:10+0300", "text": "Вкус техно планктона. У него много разных вкусов. Надо подбирать."}, {"post_id": "22644295", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T09:53:07+0300", "text": ""}, {"post_id": "22644432", "page": 10266, "author": "юрий аэропорт", "post_dt": "2026-06-07T10:44:52+0300", "text": "Согласен."}, {"post_id": "22644447", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T10:49:27+0300", "text": ""}, {"post_id": "22644541", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T11:25:34+0300", "text": ""}, {"post_id": "22644614", "page": 10266, "author": "Александр SALMO", "post_dt": "2026-06-07T12:03:29+0300", "text": ""}, {"post_id": "22645066", "page": 10266, "author": "Митяй-Митинооо", "post_dt": "2026-06-07T15:19:36+0300", "text": "Аренда снастей"}]