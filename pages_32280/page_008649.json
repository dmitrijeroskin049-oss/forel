[{"post_id": "20493397", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T11:09:34+0300", "text": ""}, {"post_id": "20493657", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T12:29:13+0300", "text": ""}, {"post_id": "20493835", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T13:00:02+0300", "text": ""}, {"post_id": "20493946", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T13:21:47+0300", "text": "Завтра утром в субботу запустим Карпа из садков,который показал себя на Ура\nЖдём Всех в гости\n​"}, {"post_id": "20493979", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T13:29:35+0300", "text": "Андрей Викторович «Рыба есть,рыба ест»"}, {"post_id": "20494077", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T13:52:12+0300", "text": ""}, {"post_id": "20494180", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T14:19:47+0300", "text": "Цена путёвки на Основной водоём....\nС 06.00-19.00 - 3100р\nС 06.00-12.00 - 2000р -\n(скидка не распространяется)\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р (скидка не распространяется)\nРазрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20494211", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T14:28:30+0300", "text": ""}, {"post_id": "20494279", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T14:48:58+0300", "text": ""}, {"post_id": "20494319", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T15:01:46+0300", "text": ""}, {"post_id": "20494553", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T16:29:08+0300", "text": "Аренда снастей"}, {"post_id": "20494557", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T16:30:45+0300", "text": ""}, {"post_id": "20494567", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T16:32:59+0300", "text": "Осетра запустили\nФото сейчас выложим"}, {"post_id": "20494585", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T16:37:18+0300", "text": "Запуск Осетра в количестве 102кг\nЖдём в гости\n​"}, {"post_id": "20494721", "page": 8649, "author": "Митяй-Митинооо", "post_dt": "2024-08-30T17:22:34+0300", "text": ""}]