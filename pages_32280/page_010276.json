[{"post_id": "22658719", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T07:05:06+0300", "text": "Ночные уловы.\n​"}, {"post_id": "22658803", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T07:54:22+0300", "text": "Улов Андрея за сутки 48 кг Осетра.\n​"}, {"post_id": "22658885", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T08:24:15+0300", "text": ""}, {"post_id": "22658934", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T08:44:43+0300", "text": ""}, {"post_id": "22658937", "page": 10276, "author": "юрий аэропорт", "post_dt": "2026-06-12T08:45:19+0300", "text": "Привет Александр. Как с народом сегодня?"}, {"post_id": "22658987", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T09:04:18+0300", "text": "Привет Юрий,народа не много места свободные есть."}, {"post_id": "22659028", "page": 10276, "author": "юрий аэропорт", "post_dt": "2026-06-12T09:23:05+0300", "text": "Спасибо. После обеда собираюсь на сутки."}, {"post_id": "22659109", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T09:54:04+0300", "text": "Ждем"}, {"post_id": "22659112", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T09:55:08+0300", "text": ""}, {"post_id": "22659120", "page": 10276, "author": "юрий аэропорт", "post_dt": "2026-06-12T09:58:22+0300", "text": "Куда мы денемся!. Сам жду."}, {"post_id": "22659123", "page": 10276, "author": "юрий аэропорт", "post_dt": "2026-06-12T09:59:52+0300", "text": "Смотрю, не успеваете осетра завозить. Какие-то монстры рыбаки. Всех переловили."}, {"post_id": "22659152", "page": 10276, "author": "Девочка Демон", "post_dt": "2026-06-12T10:10:51+0300", "text": ""}, {"post_id": "22659289", "page": 10276, "author": "Александр SALMO", "post_dt": "2026-06-12T10:51:30+0300", "text": ""}, {"post_id": "22659438", "page": 10276, "author": "Алексей Ищук", "post_dt": "2026-06-12T11:56:13+0300", "text": "Здравствуйте, много народу на водоеме?"}, {"post_id": "22659507", "page": 10276, "author": "tar.andr", "post_dt": "2026-06-12T12:27:26+0300", "text": "С каких это пор флюр стал крепче монки на разрыв?"}]