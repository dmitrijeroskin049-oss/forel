[{"post_id": "21788665", "page": 9543, "author": "AlexLutij", "post_dt": "2025-09-06T09:03:00+0300", "text": "Подскажите как клев на запуске?"}, {"post_id": "21788754", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T09:45:00+0300", "text": "Поимки Форели после запуска"}, {"post_id": "21788807", "page": 9543, "author": "юрий аэропорт", "post_dt": "2025-09-06T10:09:11+0300", "text": "Полностью согласен с Вами."}, {"post_id": "21788825", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T10:14:01+0300", "text": ""}, {"post_id": "21788902", "page": 9543, "author": "csl", "post_dt": "2025-09-06T10:41:26+0300", "text": "Может не надо гибкости?\nПоедете на красный свет светофора? При условии ,что рядом ни одной машины.\nЯ нет!!!!\nЕсть правила,если хотите закон и его должны соблюдать все!\nМешаешь или не мешаешь соседу это не важно.\nВот тогда бардака ВЕЗДЕ будет меньше!\nЕсли сказали \"чугуний\"значит \"чугуний\" и нет никакого \"люминия\""}, {"post_id": "21788903", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T10:42:51+0300", "text": ""}, {"post_id": "21789008", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T11:21:53+0300", "text": ""}, {"post_id": "21789018", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T11:28:44+0300", "text": "Завтра в воскресенье 07.09 ориентировочный запуск Форели 200-300кг\n,навеска 0.8-1.2кг\nЗапуск Форели в 08.00\nЖдём в гости\n​"}, {"post_id": "21789100", "page": 9543, "author": "Даниэль", "post_dt": "2025-09-06T11:54:43+0300", "text": "Добрый день, администрация подскажите пожалуйста может жена ловить со мной на мою путёвку?"}, {"post_id": "21789118", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T12:02:38+0300", "text": "Добрый день,да"}, {"post_id": "21789164", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T12:23:11+0300", "text": ""}, {"post_id": "21789198", "page": 9543, "author": "labutovdm", "post_dt": "2025-09-06T12:36:36+0300", "text": "Подскажите, пожалуйста, стоимость аренды снастей)"}, {"post_id": "21789215", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T12:45:26+0300", "text": ""}, {"post_id": "21789240", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T13:00:50+0300", "text": ""}, {"post_id": "21789257", "page": 9543, "author": "Митяй-Митинооо", "post_dt": "2025-09-06T13:07:24+0300", "text": ""}]