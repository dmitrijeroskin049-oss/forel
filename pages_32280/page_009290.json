[{"post_id": "21422022", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T09:04:50+0300", "text": "Осетрик на селедку"}, {"post_id": "21422057", "page": 9290, "author": "Yakubovi4", "post_dt": "2025-05-03T09:20:09+0300", "text": "Вован Красава."}, {"post_id": "21422138", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T09:44:48+0300", "text": "Добрый день,сразу в водоём"}, {"post_id": "21422277", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T10:39:11+0300", "text": ""}, {"post_id": "21422299", "page": 9290, "author": "ДимаРыбачок", "post_dt": "2025-05-03T10:44:24+0300", "text": "На какую прикормку сейчас карп клюет, темная или светлая, и аромат какой?"}, {"post_id": "21422333", "page": 9290, "author": "дмитриё", "post_dt": "2025-05-03T10:56:37+0300", "text": "Там уже не подушка, а целый матрас\nЖду своего выходного."}, {"post_id": "21422347", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T11:01:17+0300", "text": "Привет,бисквит\n.Если серьёзно,вода за крайние дни остыла,уровень высокий и мутная.Сейчас надо пробовать специи,чеснок\nС Уважением"}, {"post_id": "21422377", "page": 9290, "author": "dimon_228_", "post_dt": "2025-05-03T11:09:08+0300", "text": "Дмитрий,добрый день. Как дела на спортзоне? Рыбка опять бастует ? Или поклевывавет?"}, {"post_id": "21422408", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T11:17:09+0300", "text": ""}, {"post_id": "21422432", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T11:24:46+0300", "text": "Добрый день,слабо"}, {"post_id": "21422449", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T11:31:37+0300", "text": ""}, {"post_id": "21422575", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T12:23:39+0300", "text": ""}, {"post_id": "21422725", "page": 9290, "author": "Митяй-Митинооо", "post_dt": "2025-05-03T13:20:28+0300", "text": ""}, {"post_id": "21422863", "page": 9290, "author": "Петр60", "post_dt": "2025-05-03T14:09:41+0300", "text": "На макушатник разрешено ловить.Всех с праздниками!"}, {"post_id": "21422881", "page": 9290, "author": "юрий аэропорт", "post_dt": "2025-05-03T14:14:54+0300", "text": "Привет Димитрий!. А фидеры, я так понимаю ,не работают пока? Поплавок рулит?"}]