[{"post_id": "20659930", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:14:54+0300", "text": ""}, {"post_id": "20659968", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:27:14+0300", "text": ""}, {"post_id": "20660009", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:39:11+0300", "text": ""}, {"post_id": "20660017", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:42:58+0300", "text": ""}, {"post_id": "20660025", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:45:41+0300", "text": ""}, {"post_id": "20660037", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T10:49:08+0300", "text": ""}, {"post_id": "20660087", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T11:02:10+0300", "text": "Улов за неполные сутки 24кг\n​"}, {"post_id": "20660170", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T11:31:42+0300", "text": "Осетрятник за неполные сутки 18кг\n​"}, {"post_id": "20660222", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T11:46:11+0300", "text": "Завтра воскресенье 20.10 состоится запуск Форели в количестве 200-300кг\nи запуск может увеличится только в большую сторону\n.Навеска микс до 5кг\nПроверяйте свои снасти\nЖдём Всех в гости Друзья\n​"}, {"post_id": "20660395", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T12:45:25+0300", "text": "Красногорская котлета 4.200кг\n​"}, {"post_id": "20660457", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T13:04:41+0300", "text": ""}, {"post_id": "20660492", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T13:11:51+0300", "text": ""}, {"post_id": "20660502", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T13:16:04+0300", "text": ""}, {"post_id": "20660543", "page": 8768, "author": "Девочка Демон", "post_dt": "2024-10-19T13:27:25+0300", "text": "Обед для наших рыбаков\n​"}, {"post_id": "20660573", "page": 8768, "author": "Митяй-Митинооо", "post_dt": "2024-10-19T13:38:11+0300", "text": "Завтра воскресенье 20.10 состоится запуск Форели в количестве 200-300кг\nи запуск может увеличится только в большую сторону\n.Навеска микс до 5кг\nПроверяйте свои снасти\nЖдём Всех в гости Друзья\n​"}]