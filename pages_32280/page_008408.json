[{"post_id": "20080710", "page": 8408, "author": "Девочка Демон", "post_dt": "2024-05-03T11:08:15+0300", "text": ""}, {"post_id": "20081037", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T12:39:31+0300", "text": "Запуск Карпуши 700кг\nнавеска 1-1.5кг\nЖдем Всех в гости\n​"}, {"post_id": "20081293", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T13:52:36+0300", "text": ""}, {"post_id": "20081350", "page": 8408, "author": "jasama", "post_dt": "2024-05-03T14:07:03+0300", "text": "Добрый день. А что с сомом?"}, {"post_id": "20081386", "page": 8408, "author": "Владиммр64", "post_dt": "2024-05-03T14:18:27+0300", "text": "Добрый день, а пелетс распаренный использовать можно?"}, {"post_id": "20081542", "page": 8408, "author": "sergei 1986", "post_dt": "2024-05-03T14:58:29+0300", "text": "Если только на Флэт."}, {"post_id": "20081828", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T15:54:33+0300", "text": "Запуск Европейского Сома в количестве 1326кг\n,навеска до 8кг\nЖдем Всех в гости\n​"}, {"post_id": "20081875", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T16:02:17+0300", "text": "Добрый день,распаренный можно,без фанатизма!"}, {"post_id": "20081882", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T16:04:28+0300", "text": ""}, {"post_id": "20082059", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T16:41:36+0300", "text": "Пополнение садков Осетром\n,навеска до 4кг\n​"}, {"post_id": "20082072", "page": 8408, "author": "Saw-686", "post_dt": "2024-05-03T16:43:29+0300", "text": "Может подскажет кто на что сома ловить на другом платонике на актив ловили колебалки касмастеры а здесь как"}, {"post_id": "20082132", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T16:59:23+0300", "text": ""}, {"post_id": "20082166", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T17:06:13+0300", "text": "Завтра утром состоится очередной запуск Осетра,в количестве 100кг,навеска до 4кг\nЖдем Всех в гости\n​"}, {"post_id": "20082198", "page": 8408, "author": "Митяй-Митинооо", "post_dt": "2024-05-03T17:12:54+0300", "text": "Добрый вечер,у нас на тяжелые блесна свыше 5гр ловить Запрещено!Пучок червя,дондробена,селедка"}, {"post_id": "20082214", "page": 8408, "author": "Saw-686", "post_dt": "2024-05-03T17:15:48+0300", "text": "Спасибо"}]