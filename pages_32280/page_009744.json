[{"post_id": "22021267", "page": 9744, "author": "Митяй-Митинооо", "post_dt": "2025-11-22T09:46:10+0300", "text": "Запуск в Основной водоём 120кг,навеска до 2кг\nЖдём в гости\n​"}, {"post_id": "22021335", "page": 9744, "author": "Митяй-Митинооо", "post_dt": "2025-11-22T10:16:40+0300", "text": "Запуск Форели в Спортзону 311кг\n​"}, {"post_id": "22021540", "page": 9744, "author": "Вован Клин", "post_dt": "2025-11-22T11:21:18+0300", "text": ""}, {"post_id": "22021613", "page": 9744, "author": "Девочка Демон", "post_dt": "2025-11-22T11:48:12+0300", "text": ""}, {"post_id": "22021617", "page": 9744, "author": "Вован Клин", "post_dt": "2025-11-22T11:49:55+0300", "text": ""}, {"post_id": "22021718", "page": 9744, "author": "Вован Клин", "post_dt": "2025-11-22T12:33:27+0300", "text": ""}, {"post_id": "22021790", "page": 9744, "author": "Митяй-Митинооо", "post_dt": "2025-11-22T13:00:15+0300", "text": "Рыбалка,рыбалкой….Обед по расписанию"}, {"post_id": "22021870", "page": 9744, "author": "Вован Клин", "post_dt": "2025-11-22T13:32:01+0300", "text": ""}, {"post_id": "22022024", "page": 9744, "author": "МегаРыбак_3", "post_dt": "2025-11-22T14:20:32+0300", "text": "Красавчики!\nПойду и я поем..... Опять..."}, {"post_id": "22022045", "page": 9744, "author": "Вован Клин", "post_dt": "2025-11-22T14:30:43+0300", "text": ""}, {"post_id": "22022056", "page": 9744, "author": "Митяй-Митинооо", "post_dt": "2025-11-22T14:37:14+0300", "text": "Приезжай,нам не жалко"}, {"post_id": "22022225", "page": 9744, "author": "Митяй-Митинооо", "post_dt": "2025-11-22T15:39:37+0300", "text": "Завтра в воскресенье 23.11 Основной водоём и Спортзона работают в штатном режиме с запуском Форели\nЖдём Всех в гости\n​"}, {"post_id": "22022248", "page": 9744, "author": "Ivanrus1996", "post_dt": "2025-11-22T15:49:03+0300", "text": "Как уловы на сз сегодня?"}, {"post_id": "22022263", "page": 9744, "author": "АК1969", "post_dt": "2025-11-22T15:53:47+0300", "text": "А в Пн народному дню быть или не быть? Спасибо"}