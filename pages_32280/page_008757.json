[{"post_id": "20648088", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T08:05:39+0300", "text": "Ночные уловы\n​"}, {"post_id": "20648136", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T08:31:25+0300", "text": "До запуска\n​"}, {"post_id": "20648185", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T08:44:38+0300", "text": ""}, {"post_id": "20648196", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T08:46:48+0300", "text": ""}, {"post_id": "20648322", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T09:20:26+0300", "text": "Запуск Форели 235кг\nЖдём Всех в гости\n​"}, {"post_id": "20648492", "page": 8757, "author": "Роман 565", "post_dt": "2024-10-16T10:05:42+0300", "text": "Всем привет. Был вчера на водоеме, приехал к 12 и отправился под серый мост. Там ребята полавливали на актив и я решил попробовать, но переполскав кучку железа получил только два подбива. Дальше решил пойти на бетонку и на рыже красный магот с бамбардой припарковал фору на 3,5кг., следом ловлю еще одну на 3 кг., и потом до вечера наковырял еще три штучки, итог 5 шт. почти на 11кг. Администрации спасибо за их труд и наш отдых. Рыбка проскакивает бомбических размеров. Всем НХНЧ"}, {"post_id": "20648618", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T10:44:36+0300", "text": ""}, {"post_id": "20648635", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T10:50:18+0300", "text": ""}, {"post_id": "20648669", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T11:00:07+0300", "text": ""}, {"post_id": "20648699", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T11:10:37+0300", "text": ""}, {"post_id": "20648794", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T11:30:58+0300", "text": ""}, {"post_id": "20648861", "page": 8757, "author": "Галей", "post_dt": "2024-10-16T11:47:11+0300", "text": "Здравствуйте! Подскажите, действует ли ещё предложение по скидке на период дня рождения?"}, {"post_id": "20648873", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T11:52:06+0300", "text": ""}, {"post_id": "20648979", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T12:18:40+0300", "text": "Рыба есть\n,рыба ест\n(резина Cool Place)\n​"}, {"post_id": "20648991", "page": 8757, "author": "Митяй-Митинооо", "post_dt": "2024-10-16T12:22:17+0300", "text": "Добрый день.Скидка 50% +- один день!"}]