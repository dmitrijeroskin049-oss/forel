[{"post_id": "20793257", "page": 8858, "author": "Александр SALMO", "post_dt": "2024-11-22T08:22:44+0300", "text": "Ночной\nулов.\n​"}, {"post_id": "20793331", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T08:43:30+0300", "text": ""}, {"post_id": "20793533", "page": 8858, "author": "Митяй-Митинооо", "post_dt": "2024-11-22T09:43:24+0300", "text": "Запуск Форели 154кг\nПогодка разгуливается\nЖдём в гости\n​"}, {"post_id": "20793702", "page": 8858, "author": "Sndl", "post_dt": "2024-11-22T10:20:34+0300", "text": "Выложите пожалуйста фото понтона, всем интересно что получилось."}, {"post_id": "20793718", "page": 8858, "author": "андрей-митинский", "post_dt": "2024-11-22T10:24:17+0300", "text": "Назад страницу посмотрите"}, {"post_id": "20793930", "page": 8858, "author": "Митяй-Митинооо", "post_dt": "2024-11-22T11:15:06+0300", "text": ""}, {"post_id": "20793953", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T11:20:19+0300", "text": ""}, {"post_id": "20794096", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T11:50:31+0300", "text": ""}, {"post_id": "20794220", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T12:19:23+0300", "text": ""}, {"post_id": "20794520", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T13:26:26+0300", "text": ""}, {"post_id": "20794527", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T13:27:47+0300", "text": ""}, {"post_id": "20794574", "page": 8858, "author": "лёха150382", "post_dt": "2024-11-22T13:41:14+0300", "text": "Отчёт с колёс. Сутки.2 с братом. Дислокация стадион у понтана. До темна 4 шт на белый стрейч.до рассвета ещё 3 на него же. С рассвета дислокация угол бетонки ещё 5 на всё тот-же стрейч. Всё поймоно с центра водоёма 1м-1,5м ото дна. Итог 17кг.сезон жидкой воды скорей всего закрыт.админам спасибо."}, {"post_id": "20794588", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T13:45:54+0300", "text": ""}, {"post_id": "20794730", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T14:22:35+0300", "text": ""}, {"post_id": "20794941", "page": 8858, "author": "Девочка Демон", "post_dt": "2024-11-22T15:20:09+0300", "text": ""}]