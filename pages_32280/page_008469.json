[{"post_id": "20192498", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-01T15:44:48+0300", "text": ""}, {"post_id": "20192532", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-01T15:57:05+0300", "text": ""}, {"post_id": "20192539", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-01T15:59:25+0300", "text": ""}, {"post_id": "20192551", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-01T16:04:25+0300", "text": "Цена путёвки на Основной водоём....\nС 06.00-19.00 - 3100р\nС 06.00-12.00 - 2000р\nС 12.00-19.00 - 1700р\nС 18.00-06.00 - 3100р\nСутки 4500р\nПриоритетный час 300р\nРазрешено ловить на 2 снасти(не более 2 крючков на каждой снасти)\n(можно взять 1 доп 500р)\nБез нормы вылова Женщина и ребёнок до 13 лет ловят\nбесплатно на снасти рыбака)\nБез нормы вылова\nПеллетс Запрещен\nНаши координаты 55.840619 ,\n37.322979\n8(985)262-06-37 Администрация\n​"}, {"post_id": "20192664", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-01T16:47:23+0300", "text": ""}, {"post_id": "20192924", "page": 8469, "author": "юрий аэропорт", "post_dt": "2024-06-01T18:38:03+0300", "text": ". я ловил на повороте, по стороне админов, внизу. Спросите у Дмитрия. Он знает это место."}, {"post_id": "20192928", "page": 8469, "author": "юрий аэропорт", "post_dt": "2024-06-01T18:39:50+0300", "text": "Привет Андрей. Собираюсь на основной в следующую пятницу. Работы много."}, {"post_id": "20193173", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-01T19:52:36+0300", "text": "Уловы за сегодня\n​"}, {"post_id": "20193334", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-01T20:46:09+0300", "text": "Улов суточника.\n​"}, {"post_id": "20193484", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-01T21:41:59+0300", "text": "Еще улов суточников.\n​"}, {"post_id": "20194015", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-02T06:58:47+0300", "text": ""}, {"post_id": "20194019", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-02T07:02:59+0300", "text": "Ночные уловы.\n​"}, {"post_id": "20194112", "page": 8469, "author": "Александр SALMO", "post_dt": "2024-06-02T08:17:54+0300", "text": ""}, {"post_id": "20194293", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-02T09:12:04+0300", "text": ""}, {"post_id": "20194401", "page": 8469, "author": "Девочка Демон", "post_dt": "2024-06-02T09:46:03+0300", "text": ""}]