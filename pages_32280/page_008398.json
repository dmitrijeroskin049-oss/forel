[{"post_id": "20060689", "page": 8398, "author": "DoctorSavchenko", "post_dt": "2024-04-27T21:57:12+0300", "text": "Всем привет, сегодня путевка после обеда: начал ловить около 15:00, ловил на 2  поплавка, поводок 0,12 крючок 14 номер по овнеру, карп клевал, как из пулемета, насадка опарыш, червь, сколько штук не считал, общий вес 35кг. Рыбалкой доволен, администрации спасибо за прием приедем еще! Всем НХНЧ"}, {"post_id": "20061163", "page": 8398, "author": "профи555", "post_dt": "2024-04-28T03:03:47+0300", "text": "А я у жены лет десять запоминал когда у неё день рождение!!!!! Слава богу запомнил!!!!!!"}, {"post_id": "20061216", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T06:17:37+0300", "text": ""}, {"post_id": "20061239", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T06:32:25+0300", "text": ""}, {"post_id": "20061251", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T06:40:17+0300", "text": "Ночные уловы\n​"}, {"post_id": "20061334", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T07:35:33+0300", "text": ""}, {"post_id": "20061451", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T08:17:53+0300", "text": ""}, {"post_id": "20061537", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T08:48:20+0300", "text": ""}, {"post_id": "20061617", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T09:14:23+0300", "text": ""}, {"post_id": "20061639", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T09:22:35+0300", "text": ""}, {"post_id": "20061683", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T09:35:54+0300", "text": ""}, {"post_id": "20061736", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T09:53:56+0300", "text": ""}, {"post_id": "20061849", "page": 8398, "author": "Митяй-Митинооо", "post_dt": "2024-04-28T10:26:42+0300", "text": ""}, {"post_id": "20061967", "page": 8398, "author": "Митяй-Митинооо", "post_d