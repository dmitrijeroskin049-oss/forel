[{"post_id": "21912499", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T07:45:34+0300", "text": "Ночные уловы.\n​"}, {"post_id": "21912542", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T08:16:41+0300", "text": ""}, {"post_id": "21912678", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T09:19:17+0300", "text": "Запуск Форели 301 кг. Навеска микс до 3+кг.\n​"}, {"post_id": "21912726", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T09:38:46+0300", "text": ""}, {"post_id": "21912804", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T10:10:47+0300", "text": ""}, {"post_id": "21912860", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T10:32:15+0300", "text": ""}, {"post_id": "21912881", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T10:40:11+0300", "text": ""}, {"post_id": "21912955", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T11:15:26+0300", "text": ""}, {"post_id": "21913197", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T12:48:37+0300", "text": "Бесплатная Уха из Форели для наших рыбаков.\n​"}, {"post_id": "21913316", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T13:38:59+0300", "text": ""}, {"post_id": "21913375", "page": 9640, "author": "юрий аэропорт", "post_dt": "2025-10-18T14:07:29+0300", "text": "Привет Александр!. Сыр оранжевый и шербет сыр есть в наличии ?.. Собираюсь к Вам завтра на сутки. Хотел уточнить."}, {"post_id": "21913398", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T14:18:20+0300", "text": "Привет Юрий ,остался только бледный чеснок."}, {"post_id": "21913449", "page": 9640, "author": "юрий аэропорт", "post_dt": "2025-10-18T14:41:09+0300", "text": "Понял, спасибо. Значит надо по дороге перехватить."}, {"post_id": "21913506", "page": 9640, "author": "Александр SALMO", "post_dt": "2025-10-18T15:06:01+0300", "text": "Всем Доброго времени суток\nЗавтра Воскресенье 19.10 ориентировочный запуск Форели 200-300 кг\nи запуск может измениться только в большую сторону\n,навеска микс до 3кг\nЗапуск Форели в 9:00 по Красногорску\nГотовьте снасти Друзья\nЖдём Всех в гости\n​"}, {"post_id": "21913571", "page": 9640, "author": "Zloy Den", "post_dt": "2025-10-18T15:39:07+0300", "text": "Спасибо большое"}]