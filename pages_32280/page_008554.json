[{"post_id": "20343885", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T09:27:23+0300", "text": ""}, {"post_id": "20343983", "page": 8554, "author": "Lasarevich", "post_dt": "2024-07-13T09:55:08+0300", "text": "В Водоеме. Живет и радуется."}, {"post_id": "20343996", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T09:58:02+0300", "text": ""}, {"post_id": "20344004", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T09:59:47+0300", "text": ""}, {"post_id": "20344033", "page": 8554, "author": "Александр SALMO", "post_dt": "2024-07-13T10:08:57+0300", "text": ""}, {"post_id": "20344134", "page": 8554, "author": "Александр SALMO", "post_dt": "2024-07-13T10:31:16+0300", "text": "Сегодня вечером состоится очередное зарыбление Осетром.Навеска 2-3кг.Общий вес 100кг.\nЗавтра утром состоится запуск Африканского Сома.\n​"}, {"post_id": "20344260", "page": 8554, "author": "Александр SALMO", "post_dt": "2024-07-13T11:04:23+0300", "text": ""}, {"post_id": "20344266", "page": 8554, "author": "Minelab", "post_dt": "2024-07-13T11:05:12+0300", "text": "Здравствуйте,подскажите пожалуйста,сома запустили?И на какую снасть его ловить?"}, {"post_id": "20344367", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T11:36:04+0300", "text": ""}, {"post_id": "20344380", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T11:38:41+0300", "text": ""}, {"post_id": "20344463", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T12:03:35+0300", "text": ""}, {"post_id": "20344564", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T12:36:47+0300", "text": ""}, {"post_id": "20344743", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T13:27:27+0300", "text": ""}, {"post_id": "20344853", "page": 8554, "author": "Александр SALMO", "post_dt": "2024-07-13T13:57:23+0300", "text": ""}, {"post_id": "20345062", "page": 8554, "author": "Девочка Демон", "post_dt": "2024-07-13T14:56:41+0300", "text": ""}]