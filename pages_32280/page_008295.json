[{"post_id": "19875141", "page": 8295, "author": "Александр SALMO", "post_dt": "2024-03-12T10:40:05+0300", "text": ""}, {"post_id": "19875154", "page": 8295, "author": "pa14", "post_dt": "2024-03-12T10:43:26+0300", "text": "Я думаю нужно читать \"на глубине 2,0м\""}, {"post_id": "19875203", "page": 8295, "author": "Tolyan222", "post_dt": "2024-03-12T10:56:03+0300", "text": "Отчет за вчера СЗ\nДо запуска 1шт на черныша саурус из подо льда. На запуск не ходил. Запуск утонул и начались поклевки через час-полтора после запуска и продолжались в течении всего дня.\nПо итогу наковырял 7шт на 13200, всё в верхних слоях. Парочку на резину, остальное на саурусы черный и белый самокрасы. Много сходов. Вся рыбалка по центру.\nАдминистрации спасибо за рыбалку, потеплеет приеду ещё"}, {"post_id": "19875247", "page": 8295, "author": "Александр SALMO", "post_dt": "2024-03-12T11:06:57+0300", "text": ""}, {"post_id": "19875360", "page": 8295, "author": "Александр SALMO", "post_dt": "2024-03-12T11:36:47+0300", "text": ""}, {"post_id": "19875381", "page": 8295, "author": "wpz88", "post_dt": "2024-03-12T11:41:37+0300", "text": "Всем добрый день!\nУгрозы же нет?))"}, {"post_id": "19875397", "page": 8295, "author": "андрей-митинский", "post_dt": "2024-03-12T11:46:04+0300", "text": "Первый день народный и чем плохо за 2 рубля половить сига а он подороже форели будет жаль сегодня работа  8 марта он стоял табунами но не брал а завтра я на рыбалку."}, {"post_id": "19875700", "page": 8295, "author": "Александр SALMO", "post_dt": "2024-03-12T13:12:44+0300", "text": ""}, {"post_id": "19875748", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T13:26:36+0300", "text": ""}, {"post_id": "19875854", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T13:57:54+0300", "text": ""}, {"post_id": "19875870", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T14:00:55+0300", "text": ""}, {"post_id": "19875931", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T14:15:19+0300", "text": ""}, {"post_id": "19875940", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T14:16:56+0300", "text": ""}, {"post_id": "19876002", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T14:34:56+0300", "text": ""}, {"post_id": "19876005", "page": 8295, "author": "Девочка Демон", "post_dt": "2024-03-12T14:36:23+0300", "text": ""}]