[{"post_id": "22926191", "page": 10464, "author": "Александр SALMO", "post_dt": "2026-09-20T10:52:34+0300", "text": ""}, {"post_id": "22926202", "page": 10464, "author": "figaro79", "post_dt": "2026-09-20T10:57:32+0300", "text": "Здравствуйте. Места есть порыбачить?"}, {"post_id": "22926251", "page": 10464, "author": "Александр SALMO", "post_dt": "2026-09-20T11:16:32+0300", "text": "Есть но не много."}, {"post_id": "22926337", "page": 10464, "author": "Александр SALMO", "post_dt": "2026-09-20T11:40:34+0300", "text": "Всем Доброго времени суток\nЗавтра Понедельник 21.09 состоится гарантированный запуск Форели 100-200кг\nи запуск может измениться только в большую сторону\nНавеска 1-2 кг.\nЖдём в гости\n​"}, {"post_id": "22926504", "page": 10464, "author": "Александр SALMO", "post_dt": "2026-09-20T12:56:40+0300", "text": ""}]