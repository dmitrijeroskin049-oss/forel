[{"post_id": "19973981", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T07:25:21+0300", "text": ""}, {"post_id": "19973988", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T07:29:50+0300", "text": ""}, {"post_id": "19974050", "page": 8351, "author": "GRIZLI31", "post_dt": "2024-04-06T08:05:05+0300", "text": "Бананчик порой в штопор вводит, и знать ни будете что под водой его вертит ни по детски, только рыбу им пугать"}, {"post_id": "19974339", "page": 8351, "author": "igor995", "post_dt": "2024-04-06T09:53:13+0300", "text": "на крайней рыбалке по льду у меня был срез блесны,вот эта бандюга поди и срезала!!!!"}, {"post_id": "19974393", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T10:08:31+0300", "text": ""}, {"post_id": "19974542", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T10:49:51+0300", "text": ""}, {"post_id": "19974566", "page": 8351, "author": "Девочка Демон", "post_dt": "2024-04-06T10:58:20+0300", "text": ""}, {"post_id": "19974751", "page": 8351, "author": "shved1983", "post_dt": "2024-04-06T12:01:23+0300", "text": "Доброго дня! Вопрос к администрации.А по сигу норма так и осталась ?"}, {"post_id": "19974779", "page": 8351, "author": "Сергей1703", "post_dt": "2024-04-06T12:10:43+0300", "text": "Всем двс! Саш, Гуль, завтра зарыбление будет? Или без зарыбления пока все не устаканится?"}, {"post_id": "19974810", "page": 8351, "author": "Девочка Демон", "post_dt": "2024-04-06T12:23:45+0300", "text": ""}, {"post_id": "19974814", "page": 8351, "author": "Девочка Демон", "post_dt": "2024-04-06T12:26:08+0300", "text": ""}, {"post_id": "19974911", "page": 8351, "author": "Девочка Демон", "post_dt": "2024-04-06T12:57:05+0300", "text": ""}, {"post_id": "19975041", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T13:41:06+0300", "text": "Добрый день,как размоем весь лед,возобновим запуски.\nПо сигу норма так и осталась."}, {"post_id": "19975047", "page": 8351, "author": "Девочка Демон", "post_dt": "2024-04-06T13:42:25+0300", "text": ""}, {"post_id": "19975056", "page": 8351, "author": "Александр SALMO", "post_dt": "2024-04-06T13:44:24+0300", "text": ""}]