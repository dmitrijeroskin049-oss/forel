[{"post_id": "20236193", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T12:28:47+0300", "text": "Всем Доброго времени суток\nЗавтра в пятницу 14.06 во второй половине дня состоится очередной запуск Осетра в количестве 100кг\n,навеска до 4кг\nЖдем Всех в гости\n​"}, {"post_id": "20236351", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T13:11:26+0300", "text": ""}, {"post_id": "20236640", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T14:28:27+0300", "text": "Добрый день Игорь\n.Завтра запуск Осетра\n,выше написали.Предварительно в субботу запуск Башкирского Карпа с садка,завтра его ожидаем(в плане клёва показал себя\n,клевал как говорится с колес\n) ,а так же Африканского Сома\nС Уважением"}, {"post_id": "20236719", "page": 8497, "author": "Стасссс", "post_dt": "2024-06-13T14:52:05+0300", "text": "Дим привет, а подскажи субботний запуск осетра предвидится или только в пятницу?"}, {"post_id": "20236881", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T15:35:52+0300", "text": "Привет Стас,по Осетру завтра сообщим"}, {"post_id": "20236999", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T16:11:49+0300", "text": ""}, {"post_id": "20237076", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T16:34:31+0300", "text": ""}, {"post_id": "20237173", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T16:55:10+0300", "text": ""}, {"post_id": "20237364", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T17:54:11+0300", "text": ""}, {"post_id": "20237569", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T18:41:42+0300", "text": ""}, {"post_id": "20237660", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T19:01:37+0300", "text": "Фото с водоема\n​"}, {"post_id": "20237977", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-13T20:06:55+0300", "text": ""}, {"post_id": "20238970", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-14T05:25:28+0300", "text": "Прикормка,наживка"}, {"post_id": "20239014", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-14T06:32:12+0300", "text": ""}, {"post_id": "20239023", "page": 8497, "author": "Митяй-Митинооо", "post_dt": "2024-06-14T06:40:46+0300", "text": "Ночные уловы\n​"}]