[{"post_id": "20475017", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T17:54:46+0300", "text": ""}, {"post_id": "20475041", "page": 8637, "author": "S19D1983", "post_dt": "2024-08-24T18:04:08+0300", "text": "Присоединяюсь к поздравлениям"}, {"post_id": "20475050", "page": 8637, "author": "S19D1983", "post_dt": "2024-08-24T18:07:26+0300", "text": "Александр зачётный сомик"}, {"post_id": "20475305", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T19:42:15+0300", "text": "Фото с водоема\nЧасть 1\n​"}, {"post_id": "20475337", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T19:50:02+0300", "text": "Часть 2\nЖдем Всех в гости\n​"}, {"post_id": "20475379", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T20:02:39+0300", "text": "Завтра утром в воскресенье 25.08 под запустим ещё Карпа из садков\nЖдём в гости\n​"}, {"post_id": "20475411", "page": 8637, "author": "S19D1983", "post_dt": "2024-08-24T20:10:26+0300", "text": "Во сколько?"}, {"post_id": "20475488", "page": 8637, "author": "Anton94", "post_dt": "2024-08-24T20:26:45+0300", "text": "Всем ДВС! Был сегодня на рыбалке в Красногорске. Чуть запозднился и приехал к 7 утра. Расположился в углу водоёма возле моста. Первая поклёвка не заставила себя долго ждать. Карп был избирательным при выборе наживки. Сначала клевал на чистого опарыша, затем на кукурузу, а после 10:00 на червя, как итог 12 хвостов -10 забрал себе, 2 соседу. Карп чистый, бойкий, но аккуратный"}, {"post_id": "20475493", "page": 8637, "author": "Андрей Милославский", "post_dt": "2024-08-24T20:28:12+0300", "text": "Присоединяюсь-Алесей, с днем варенья!!!!!"}, {"post_id": "20475562", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T20:44:24+0300", "text": "В районе 8 утра"}, {"post_id": "20475950", "page": 8637, "author": "Митяй-Митинооо", "post_dt": "2024-08-24T22:46:55+0300", "text": ""}, {"post_id": "20476181", "page": 8637, "author": "Девочка Демон", "post_dt": "2024-08-25T05:35:06+0300", "text": ""}, {"post_id": "20476195", "page": 8637, "author": "Девочка Демон", "post_dt": "2024-08-25T06:04:23+0300", "text": ""}, {"post_id": "20476196", "page": 8637, "author": "Девочка Демон", "post_dt": "2024-08-25T06:07:56+0300", "text": "Ночные уловы\n​"}, {"post_id": "20476212", "page": 8637, "author": "Девочка Демон", "post_dt": "2024-08-25T06:29:42+0300", "text": ""}]