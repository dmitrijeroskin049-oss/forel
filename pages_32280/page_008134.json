[{"post_id": "19672510", "page": 8134, "author": "АлЯксей", "post_dt": "2024-01-24T07:59:18+0300", "text": "Рынок быстро реагирует."}, {"post_id": "19672512", "page": 8134, "author": "Valday23", "post_dt": "2024-01-24T08:01:13+0300", "text": "Это Москва быстро реагирует, в других регионах все по 200 с небольшим"}, {"post_id": "19672529", "page": 8134, "author": "Dron1997", "post_dt": "2024-01-24T08:07:16+0300", "text": "На Алике будем заказывать."}, {"post_id": "19672536", "page": 8134, "author": "Yarik1983", "post_dt": "2024-01-24T08:09:39+0300", "text": "Доброе утро. А какими весами дискотечными блеснами ловят?)"}, {"post_id": "19672549", "page": 8134, "author": "Serg084", "post_dt": "2024-01-24T08:13:46+0300", "text": "4 гр"}, {"post_id": "19672894", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T10:18:52+0300", "text": "Запуск Основной водоем 135 кг\n​"}, {"post_id": "19672900", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T10:20:33+0300", "text": "Запуск спорт зона 355к\nг.\n​"}, {"post_id": "19673444", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T12:17:40+0300", "text": ""}, {"post_id": "19673455", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T12:19:42+0300", "text": ""}, {"post_id": "19673540", "page": 8134, "author": "одинокий63", "post_dt": "2024-01-24T12:39:30+0300", "text": "Строгино,ул Котукова. 7руб. шт."}, {"post_id": "19673561", "page": 8134, "author": "дядя Серёжа 1", "post_dt": "2024-01-24T12:43:34+0300", "text": "Ул. Катукова. У МКАДа. Практически всегда есть"}, {"post_id": "19673788", "page": 8134, "author": "whiplash", "post_dt": "2024-01-24T13:35:42+0300", "text": "На прошлой неделе на озоне 10 штук за 1100 можно было взять (правда доставка на февраль). Сейчас все такие объявления пропали"}, {"post_id": "19673925", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T14:01:28+0300", "text": ""}, {"post_id": "19673944", "page": 8134, "author": "TimRom_MSK", "post_dt": "2024-01-24T14:05:39+0300", "text": "Перепутали! Это СЗ"}, {"post_id": "19673985", "page": 8134, "author": "Александр SALMO", "post_dt": "2024-01-24T14:16:06+0300", "text": ""}]