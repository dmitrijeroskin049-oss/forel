[{"post_id": "22923248", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T06:45:36+0300", "text": "Ночные уловы.\n​"}, {"post_id": "22923298", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T07:33:29+0300", "text": ""}, {"post_id": "22923347", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T08:22:52+0300", "text": "Запуск Форели 463 кг.Так же запустили 3 меченные Форели.Поймавший получает бесплатную путевку на следующую рыбалку.\n​"}, {"post_id": "22923400", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T09:01:45+0300", "text": "Поимки на запуске."}, {"post_id": "22923414", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T09:11:34+0300", "text": ""}, {"post_id": "22923423", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T09:15:38+0300", "text": ""}, {"post_id": "22923502", "page": 10460, "author": "KRomanV", "post_dt": "2026-09-19T09:51:11+0300", "text": "Доброе утро, подскажите с местами как?"}, {"post_id": "22923507", "page": 10460, "author": "Девочка Демон", "post_dt": "2026-09-19T09:53:49+0300", "text": "Доброе утро , места свободные есть , но не много ."}, {"post_id": "22923578", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T10:32:38+0300", "text": "https://vkvideo.ru/clip-235276479_456239621"}, {"post_id": "22923595", "page": 10460, "author": "HardFisherman3", "post_dt": "2026-09-19T10:39:38+0300", "text": "Самая ходовая приманка на данный момент, даже буратино не побрезговал."}, {"post_id": "22923663", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T11:02:34+0300", "text": ""}, {"post_id": "22923678", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T11:09:31+0300", "text": ""}, {"post_id": "22923695", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T11:17:36+0300", "text": "Всем Доброго времени суток\nЗавтра в воскресенье 20.09 состоится гарантированный запуск Форели 200-300кг\nи запуск может измениться только в большую сторону\nНавеска 1-2 кг.\nВыходные обещают хорошую,тёплую погоду без дождей\nГотовьте снасти покрепче\nЖдём в гости\n​"}, {"post_id": "22923930", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T13:03:13+0300", "text": ""}, {"post_id": "22923970", "page": 10460, "author": "Александр SALMO", "post_dt": "2026-09-19T13:18:45+0300", "text": ""}]