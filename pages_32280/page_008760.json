[{"post_id": "20651945", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T07:50:24+0300", "text": "Ночные уловы\n​"}, {"post_id": "20651957", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T07:55:14+0300", "text": "Утро до запуска\n​"}, {"post_id": "20652027", "page": 8760, "author": "а_ндрей", "post_dt": "2024-10-17T08:18:41+0300", "text": "Здравствуйте, подскажите когда ожидать вип?"}, {"post_id": "20652038", "page": 8760, "author": "Шур73", "post_dt": "2024-10-17T08:21:23+0300", "text": "Как лед будет"}, {"post_id": "20652043", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T08:24:01+0300", "text": "Переходной,до запуска"}, {"post_id": "20652125", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T08:51:03+0300", "text": ""}, {"post_id": "20652251", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T09:26:10+0300", "text": "Запуск Форели 301кг\n,навеска микс до 3кг\nЖдём в гости\n​"}, {"post_id": "20652316", "page": 8760, "author": "юрий аэропорт", "post_dt": "2024-10-17T09:42:07+0300", "text": "Привет Дима!. А в понедельник запуск будет? Собираюсь приехать в воскресенье на сутки."}, {"post_id": "20652408", "page": 8760, "author": "Дмитрий96)", "post_dt": "2024-10-17T10:05:05+0300", "text": "ДВС какой анонс на пятницу? Спасибо"}, {"post_id": "20652434", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T10:10:13+0300", "text": "Поимки Форели после запуска\n​"}, {"post_id": "20652610", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T10:56:30+0300", "text": "Очередные поимки Форели\n​"}, {"post_id": "20652750", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T11:39:39+0300", "text": "Продолжаем ловить.Очередные поимки"}, {"post_id": "20652845", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T12:04:25+0300", "text": "Дуплет"}, {"post_id": "20652919", "page": 8760, "author": "Митяй-Митинооо", "post_dt": "2024-10-17T12:29:57+030