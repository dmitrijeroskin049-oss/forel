[{"post_id": "22904044", "page": 10440, "author": "Александр SALMO", "post_dt": "2026-09-12T08:30:12+0300", "text": "Друзья обещали гарантированный запуск 200-300 кг.Запуск произвели 463 кг.\nТак же запустили 3 Форели с метками.Поймавший получает путевку на рыбалку.Одна путевка в одни руки.\n​"}, {"post_id": "22904069", "page": 10440, "author": "Ретrович 70", "post_dt": "2026-09-12T08:42:09+0300", "text": "Доброе утро.\nА Альбинос ещё в водоеме?"}, {"post_id": "22904100", "page": 10440, "author": "Митяй-Митинооо", "post_dt": "2026-09-12T08:57:01+0300", "text": "Доброе утро,да"}, {"post_id": "22904154", "page": 10440, "author": "юрий аэропорт", "post_dt": "2026-09-12T09:20:50+0300", "text": "Запуск отличный. Наверное народу полно."}, {"post_id": "22904218", "page": 10440, "author": "Сергей Угодин", "post_dt": "2026-09-12T09:51:02+0300", "text": "Чë за альбинос? Форель?"}, {"post_id": "22904234", "page": 10440, "author": "Александр SALMO", "post_dt": "2026-09-12T09:56:18+0300", "text": "Поимки."}, {"post_id": "22904287", "page": 10440, "author": "юрий аэропорт", "post_dt": "2026-09-12T10:19:50+0300", "text": "Осетра запускали. Альбиноса. Около месяца назад примерно."}, {"post_id": "22904307", "page": 10440, "author": "Сергей Угодин", "post_dt": "2026-09-12T10:30:13+0300", "text": "Во как! Пропустил."}, {"post_id": "22904348", "page": 10440, "author": "Александр SALMO", "post_dt": "2026-09-12T10:49:14+0300", "text": ""}, {"post_id": "22904365", "page": 10440, "author": "юрий аэропорт", "post_dt": "2026-09-12T10:57:50+0300", "text": "За него еще , если память не изменяет, премию платят."}, {"post_id": "22904456", "page": 10440, "author": "Александр SALMO", "post_dt": "2026-09-12T11:26:55+0300", "text": ""}, {"post_id": "22904532", "page": 10440, "author": "Митяй-Митинооо", "post_dt": "2026-09-12T11:55:07+0300", "text": "Всё верно Юрий,5000р"}, {"post_id": "22904533", "page": 10440, "author": "Александр SALMO", "post_dt": "2026-09-12T11:55:32+0300", "text": ""}, {"post_id": "22904566", "page": 10440, "author": "Митяй-Митинооо", "post_dt": "2026-09-12T12:13:42+0300", "text": "Всем Доброго времени суток\nЗавтра в воскресенье 13.09 состоится гарантированный запуск Форели 200-300кг\nи запуск может измениться только в большую сторону\n.Навеска 1-2кг,но проскакивают особи до 3кг\nПогоду обещают хорошую,тёплую,без дождей\nГотовьте снасти\nЖдём в гости\n​"}, {"post_id": "22904666", "page": 10440, "author": "Ретrович 70", "post_dt": "2026-09-12T13:07:44+0300", "text": "5000 рублей"}]