[{"post_id": "21906542", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T08:03:31+0300", "text": ""}, {"post_id": "21906713", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T09:19:59+0300", "text": "Запуск Форели 250кг\nЖдём в гости\n​"}, {"post_id": "21906891", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T10:30:10+0300", "text": ""}, {"post_id": "21906898", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T10:31:56+0300", "text": ""}, {"post_id": "21906920", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T10:40:01+0300", "text": ""}, {"post_id": "21906948", "page": 9636, "author": "vladimir-k81", "post_dt": "2025-10-16T10:49:40+0300", "text": "Добрый день. Вчера приехал 6.30.До запуска 2 шт на магот лимон с белым хвостиком.1 слил.Гдето в 10ч на блесна пал 2.5 г синего цвета.Тегения дня доложил 2 шт.Получил 2 обрыва и сход.Были поклевки на резину не доберает."}, {"post_id": "21906962", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T10:56:49+0300", "text": ""}, {"post_id": "21906981", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T11:04:30+0300", "text": ""}, {"post_id": "21906999", "page": 9636, "author": "P S I X", "post_dt": "2025-10-16T11:11:33+0300", "text": "Уважаемые администраторы подскажите пожалуйста когда откроют спорт зону?"}, {"post_id": "21907100", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T11:41:35+0300", "text": ""}, {"post_id": "21907154", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T12:00:26+0300", "text": ""}, {"post_id": "21907212", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T12:22:22+0300", "text": ""}, {"post_id": "21907299", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T12:53:46+0300", "text": ""}, {"post_id": "21907506", "page": 9636, "author": "Митяй-Митинооо", "post_dt": "2025-10-16T14:05:58+0300", "text": "Завтра пятница 17.10 ориентировочный запуск Форели 100-200кг и запуск может измениться только в большую сторону\n,навеска микс до 3кг\nЗапуск Форели в 9.00\nЖдём в гости\n​"}, {"post_id": "21907600", "page": 9636, "author": "Дмитрий96)", "post_dt": "2025-10-16T14:39:50+0300", "text": "В понедельник народный день будет? Или будут запуски?"}]