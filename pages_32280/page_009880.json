[{"post_id": "22177140", "page": 9880, "author": "6724", "post_dt": "2026-01-12T08:31:36+0300", "text": "А на ночь со вторника на среду можно по льготной?"}, {"post_id": "22177149", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T08:37:33+0300", "text": "Улов сутки."}, {"post_id": "22177209", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T09:13:18+0300", "text": "Запуск спорт зона 142 кг с опоздавшими на запуск.\n​"}, {"post_id": "22177361", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T10:15:26+0300", "text": ""}, {"post_id": "22177376", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T10:22:08+0300", "text": ""}, {"post_id": "22177381", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T10:23:13+0300", "text": ""}, {"post_id": "22177409", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T10:35:34+0300", "text": ""}, {"post_id": "22177480", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T11:04:09+0300", "text": ""}, {"post_id": "22177581", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T11:36:04+0300", "text": ""}, {"post_id": "22177807", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T12:35:10+0300", "text": ""}, {"post_id": "22177991", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T13:27:22+0300", "text": "Завтра на Основном водоеме минимальный запуск 100 кг,навеска до 2.5 кг.Запуск всегда может увеличиться в большую сторону.\nЖдем в гости.\n​"}, {"post_id": "22178248", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T14:45:41+0300", "text": "Данные приманки запрещены.\n​"}, {"post_id": "22178643", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T16:42:31+0300", "text": "Можно."}, {"post_id": "22178741", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T17:07:29+0300", "text": "Напоминаем!\nВ связи с проблемой интернета,оплата по терминалу не всегда проходит.Поэтому заранее снимайте наличные.\nПереводы не принимаем!\nС Уважением Администрация\n​"}, {"post_id": "22178970", "page": 9880, "author": "Александр SALMO", "post_dt": "2026-01-12T18:11:55+0300", "text": "Уловы спорт зона вылов 129 кг.\n​"}]